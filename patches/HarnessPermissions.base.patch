diff --git a/packages/core/test/config/mcp-selection.node.test.mjs b/packages/core/test/config/mcp-selection.node.test.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..ecc8d575b2ceac814f83d4b390c3ba392dbc4bb7
--- /dev/null
+++ b/packages/core/test/config/mcp-selection.node.test.mjs
@@ -0,0 +1,104 @@
+import assert from "node:assert/strict"
+import test from "node:test"
+import fs from "node:fs"
+import { fileURLToPath, pathToFileURL } from "node:url"
+
+if (process.versions.bun) {
+  const { nodeSuite } = await import("../personalize/node-suite.mjs")
+  await nodeSuite(import.meta.url)
+} else {
+const { createRequire, registerHooks, stripTypeScriptTypes } = await import("node:module")
+
+const local = createRequire(import.meta.url)
+const effectURL = process.env.PERSONALIZE_EFFECT ?? pathToFileURL(local.resolve("effect")).href
+const { Effect, Stream } = await import(effectURL)
+const source = new URL("../../src/config/plugin/mcp.ts", import.meta.url)
+registerHooks({
+  resolve(specifier, context, next) {
+    if (specifier === "effect") return { url: effectURL, shortCircuit: true }
+    if (specifier === "@opencode/schema/permission-shorthand")
+      return { url: new URL("../../../schema/src/permission-shorthand.ts", import.meta.url).href, shortCircuit: true }
+    if (context.parentURL === source.href) {
+      if (specifier === "@opencode/plugin/effect/plugin") return { url: "fixture:plugin", shortCircuit: true }
+      if (specifier === "@opencode/schema/config") return { url: "fixture:document", shortCircuit: true }
+      if (specifier === "../../config.js") return { url: "fixture:config", shortCircuit: true }
+      if (specifier === "../../mcp/index.js") return { url: "fixture:mcp", shortCircuit: true }
+      if (specifier === "./mcp.js") return { url: source.href, shortCircuit: true }
+    }
+    return next(specifier, context)
+  },
+  load(url, context, next) {
+    const modules = {
+      "fixture:plugin": "export const define = value => value",
+      "fixture:document": "export class Document {}",
+      "fixture:config": 'import {Context} from "effect"; export const Config = {Service:Context.Service("fixture/config")}',
+      "fixture:mcp": 'import {Context} from "effect"; export const Mcp = {Service:Context.Service("fixture/mcp")}',
+    }
+    if (modules[url]) return { format: "module", source: modules[url], shortCircuit: true }
+    if (url === source.href || url.endsWith("/permission-shorthand.ts"))
+      return { format: "module", source: stripTypeScriptTypes(fs.readFileSync(fileURLToPath(url), "utf8")), shortCircuit: true }
+    return next(url, context)
+  },
+})
+const { register } = await import(source.href)
+const { Config } = await import("fixture:config")
+const { Mcp } = await import("fixture:mcp")
+const servers = {
+  playwright: { type: "local", command: ["browser"], disabled: true },
+  other: { type: "remote", url: "https://example.invalid/mcp", disabled: false },
+}
+async function run(selection, options = {}) {
+  const permissions = [{ action: "shell", resource: "*", effect: "deny" }]
+  const entries = [{
+    type: "document",
+    info: { permissions, mcp: { servers }, ...(selection === undefined ? {} : { experimental: { mcp_selection: selection } }) },
+  }, ...(options.entries ?? [])]
+  const saved = structuredClone(entries)
+  const editor = new Map(options.initial ?? [])
+  const writes = []
+  const exit = await Effect.runPromiseExit(register(Stream.never).pipe(
+    Effect.provideService(Config.Service, { entries: () => Effect.succeed(entries) }),
+    Effect.provideService(Mcp.Service, {
+      reload: () => Effect.void,
+      transform: transform => Effect.sync(() => transform({
+        get: name => editor.get(name),
+        set: (name, value) => { writes.push(name); editor.set(name, value) },
+      })),
+    }),
+    Effect.scoped,
+  ))
+  assert.deepEqual(entries, saved, "config and native permissions must remain unmodified")
+  return { exit, editor, writes }
+}
+test("MCP shorthand drives actual config registration and leaves native permissions unchanged", async () => {
+  const result = await run("MCP:=playwright")
+  assert.equal(result.exit._tag, "Success")
+  assert.equal(result.editor.get("playwright").disabled, false)
+  assert.equal(result.editor.get("other").disabled, true)
+  assert.deepEqual(result.editor.get("playwright").command, ["browser"])
+})
+test("omission retains existing server availability; highest-priority selection wins", async () => {
+  const unchanged = await run(undefined)
+  assert.equal(unchanged.editor.get("playwright").disabled, true)
+  assert.equal(unchanged.editor.get("other").disabled, false)
+  const selected = await run("MCP:=playwright", { entries: [
+    { type: "document", info: { experimental: { mcp_selection: "MCP:=other" } } },
+  ] })
+  assert.equal(selected.editor.get("playwright").disabled, true)
+  assert.equal(selected.editor.get("other").disabled, false)
+})
+test("invalid, unknown, and filesystem policies mutate no server settings", async () => {
+  for (const value of ["MCP:=missing", "MCP:=playwright RU=S*", "RU=S*", "ALL:CRUD=D"]) {
+    const result = await run(value)
+    assert.equal(result.exit._tag, "Failure", value)
+    assert.deepEqual(result.writes, [], value)
+  }
+})
+test("configured selection changes availability without replacing plugin server settings", async () => {
+  const result = await run("MCP:=playwright", {
+    initial: [["other", { type: "local", command: ["plugin-owned"], disabled: false }]],
+  })
+  assert.equal(result.editor.get("other").disabled, true)
+  assert.deepEqual(result.editor.get("other").command, ["plugin-owned"])
+})
+}
diff --git a/packages/core/test/permission/session-grant.test.mjs b/packages/core/test/permission/session-grant.test.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..807be253e172678c4bf964f341a9b81f7760951a
--- /dev/null
+++ b/packages/core/test/permission/session-grant.test.mjs
@@ -0,0 +1,96 @@
+import { test } from "node:test"
+import assert from "node:assert/strict"
+
+if (process.versions.bun) {
+  const { nodeSuite } = await import("../personalize/node-suite.mjs")
+  await nodeSuite(import.meta.url)
+} else {
+const { registerHooks } = await import("node:module")
+
+registerHooks({
+  resolve(specifier, context, next) {
+    if (specifier === "@opencode/schema/permission-shorthand")
+      return { url: new URL("../../../schema/src/permission-shorthand.ts", import.meta.url).href, shortCircuit: true }
+    if (specifier === "./session-grant.js")
+      return { url: new URL("../../src/permission/session-grant.ts", import.meta.url).href, shortCircuit: true }
+    return next(specifier, context)
+  },
+})
+const { contains, decision, directories, selections, encode, decode, unknownEffectsDenied } =
+  await import("../../src/permission/session-grant.ts")
+const request = (operations = ["read"], paths = ["D:/Data/Project/nested/file"], action = "read", access = "content") => ({
+  id: "per_test", sessionID: "ses_child", action, operations, paths, resources: paths, access,
+})
+const grants = (text = "R=S*", directory = "D:/Data/Project") =>
+  selections({ scope: "session", policy: text }).map((rule) => ({ ...rule, directory }))
+
+test("Windows subtree boundaries normalize slashes/case and reject traversal and sibling prefixes", () => {
+  assert.equal(contains("D:\\Data\\Project", "d:/DATA/project/child/deeper/file"), true)
+  for (const target of ["D:/Data/Project-other/file", "D:/Data/Project/../outside/file", "E:/Data/Project/file"])
+    assert.equal(contains("D:/Data/Project", target), false)
+})
+test("approved RU=S* CD=D* matrix enforces reads/updates versus creates/deletes and moves", () => {
+  const matrix = grants("RU=S* CD=D*")
+  for (const operation of ["read", "update", "create", "delete"])
+    assert.equal(decision(matrix, request([operation], undefined, operation === "read" ? "read" : "edit")),
+      operation === "read" || operation === "update" ? "allow" : "deny")
+  assert.equal(decision(matrix, request(["delete", "create"], undefined, "edit")), "deny")
+  assert.equal(decision(matrix, request(["delete", "update"], undefined, "edit")), "deny")
+  assert.equal(decision(matrix, request(["read"], ["D:/Data/Project-other/file"])), undefined)
+})
+test("parent-list reads never cover parent files, sibling contents, grep or recursive glob", () => {
+  const parent = grants("R=-S")
+  assert.equal(decision(parent, request(["read"], ["D:/Data"], "read", "listing")), "allow")
+  for (const input of [
+    request(["read"], ["D:/Data/file"]), request(["read"], ["D:/Data/sibling/file"]),
+    request(["read"], ["D:/Data/sibling"], "read", "listing"),
+    request(["read"], ["D:/Data"], "glob"), request(["read"], ["D:/Data"], "grep"),
+  ]) assert.equal(decision(parent, input), undefined)
+  assert.equal(grants("R=-1")[0].lifetime, "once")
+})
+test("compact contradictions and MCP tokens reject before producing any policy", () => {
+  for (const text of ["R=S* R=D*", "R=-S*", "U=-S", "", "RU=S* CD=D* MCP=1 council"])
+    assert.throws(() => grants(text))
+  assert.throws(() => selections({ scope: "session", rules: [
+    { operation: "read", effect: "allow", lifetime: "session", recursive: true, scope: "parent-list" },
+  ] }))
+})
+test("recursive searches require subtree coverage and honor nested denials", () => {
+  const search = { ...request(["read"], ["D:/Data/Project"], "grep"), metadata: { filesystemReadScope: "recursive" } }
+  assert.equal(decision(grants("R=S"), search), undefined)
+  assert.equal(decision(grants("R=S*"), search), "allow")
+  assert.equal(decision([
+    ...grants("R=S*"), ...grants("R=D", "D:/Data/Project/private"),
+  ], search), "deny")
+  assert.equal(decision(grants("R=S"), request(["read"], ["D:/Data/Project/file.txt"])), "allow")
+})
+test("structured selections and compact input enforce identical policies", () => {
+  const rules = selections({ scope: "session", policy: "RU=S* CD=D*" })
+  assert.deepEqual(selections({ scope: "session", rules }), rules)
+  assert.equal(selections("once"), undefined)
+  assert.equal(selections("always"), undefined)
+  assert.equal(grants("R=1")[0].lifetime, "once")
+  for (const operation of ["create", "update", "delete"])
+    assert.equal(decision(grants("R=S*"), request([operation], undefined, "edit")), undefined)
+  assert.equal(decision(grants("R=S*"), { ...request(), operations: undefined }), undefined)
+})
+test("durable rules survive serialization/recreation, without using project save patterns", () => {
+  const before = grants("RU=S* CD=D*")
+  const after = decode(JSON.parse(JSON.stringify(before.map(encode))))
+  assert.deepEqual(after, before)
+  assert.equal(decision(after, request(["update"], undefined, "edit")), "allow")
+  const input = { ...request(), action: "external_directory", resources: ["D:/Data/Project/nested/*"], save: ["D:/Data/*"] }
+  assert.deepEqual(directories(input), ["D:/Data/Project/nested"])
+  assert.equal(directories({ ...input, resources: ["D:/Other/*"] }), undefined)
+})
+test("shell/MCP unknown local effects fail closed under explicit conversation denies", () => {
+  const matrix = grants("RU=S* CD=D*")
+  for (const action of ["shell", "mcp.fs.delete"]) {
+    const input = { ...request(["read"], undefined, action), metadata: { filesystemEffects: "unknown" } }
+    assert.equal(decision(matrix, input), undefined)
+    assert.equal(unknownEffectsDenied(matrix, input), true)
+    assert.equal(unknownEffectsDenied(grants("R=S*"), input), false)
+    assert.equal(unknownEffectsDenied([], input), false)
+  }
+})
+}
