+import assert from "node:assert/strict"
+import { test } from "node:test"
+import { storageDiagnostic } from "../packages/util/src/personalize-storage-diagnostic.ts"
+
+test("nested fatal SQL errors retain extended I/O codes without leaking arbitrary error data", () => {
+  const sqlite = Object.assign(new Error("sensitive SQL must not be logged"), { name: "SQLiteError", errno: 778, code: "SQLITE_IOERR_WRITE" })
+  const cause = { reasons: [{ defect: { reason: { message: "Failed to configure database", cause: sqlite } } }] }
+  assert.deepEqual(storageDiagnostic(cause), {
+    phase: "configure", sqliteCode: "SQLITE_IOERR_WRITE", sqliteExtendedCode: 778, sqlitePrimaryCode: 10,
+  })
+  assert.equal(JSON.stringify(storageDiagnostic(cause)).includes("sensitive"), false)
+})
+
+test("missing native codes stay unknown, including cyclic causes", () => {
+  const cause = { reason: { message: "Failed to open database" } }
+  cause.reason.cause = cause
+  assert.deepEqual(storageDiagnostic(cause), {
+    phase: "open", sqliteCode: undefined, sqliteExtendedCode: undefined, sqlitePrimaryCode: undefined,
+  })
+  assert.equal(storageDiagnostic({ name: "SQLiteError", errno: -1 }).sqliteExtendedCode, undefined)
+  assert.equal(storageDiagnostic({ name: "SQLiteError", errno: "778" }).sqliteExtendedCode, undefined)
+})
diff --git a/packages/client/src/personalize/connection.ts b/packages/client/src/personalize/connection.ts
new file mode 100644
index 0000000000000000000000000000000000000000..aa2ff6127b693937aaba6e2235de306bcf0cfc04
--- /dev/null
+++ b/packages/client/src/personalize/connection.ts
@@ -0,0 +1,38 @@
+// A failed registered server is not repaired by one health/event request per
+// second. Keep automatic recovery observable, but cap this specific retry loop.
+const failedBoot = (error: unknown) => error instanceof Error && error.message === "Background service failed to start"
+
+function wait(ms: number, signal: AbortSignal) {
+  return new Promise<void>((resolve, reject) => {
+    if (signal.aborted) { reject(signal.reason); return }
+    const cancel = () => { clearTimeout(timer); reject(signal.reason) }
+    const timer = setTimeout(() => { signal.removeEventListener("abort", cancel); resolve() }, ms)
+    signal.addEventListener("abort", cancel, { once: true })
+  })
+}
+
+export function decorate(stock: typeof import("../solid/connection")) {
+  const createClientConnection: typeof stock.createClientConnection = (api, options) => {
+    if (!options.reconnect) return stock.createClientConnection(api, options)
+    const reconnect = options.reconnect
+    let failures = 0
+    return stock.createClientConnection(api, {
+      ...options,
+      reconnect: async (signal) => {
+        if (failures) await wait(Math.min(30_000, 2_000 * 2 ** Math.min(failures - 1, 4)), signal)
+        try {
+          const next = await reconnect(signal)
+          failures = 0
+          return next
+        } catch (error) {
+          failures = failedBoot(error) ? Math.min(failures + 1, 5) : 0
+          if (failures === 1) options.log?.info?.("Background service boot failed; slowing retries. Inspect the server log.", {
+            retryDelayMs: 2_000,
+          })
+          throw error
+        }
+      },
+    })
+  }
+  return { createClientConnection }
+}
