--- /dev/null
+++ b/packages/core/test/session/content-guards.test.ts
@@ -0,0 +1,47 @@
+import { describe, expect, test } from "bun:test"
+import { readFileSync } from "node:fs"
+import path from "node:path"
+
+// CI guard checker: every array-style access of `.content` in patch-owned files must sit behind an
+// Array.isArray guard. Upstream has shipped messages whose `content` is undefined/non-array mid-stream;
+// an unguarded `.content.map(...)` there is exactly the TypeError that broke context-decay. Scope is the
+// patch-owned files only - upstream files are taken as-is and are not rewritten by this check.
+// Isolated architecture: our runtime logic lives in src/personalize/* (plus context-decay.ts);
+// stock modules are byte-identical upstream files and must never be listed here.
+const OWNED = [
+  "src/personalize/content.ts",
+  "src/personalize/database.ts",
+  "src/personalize/hooks.ts",
+  "src/personalize/markdown.ts",
+  "src/personalize/model-request.ts",
+  "src/personalize/persona.ts",
+  "src/personalize/skill.ts",
+  "src/personalize/to-llm-message.ts",
+  "src/personalize/v1-migration.ts",
+  "src/session/runner/context-decay.ts",
+]
+
+const ACCESS =
+  /\.content(\?\.|\.)(map|flatMap|filter|some|every|find|findLast|findIndex|forEach|reduce|reduceRight|slice|concat|join|at|indexOf|lastIndexOf|includes|entries|keys|values|length)\b|\.content\[/
+const GUARD = /Array\.isArray\(/
+const LOOKBACK = 12
+
+describe("content guards", () => {
+  test("every .content array access in patch-owned files is guarded", () => {
+    const root = path.join(import.meta.dir, "..", "..")
+    const errors: string[] = []
+    for (const rel of OWNED) {
+      const lines = readFileSync(path.join(root, rel), "utf8").split("\n")
+      lines.forEach((line, index) => {
+        if (!ACCESS.test(line)) return
+        const from = Math.max(0, index - LOOKBACK)
+        if (lines.slice(from, index + 1).some((near) => GUARD.test(near))) return
+        errors.push(
+          `${rel}:${index + 1} unguarded .content access -> add: const items = Array.isArray(x.content) ? x.content : [] and use items`,
+        )
+      })
+    }
+    if (errors.length) throw new Error(`unguarded .content array access:\n${errors.join("\n")}`)
+    expect(errors).toEqual([])
+  })
+})
diff --git a/packages/server/src/personalize/event.ts b/packages/server/src/personalize/event.ts
new file mode 100644
index 0000000000000000000000000000000000000000..7dfcc70e521feb5aa7f00486fc9035a32b113947
--- /dev/null
+++ b/packages/server/src/personalize/event.ts
@@ -0,0 +1,52 @@
+import { Event } from "@opencode/schema/event"
+import { Effect, Stream } from "effect"
+import { HttpServerResponse } from "effect/http"
+import { HttpApiBuilder } from "effect/http-api"
+import { Api } from "../api"
+import { EventFeed } from "../event-feed"
+import { lifetime } from "./idle-state"
+
+// ============================================================================
+// PERSONALIZATION (deltav11) — SSE handler with idle-reaper activity.
+// Actual stream ownership, not a 15s heartbeat estimate: even /killtime 1s
+// must leave connected windows alone. A scoped lease is released when the
+// stream closes, fails, or is interrupted. The stock module is referenced
+// only in the type position below — erased at build, no runtime cycle.
+// ============================================================================
+
+export function decorate(stock: typeof import("../handlers/event")) {
+  const EventHandler = HttpApiBuilder.group(Api, "server.event", (handlers) =>
+    Effect.gen(function* () {
+      const feed = yield* EventFeed.Service
+      return handlers.handleRaw("event.subscribe", (ctx) =>
+        Effect.gen(function* () {
+          const connected = {
+            id: Event.ID.create(),
+            type: "server.connected",
+            data: {},
+          } as const
+          const output = Stream.unwrap(
+            Effect.acquireRelease(Effect.sync(() => lifetime.connect()), (close) => Effect.sync(close)).pipe(
+              Effect.andThen(feed.subscribe(ctx.query.types)),
+              Effect.map((live) => Stream.make(EventFeed.frame(connected)).pipe(Stream.concat(live))),
+            ),
+          )
+          const heartbeat = Stream.tick("15 seconds").pipe(Stream.map(() => ": heartbeat\n\n"))
+          return HttpServerResponse.stream(
+            output.pipe(Stream.merge(heartbeat, { haltStrategy: "left" }), Stream.encodeText),
+            {
+              contentType: "text/event-stream",
+              headers: {
+                "Cache-Control": "no-cache, no-transform",
+                "X-Accel-Buffering": "no",
+                "X-Content-Type-Options": "nosniff",
+              },
+            },
+          )
+        }),
+      )
+    }),
+  ) as typeof stock.EventHandler
+
+  return { EventHandler }
+}
diff --git a/packages/server/src/personalize/idle-state.ts b/packages/server/src/personalize/idle-state.ts
new file mode 100644
index 0000000000000000000000000000000000000000..8bee9fb60c5fc38bce9a5eb6f74558ccb63c9e98
--- /dev/null
+++ b/packages/server/src/personalize/idle-state.ts
@@ -0,0 +1,51 @@
+import { Lifetime } from "@opencode/util/personalize-lifetime"
+import { settings, sleeping, evictSelf } from "@opencode/util/personalize-lifetime-store"
+
+export const lifetime = new Lifetime(settings())
+
+// Exactly one deadline timer, rescheduled by actual client/job transitions.
+// No heartbeat heuristics, watchdog polling, fibers, or spawned processes.
+export function armIdleWatchdog(soft: () => void, hard = () => {
+  try { process.kill(process.pid, "SIGKILL") } catch {}
+  process.exit(137)
+}) {
+  let timer: ReturnType<typeof setTimeout> | undefined
+  let disarmed = false
+  function schedule() {
+    if (timer) clearTimeout(timer)
+    timer = undefined
+    if (disarmed) return
+    const next = lifetime.next()
+    if (!next) return
+    timer = setTimeout(() => {
+      const due = lifetime.next()
+      if (!due || due.after > 0) return schedule()
+      // Write before disconnecting: existing windows must park, not respawn it.
+      try { sleeping(due.kind) } catch (error) {
+        console.error("[personalize] cannot record service sleep", error)
+        if (due.kind === "soft") {
+          // Avoid a soft-stop/auto-respawn loop. Hard control stays armed.
+          lifetime.softBlocked = true
+          return schedule()
+        }
+      }
+      console.error(`[personalize] ${due.kind} lifetime deadline reached`)
+      if (due.kind === "hard") {
+        lifetime.stopped = true
+        try { evictSelf() } catch {}
+        hard()
+      } else {
+        lifetime.softStopping = true
+        try { soft() } finally { schedule() }
+      }
+    }, next.after)
+    timer.unref?.()
+  }
+  lifetime.changed = schedule
+  schedule()
+  return () => {
+    disarmed = true
+    if (timer) clearTimeout(timer)
+    lifetime.changed = () => {}
+  }
+}
diff --git a/packages/server/src/personalize/process.ts b/packages/server/src/personalize/process.ts
new file mode 100644
index 0000000000000000000000000000000000000000..b96a3b86afd35e442dc48f2efa16f1c54db7d4de
--- /dev/null
+++ b/packages/server/src/personalize/process.ts
@@ -0,0 +1,88 @@
+import os from "node:os"
+import path from "node:path"
+import { Effect, Option } from "effect"
+import { HttpServerRequest, HttpServerResponse } from "effect/http"
+import { Flock } from "@opencode/util/flock"
+import { PersonalizeBoot } from "@opencode/util/personalize-boot"
+import { defaults, duration } from "@opencode/util/personalize-lifetime"
+import { save } from "@opencode/util/personalize-lifetime-store"
+import { authorizedRequest, unauthorizedResponse } from "../middleware/authorization"
+import { armIdleWatchdog, lifetime } from "./idle-state"
+
+export function decorate(stock: typeof import("../process")) {
+  // Keep the complete stock signature and forward its tail unchanged.
+  const start: typeof stock.start = (options, ...rest) => {
+    const [lifecycle, transform] = rest
+    if (lifecycle) {
+      rest[0] = {
+        ...lifecycle,
+        onListen: (address, shutdown) => Effect.gen(function* () {
+            const cleanup = yield* lifecycle.onListen(address, shutdown)
+            armIdleWatchdog(() => { void Effect.runPromise(shutdown).catch(console.error) })
+            // The unref'd hard deadline survives graceful finalizers. If they
+            // hang it still kills; if the process exits normally it holds no
+            // handles open and needs no extra cleanup machinery.
+            return cleanup.pipe(Effect.ensuring(Effect.sync(() => {
+              lifetime.softStopping = true
+              lifetime.changed()
+            })))
+          }),
+      }
+      rest[1] = (app) => {
+        const next = transform ? transform(app) : app
+        return Effect.gen(function* () {
+          const request = yield* HttpServerRequest.HttpServerRequest
+          if (new URL(request.url, "http://localhost").pathname === "/_personalize/lifetime") {
+            if (!(yield* authorizedRequest(request, { password: Option.fromNullishOr(options.password), username: "opencode" })))
+              return unauthorizedResponse(request)
+            const reply = (body: unknown, status = 200) => HttpServerResponse.text(JSON.stringify(body), {
+              status, contentType: "application/json",
+            })
+            if (request.method === "GET") return reply(lifetime.settings)
+            if (request.method !== "PUT") return reply({ error: "Use GET or PUT" }, 405)
+            const body: unknown = yield* request.json.pipe(Effect.catch(() => Effect.succeed(undefined)))
+            if (!body || typeof body !== "object") return reply({ error: "Expected command and duration" }, 400)
+            const command = Reflect.get(body, "command"), input = Reflect.get(body, "duration")
+            if ((command !== "killtime" && command !== "softkilltime") || typeof input !== "string")
+              return reply({ error: "Expected killtime or softkilltime and a duration" }, 400)
+            const key = command === "killtime" ? "hardMs" : "softMs"
+            let ms: number
+            try { ms = duration(input, defaults[key]) }
+            catch (error) { return reply({ error: error instanceof Error ? error.message : String(error) }, 400) }
+            const settings = { ...lifetime.settings, [key]: ms }
+            try { save(settings) }
+            catch { return reply({ error: "Could not save lifetime settings; nothing changed" }, 500) }
+            lifetime.configure(settings)
+            return reply(settings)
+          }
+          // A mutation in progress protects soft shutdown; reads/heartbeats do
+          // not keep an idle server alive. Job leases protect asynchronous work.
+          if (request.method === "GET" || request.method === "HEAD") return yield* next
+          return yield* Effect.acquireUseRelease(
+            Effect.sync(() => lifetime.work("requests")),
+            () => next,
+            (done) => Effect.sync(done),
+          )
+        })
+      }
+    }
+    return Effect.acquireUseRelease(
+      Effect.promise((signal) => Flock.acquire("service-bootstrap", {
+        dir: path.join(os.tmpdir(), "opencode", "personalize-boot-locks"), signal,
+      }).then((lease) => {
+        let done = false
+        const release = () => {
+          if (done) return Promise.resolve()
+          done = true
+          return lease.release()
+        }
+        return { release }
+      })),
+      (boot) => stock.start(options, ...rest).pipe(Effect.provideService(PersonalizeBoot, {
+        retry: Effect.void, release: Effect.promise(() => boot.release()),
+      })),
+      (boot) => Effect.promise(() => boot.release()),
+    )
+  }
+  return { start }
+}
