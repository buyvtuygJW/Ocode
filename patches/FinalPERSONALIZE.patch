+import { AbsolutePath } from "../src/schema"
+import { decorate, repositoryHome } from "../src/personalize/repository-cache"
+import { tmpdir } from "./fixture/tmpdir"
+
+const reference = Repository.parseRemote("owner/repo")
+type Mode = "unreadable" | "transient" | "origin-error" | "wrong-origin" | "missing"
+
+function harness(root: string, mode: Mode, guarded = true) {
+  let discovers = 0, clones = 0
+  const git = Git.node.mapLayer((layer) => layer.pipe(Layer.flatMap((context) => {
+    const original = Context.get(context, Git.Service)
+    const repo = (directory: string) => new Git.Repository({
+      worktree: AbsolutePath.make(directory),
+      gitDirectory: AbsolutePath.make(path.join(directory, ".git")),
+      commonDirectory: AbsolutePath.make(path.join(directory, ".git")),
+    })
+    return Layer.succeed(Git.Service, {
+      ...original,
+      repo: {
+        ...original.repo,
+        discover: (directory) => Effect.sync(() => {
+          discovers++
+          return mode === "unreadable" || mode === "missing" || (mode === "transient" && discovers === 1)
+            ? undefined : repo(directory)
+        }),
+        clone: (input) => Effect.promise(async () => {
+          clones++
+          await fs.mkdir(path.join(input.directory, ".git"), { recursive: true })
+          return repo(input.directory)
+        }),
+      },
+      remote: { get: () => mode === "origin-error"
+        ? Effect.fail(new Git.CommandError({ args: ["remote", "get-url", "origin"], exitCode: 128 }))
+        : Effect.succeed(mode === "wrong-origin" ? "https://github.com/other/repo.git" : reference.remote) },
+      history: { ...original.history, head: () => Effect.undefined, branch: () => Effect.undefined },
+    })
+  })))
+  const node = guarded ? decorate(RepositoryCache).node : RepositoryCache.node
+  const global = Global.make({ data: path.join(root, "data"), state: path.join(root, "state"), repos: path.join(root, "repos") })
+  return {
+    counts: () => ({ discovers, clones }), global,
+    layer: AppNodeBuilder.build(LayerNode.group([node, Global.node]), [
+      Global.node.replace(Layer.succeed(Global.Service, global)),
+      Git.node.replace(git),
+      KV.node.replace(Layer.succeed(KV.Service, {
+        get: () => Effect.undefined, set: () => Effect.void, remove: () => Effect.void,
+        scan: () => Effect.succeed({ entries: [] }),
+      })),
+    ]),
+  }
+}
+
+async function attempt(root: string, mode: Mode, guarded = true, metadata = true) {
+  const localPath = Repository.cachePath(path.join(root, "repos"), reference)
+  await fs.mkdir(metadata ? path.join(localPath, ".git") : localPath, { recursive: true })
+  await fs.writeFile(path.join(localPath, "keep.txt"), "existing user cache content")
+  const runtime = harness(root, mode, guarded)
+  const result = await Effect.runPromise(Effect.scoped(Effect.gen(function* () {
+    const cache = yield* RepositoryCache.Service
+    return yield* Effect.result(cache.ensure({ reference }))
+  }).pipe(Effect.provide(runtime.layer))))
+  const preserved = await fs.readFile(path.join(localPath, "keep.txt"), "utf8").then(() => true, () => false)
+  return { result, preserved, ...runtime.counts() }
+}
+
+test("real stock cache deletes on empty discovery; the decorator preserves it without cloning", async () => {
+  await using fixture = await tmpdir("cache-discovery-")
+  const before = await attempt(path.join(fixture.path, "before"), "unreadable", false)
+  expect(before.preserved).toBe(false)
+  expect(before.clones).toBe(1)
+  const after = await attempt(path.join(fixture.path, "after"), "unreadable")
+  expect(after.preserved).toBe(true)
+  expect(after.clones).toBe(0)
+  expect(after.result._tag).toBe("Failure")
+  if (after.result._tag === "Failure") expect(after.result.failure.message).toContain("Git could not inspect")
+}, 30_000)
+
+for (const mode of ["transient", "origin-error"] as const) {
+  test(`cache preserves existing checkout after ${mode}`, async () => {
+    await using fixture = await tmpdir("cache-inspection-")
+    const result = await attempt(fixture.path, mode)
+    expect(result.preserved).toBe(true)
+    expect(result.clones).toBe(0)
+    expect(result.result._tag).toBe("Failure")
+  }, 30_000)
+}
+
+test("confirmed wrong-origin and non-Git stale caches retain stock replacement", async () => {
+  await using fixture = await tmpdir("cache-stale-")
+  for (const [mode, metadata] of [["wrong-origin", true], ["missing", false]] as const) {
+    const result = await attempt(path.join(fixture.path, mode), mode, true, metadata)
+    expect(result.preserved).toBe(false)
+    expect(result.clones).toBe(1)
+    expect(result.result._tag).toBe("Success")
+  }
+}, 30_000)
+
+test("dedicated cache override changes materialization, not the global data directory", async () => {
+  await using fixture = await tmpdir("cache-home-")
+  const original = process.env.OPENCODE_REPOS_HOME
+  const override = path.join(fixture.path, "dedicated-repos")
+  process.env.OPENCODE_REPOS_HOME = override
+  try {
+    const runtime = harness(fixture.path, "missing")
+    await Effect.runPromise(Effect.scoped(Effect.gen(function* () {
+      const cache = yield* RepositoryCache.Service
+      const global = yield* Global.Service
+      const result = yield* cache.ensure({ reference })
+      expect(result.localPath).toBe(Repository.cachePath(override, reference))
+      expect(global.data).toBe(runtime.global.data)
+      expect(global.repos).toBe(runtime.global.repos)
+    }).pipe(Effect.provide(runtime.layer))))
+    expect(repositoryHome("fallback", override)).toBe(override)
+    expect(() => repositoryHome("fallback", "relative/cache")).toThrow("absolute")
+  } finally {
+    if (original === undefined) delete process.env.OPENCODE_REPOS_HOME
+    else process.env.OPENCODE_REPOS_HOME = original
+  }
+}, 30_000)
diff --git a/packages/util/src/personalize-storage-diagnostic.ts b/packages/util/src/personalize-storage-diagnostic.ts
new file mode 100644
index 0000000000000000000000000000000000000000..0b9251037fc390bf2d7de614324fd388c3258688
--- /dev/null
+++ b/packages/util/src/personalize-storage-diagnostic.ts
@@ -0,0 +1,30 @@
+// Keep structured SQLite codes without serializing SQL, parameters, or the
+// arbitrary surrounding cause graph. Effect SqlError wraps the native error.
+export function storageDiagnostic(input: unknown) {
+  const seen = new Set<object>()
+  let phase: "open" | "configure" | "bootstrap" = "bootstrap"
+  let native: { name?: string; code?: unknown; errno?: unknown } | undefined
+  const visit = (value: unknown) => {
+    if (!value || typeof value !== "object" || seen.has(value)) return
+    seen.add(value)
+    const record = value as Record<string, unknown>
+    if (record.message === "Failed to open database") phase = "open"
+    if (record.message === "Failed to configure database") phase = "configure"
+    if (record.name === "SQLiteError" || (typeof record.code === "string" && /^SQLITE_[A-Z_]+$/.test(record.code)))
+      native = record
+    for (const key of ["cause", "reason", "reasons", "error", "defect", "left", "right"]) {
+      const item = record[key]
+      if (Array.isArray(item)) item.forEach(visit)
+      else visit(item)
+    }
+  }
+  visit(input)
+  const extended = typeof native?.errno === "number" && Number.isSafeInteger(native.errno) && native.errno >= 0
+    ? native.errno : undefined
+  return {
+    phase,
+    sqliteCode: typeof native?.code === "string" && /^SQLITE_[A-Z_]+$/.test(native.code) ? native.code : undefined,
+    sqliteExtendedCode: extended,
+    sqlitePrimaryCode: extended === undefined ? undefined : extended & 0xff,
+  }
+}
diff --git a/.personalize/startup-ownership.test.mjs b/.personalize/startup-ownership.test.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..8570ab890c2e4de342a8b1cf446d4e583635124b
--- /dev/null
+++ b/.personalize/startup-ownership.test.mjs
@@ -0,0 +1,122 @@
+import assert from "node:assert/strict"
+import { mkdtempSync, rmSync, writeFileSync } from "node:fs"
+import { tmpdir } from "node:os"
+import path from "node:path"
+import { fileURLToPath } from "node:url"
+import { spawnSync } from "node:child_process"
+import { test } from "node:test"
+
+const root = process.env.PERSONALIZE_SOURCE ?? fileURLToPath(new URL("../", import.meta.url))
+const moduleURL = (name) => JSON.stringify(path.join(root, "packages/util/src", name).replaceAll("\\", "/"))
+
+test("native bootstrap ownership: death, cancellation, contention, stale release and bounded hangs", () => {
+  const directory = mkdtempSync(path.join(tmpdir(), "opencode-boot-ownership-"))
+  try {
+    const script = path.join(directory, "check.mjs")
+    writeFileSync(script, `
+      import assert from "node:assert/strict"
+      import { once } from "node:events"
+      import { spawn } from "node:child_process"
+      import { readdirSync, readFileSync, writeFileSync } from "node:fs"
+      import { setTimeout as sleep } from "node:timers/promises"
+      import { acquireBootLock } from ${moduleURL("personalize-boot-lock.ts")}
+      import { publishStartup, isStarting, startupGraceMs } from ${moduleURL("personalize-startup-state.ts")}
+      const directory = ${JSON.stringify(directory)}
+      const options = { directory, timeoutMs: 2000 }
+      const first = await acquireBootLock("same", options)
+      let pulse = false
+      setTimeout(() => { pulse = true }, 10)
+      const begun = performance.now()
+      await assert.rejects(acquireBootLock("same", { ...options, timeoutMs: 150 }), /Timed out/)
+      assert.ok(pulse, "contention must yield to the event loop")
+      assert.ok(performance.now() - begun < 1000, "live-owner wait must be bounded")
+      const abort = new AbortController()
+      const pending = acquireBootLock("same", { ...options, signal: abort.signal })
+      abort.abort()
+      await assert.rejects(pending)
+      await assert.rejects(acquireBootLock("aborted", { ...options, signal: abort.signal }))
+      first.release()
+      const second = await acquireBootLock("same", options)
+      first.release() // must not release the successor, including same PID
+      await assert.rejects(acquireBootLock("same", { ...options, timeoutMs: 50 }), /Timed out/)
+      second.release()
+      const childFile = directory + "/owner.mjs"
+      writeFileSync(childFile, \`
+        import { acquireBootLock } from ${moduleURL("personalize-boot-lock.ts")}
+        const lease = await acquireBootLock("crash", { directory: \${JSON.stringify(directory)} })
+        console.log("owned")
+        // An event-loop hang cannot defeat kernel-held ownership.
+        for (;;) {}
+      \`)
+      const child = spawn(process.execPath, [childFile], { stdio: ["ignore", "pipe", "pipe"] })
+      const exited = once(child, "exit")
+      try {
+        const [out] = await once(child.stdout, "data")
+        assert.match(out.toString(), /owned/)
+        await assert.rejects(acquireBootLock("crash", { ...options, timeoutMs: 100 }), /Timed out/)
+        child.kill("SIGKILL")
+        await exited
+        const at = performance.now()
+        const recovered = await acquireBootLock("crash", options)
+        assert.ok(performance.now() - at < 1000, "dead owner must not leave a 60s lease")
+        recovered.release()
+      } finally {
+        if (child.exitCode === null && child.signalCode === null) { child.kill("SIGKILL"); await exited }
+      }
+      // Three independent processes repeatedly enter the same critical section.
+      // The exclusive witness file detects overlap instead of inferring it
+      // from timestamps; it is not used as the ownership mechanism.
+      const contenderFile = directory + "/contender.mjs"
+      writeFileSync(contenderFile, \`
+        import { acquireBootLock } from ${moduleURL("personalize-boot-lock.ts")}
+        import { writeFileSync, unlinkSync } from "node:fs"
+        import { setTimeout as sleep } from "node:timers/promises"
+        for (let i = 0; i < 8; i++) {
+          const lease = await acquireBootLock("race", { directory: \${JSON.stringify(directory)}, timeoutMs: 5000 })
+          try {
+            writeFileSync(\${JSON.stringify(directory + "/witness")}, "", { flag: "wx" })
+            await sleep(5)
+            unlinkSync(\${JSON.stringify(directory + "/witness")})
+          } finally { lease.release() }
+        }
+      \`)
+      const children = Array.from({ length: 3 }, () => spawn(process.execPath, [contenderFile],
+        { stdio: ["ignore", "ignore", "pipe"] }))
+      try {
+        const results = await Promise.all(children.map(async c => {
+          let errors = ""; c.stderr.on("data", x => { errors += x })
+          const [code, signal] = await once(c, "exit")
+          return { code, signal, errors }
+        }))
+        for (const r of results) assert.equal(r.code, 0, JSON.stringify(r))
+      } finally {
+        for (const c of children) if (c.exitCode === null && c.signalCode === null) c.kill("SIGKILL")
+      }
+      const info = { id: "generation-a", pid: process.pid, url: "http://127.0.0.1:1", version: "test", password: "private" }
+      const done = publishStartup(info, directory)
+      assert.equal(isStarting(info, directory), true)
+      for (const change of [{ id: "generation-b" }, { pid: 2147483647 }, { password: "wrong" },
+        { url: "http://127.0.0.1:2" }, { version: "other" }])
+        assert.equal(isStarting({ ...info, ...change }, directory), false)
+      assert.throws(() => publishStartup(info, directory), /EEXIST/)
+      const stateFile = readdirSync(directory).find(x => x.endsWith(".json"))
+      assert.ok(!readFileSync(directory + "/" + stateFile, "utf8").includes("private"))
+      writeFileSync(directory + "/" + stateFile, JSON.stringify({ protocol: 1, startedAt: Date.now() - startupGraceMs - 1 }))
+      assert.equal(isStarting(info, directory), false, "startup hang must resume stock recovery")
+      done(); done()
+      assert.equal(isStarting(info, directory), false)
+      const newer = { ...info, id: "generation-b" }
+      const finishNewer = publishStartup(newer, directory)
+      done()
+      assert.equal(isStarting(newer, directory), true, "old cleanup must not remove new generation")
+      finishNewer()
+      assert.equal(isStarting(newer, directory), false, "ready/failed states must stop startup protection")
+      console.log("ownership and startup state passed", process.platform)
+    `)
+    const result = spawnSync(process.env.BUN_EXECUTABLE ?? "bun", [script], { encoding: "utf8", timeout: 20_000 })
+    assert.ifError(result.error)
+    assert.equal(result.status, 0, result.stdout + result.stderr)
+  } finally {
+    rmSync(directory, { recursive: true, force: true })
+  }
+})
