@@ -0,0 +1,19 @@
+import { Effect, Option } from "effect"
+import { HttpServer } from "effect/http"
+import { PersonalizeBoot } from "@opencode/util/personalize-boot"
+import { OPENCODE_VERSION } from "../version"
+
+export function decorate(stock: typeof import("../services/service-registration")) {
+  const register: typeof stock.register = (options) => Effect.gen(function* () {
+    const boot = yield* Effect.serviceOption(PersonalizeBoot)
+    // Publish before the stock registration becomes visible and before the
+    // synchronous database bootstrap can block HTTP. Preserve the stock lease,
+    // ownership monitor, shutdown, and returned cleanup without alteration.
+    if (Option.isSome(boot)) yield* Effect.sync(() => boot.value.register?.({
+      id: options.id, pid: process.pid, url: HttpServer.formatAddress(options.address),
+      version: OPENCODE_VERSION, password: options.password,
+    }))
+    return yield* stock.register(options)
+  })
+  return { register }
+}
diff --git a/packages/util/src/personalize-boot-lock.ts b/packages/util/src/personalize-boot-lock.ts
new file mode 100644
index 0000000000000000000000000000000000000000..b531b79dc0453cdf1a4c2554894e4b97702f63f5
--- /dev/null
+++ b/packages/util/src/personalize-boot-lock.ts
@@ -0,0 +1,59 @@
+import { Database } from "bun:sqlite"
+import { createHash } from "node:crypto"
+import { mkdirSync } from "node:fs"
+import os from "node:os"
+import path from "node:path"
+import { setTimeout as sleep } from "node:timers/promises"
+
+export interface BootLease {
+  release(): void
+}
+
+// These are empty *control* files, never the application database. SQLite's
+// native file locks belong to the open connection and are released by the OS
+// even on SIGKILL/TerminateProcess. Do not unlink them: replacing the inode
+// would let two processes lock different files under the same name.
+export async function acquireBootLock(key: string, options: {
+  directory?: string
+  signal?: AbortSignal
+  timeoutMs?: number
+} = {}): Promise<BootLease> {
+  const timeout = options.timeoutMs ?? 90_000
+  if (!Number.isFinite(timeout) || timeout < 0) throw new Error("Invalid boot-lock timeout")
+  const deadline = performance.now() + timeout
+  const directory = options.directory ?? path.join(os.tmpdir(), "opencode", "personalize-boot-locks-v2")
+  const file = path.join(directory, createHash("sha256").update(key).digest("hex") + ".sqlite")
+  options.signal?.throwIfAborted()
+  mkdirSync(directory, { recursive: true, mode: 0o700 })
+  let firstAttempt = true
+  for (;;) {
+    options.signal?.throwIfAborted()
+    if (!firstAttempt && performance.now() >= deadline) throw new Error("Timed out waiting for bootstrap ownership")
+    firstAttempt = false
+    let db: Database | undefined
+    try {
+      db = new Database(file, { create: true })
+      // No native busy wait: yield to JS between attempts so cancellation and
+      // health remain responsive. Never steal a live owner's lock by age/PID.
+      db.run("PRAGMA busy_timeout=0")
+      db.run("BEGIN EXCLUSIVE")
+      options.signal?.throwIfAborted()
+      const owned = db
+      let released = false
+      return { release() {
+        if (released) return
+        // This connection is the ownership capability. Closing an old lease
+        // cannot close a successor's connection, even after PID reuse.
+        owned.close()
+        released = true
+      } }
+    } catch (error) {
+      db?.close()
+      if (!(error instanceof Error) || !("code" in error) ||
+          (error.code !== "SQLITE_BUSY" && error.code !== "SQLITE_LOCKED")) throw error
+    }
+    const remaining = deadline - performance.now()
+    if (remaining <= 0) throw new Error("Timed out waiting for bootstrap ownership")
+    await sleep(Math.min(100, remaining), undefined, { signal: options.signal })
+  }
+}
diff --git a/packages/util/src/personalize-startup-state.ts b/packages/util/src/personalize-startup-state.ts
new file mode 100644
index 0000000000000000000000000000000000000000..a5cdd2a48ace9700c790b0fa0698b68579338213
--- /dev/null
+++ b/packages/util/src/personalize-startup-state.ts
@@ -0,0 +1,67 @@
+import { createHash } from "node:crypto"
+import { mkdirSync, readFileSync, unlinkSync, writeFileSync } from "node:fs"
+import os from "node:os"
+import path from "node:path"
+
+// A one-shot startup allowance, NOT a health/ready result or a renewable lease.
+// At expiry the unchanged client timeout/recovery rules resume.
+export const startupGraceMs = 30_000
+export type StartupIdentity = {
+  id?: string
+  pid: number
+  url: string
+  version?: string
+  password?: string
+}
+
+function filename(info: StartupIdentity, directory: string) {
+  if (!info.id || !info.password || !Number.isSafeInteger(info.pid) || info.pid <= 0) return
+  const key = createHash("sha256").update(JSON.stringify([
+    info.id, info.pid, info.url, info.version, info.password,
+  ])).digest("hex")
+  return path.join(directory, key + ".json")
+}
+const root = () => path.join(os.tmpdir(), "opencode", "personalize-startup-state")
+// Bound the allowance by monotonic time after the first observation, even if
+// the wall clock changes. Retain expired observations rather than re-arm them.
+const observed = new Map<string, number>()
+
+export function publishStartup(info: StartupIdentity, directory = root()) {
+  const file = filename(info, directory)
+  if (!file) return () => {}
+  mkdirSync(directory, { recursive: true, mode: 0o700 })
+  // Instance ID is random and registered by the CLI. Exclusive create means a
+  // second publish cannot renew an existing instance's allowance.
+  writeFileSync(file, JSON.stringify({ protocol: 1, startedAt: Date.now() }), { flag: "wx", mode: 0o600 })
+  let finished = false
+  return () => {
+    if (finished) return
+    finished = true
+    // Unique full-generation path: no successor's state can be removed here.
+    try { unlinkSync(file) } catch {}
+  }
+}
+
+export function isStarting(info: StartupIdentity, directory = root()): boolean {
+  const file = filename(info, directory)
+  if (!file) return false
+  try {
+    const state = JSON.parse(readFileSync(file, "utf8"))
+    const age = Date.now() - state.startedAt
+    if (state.protocol !== 1 || !Number.isSafeInteger(state.startedAt) || age < 0 || age >= startupGraceMs)
+      return false
+    let deadline = observed.get(file)
+    if (deadline === undefined) {
+      if (observed.size >= 256) observed.delete(observed.keys().next().value!)
+      deadline = performance.now() + startupGraceMs - age
+      observed.set(file, deadline)
+    }
+    if (performance.now() >= deadline) return false
+    // ESRCH, permission errors and uncertain liveness all fail closed. This
+    // check never grants lock ownership or deletes anything.
+    process.kill(info.pid, 0)
+    return true
+  } catch {
+    return false
+  }
+}
