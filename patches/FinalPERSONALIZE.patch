+import { Context, Effect, Layer, Option } from "effect"
+import { Job } from "@opencode/core/job"
+import { Bus } from "@opencode/core/bus"
+import { SessionExecution } from "@opencode/core/session/execution"
+import { SessionEvent } from "@opencode/schema/session-event"
+import { lifetime } from "./idle-state"
+
+// One route-builder seam, using the app's actual services (not a second bus).
+export function decorate(stock: typeof import("../routes")) {
+  const createRoutes: typeof stock.createRoutes = (options, urls, ...rest) => {
+    const jobs = Job.node.mapLayer((layer) => layer.pipe(Layer.flatMap((context) => {
+      const service = Context.get(context, Job.Service)
+      // Admission and execution are separate lifetimes: start can join an
+      // existing generation without ever evaluating the supplied run effect.
+      // Stock start forks new work immediately before returning, so admission
+      // covers the handoff and only the executed generation owns a job lease.
+      const start: Job.Interface["start"] = (input) => Effect.acquireUseRelease(
+        Effect.sync(() => lifetime.work("requests")),
+        () => service.start({
+          ...input,
+          run: Effect.acquireUseRelease(
+            Effect.sync(() => lifetime.work()),
+            () => input.run,
+            (done) => Effect.sync(done),
+          ),
+        }),
+        (done) => Effect.sync(done),
+      )
+      return Layer.succeed(Job.Service, { ...service, start })
+    })))
+    const executions = SessionExecution.node.mapLayer((layer) => layer.pipe(Layer.flatMap((context) =>
+      Layer.effect(SessionExecution.Service, Effect.gen(function* () {
+        const service = Context.get(context, SessionExecution.Service)
+        // This dependency already belongs to the stock execution graph. Query
+        // it without changing mapLayer's dependency contract.
+        const bus = yield* Effect.serviceOption(Bus.Service)
+        if (Option.isNone(bus)) {
+          lifetime.softBlocked = true
+          return service // Hard control remains available if soft cannot prove safety.
+        }
+        const running = new Map<string, () => void>()
+        lifetime.externalBusy = () => Effect.runSync(service.active).size > 0
+        const unsubscribe = yield* bus.value.listen((event) => Effect.sync(() => {
+          if (!event.data || typeof event.data !== "object") return
+          const id = Reflect.get(event.data, "sessionID")
+          if (typeof id !== "string") return
+          if (event.type === SessionEvent.Execution.Started.type && !running.has(id))
+            running.set(id, lifetime.work())
+          if (event.type === SessionEvent.Execution.Succeeded.type || event.type === SessionEvent.Execution.Failed.type ||
+            event.type === SessionEvent.Execution.Interrupted.type) {
+            running.get(id)?.()
+            running.delete(id)
+          }
+        }))
+        yield* Effect.addFinalizer(() => unsubscribe.pipe(Effect.andThen(Effect.sync(() => {
+          for (const done of running.values()) done()
+          lifetime.externalBusy = () => false
+        }))))
+        return service
+      })),
+    )))
+    // Caller replacements retain priority. Forward every stock argument.
+    rest[0] = [Job.node.replace(jobs), SessionExecution.node.replace(executions), ...(rest[0] ?? [])]
+    return stock.createRoutes(options, urls, ...rest)
+  }
+  return { createRoutes }
+}
diff --git a/packages/server/src/personalize/service-status.ts b/packages/server/src/personalize/service-status.ts
new file mode 100644
index 0000000000000000000000000000000000000000..0c12ff3ac8c3093671ce60c390deed19a2e2c7b0
--- /dev/null
+++ b/packages/server/src/personalize/service-status.ts
@@ -0,0 +1,24 @@
+import { Effect, Option, Ref } from "effect"
+import { PersonalizeBoot } from "@opencode/util/personalize-boot"
+import { lifetime } from "./idle-state"
+
+export function decorate(stock: typeof import("../service-status")) {
+  const make: typeof stock.make = (options = {}) => Effect.gen(function* () {
+    type State = import("../service-status").State | { readonly type: "retrying" }
+    const state = yield* Ref.make<State>(options.initial ?? { type: "starting" })
+    const boot = yield* Effect.serviceOption(PersonalizeBoot)
+    const release = Option.isSome(boot) ? boot.value.release : Effect.void
+    if (Option.isSome(boot)) boot.value.retry = Ref.update(state, (value) =>
+      value.type === "starting" || value.type === "retrying" ? { type: "retrying" } as const : value)
+    return {
+      // The wire may expose retrying; the owned Promise client normalizes it to waiting.
+      current: Ref.get(state) as Effect.Effect<import("../service-status").State>,
+      ready: Ref.update(state, (value) => value.type === "starting" || value.type === "retrying" ? { type: "ready" } as const : value)
+        .pipe(Effect.andThen(release), Effect.tap(() => Effect.sync(() => lifetime.start()))),
+      fail: Ref.update(state, (value) => value.type === "starting" || value.type === "retrying" ? { type: "failed" } as const : value)
+        .pipe(Effect.andThen(release)),
+      beginStopping: Ref.update(state, (value) => value.type === "stopping" ? value : { type: "stopping" } as const),
+    }
+  })
+  return { make }
+}
