@@ -0,0 +1,52 @@
+import { Event } from "@opencode/schema/event"
+import { Effect, Stream } from "effect"
+import { HttpServerResponse } from "effect/http"
+import { HttpApiBuilder } from "effect/http-api"
+import { Api } from "../api"
+import { EventFeed } from "../event-feed"
+import { lifetime } from "./idle-state"
+
+// ============================================================================
+// PERSONALIZATION (deltav11) — SSE handler with idle-reaper activity.
+// Actual stream ownership, not a 15s heartbeat estimate: even /killtime 1s
+// must leave connected windows alone. A scoped lease is released when the
+// stream closes, fails, or is interrupted. The stock module is referenced
+// only in the type position below — erased at build, no runtime cycle.
+// ============================================================================
+
+export function decorate(stock: typeof import("../handlers/event")) {
+  const EventHandler = HttpApiBuilder.group(Api, "server.event", (handlers) =>
+    Effect.gen(function* () {
+      const feed = yield* EventFeed.Service
+      return handlers.handleRaw("event.subscribe", (ctx) =>
+        Effect.gen(function* () {
+          const connected = {
+            id: Event.ID.create(),
+            type: "server.connected",
+            data: {},
+          } as const
+          const output = Stream.unwrap(
+            Effect.acquireRelease(Effect.sync(() => lifetime.connect()), (close) => Effect.sync(close)).pipe(
+              Effect.andThen(feed.subscribe(ctx.query.types)),
+              Effect.map((live) => Stream.make(EventFeed.frame(connected)).pipe(Stream.concat(live))),
+            ),
+          )
+          const heartbeat = Stream.tick("15 seconds").pipe(Stream.map(() => ": heartbeat\n\n"))
+          return HttpServerResponse.stream(
+            output.pipe(Stream.merge(heartbeat, { haltStrategy: "left" }), Stream.encodeText),
+            {
+              contentType: "text/event-stream",
+              headers: {
+                "Cache-Control": "no-cache, no-transform",
+                "X-Accel-Buffering": "no",
+                "X-Content-Type-Options": "nosniff",
+              },
+            },
+          )
+        }),
+      )
+    }),
+  ) as typeof stock.EventHandler
+
+  return { EventHandler }
+}
diff --git a/packages/server/src/personalize/idle-state.ts b/packages/server/src/personalize/idle-state.ts
new file mode 100644
index 0000000000000000000000000000000000000000..8bee9fb60c5fc38bce9a5eb6f74558ccb63c9e98
--- /dev/null
+++ b/packages/server/src/personalize/idle-state.ts
@@ -0,0 +1,51 @@
+import { Lifetime } from "@opencode/util/personalize-lifetime"
+import { settings, sleeping, evictSelf } from "@opencode/util/personalize-lifetime-store"
+
+export const lifetime = new Lifetime(settings())
+
+// Exactly one deadline timer, rescheduled by actual client/job transitions.
+// No heartbeat heuristics, watchdog polling, fibers, or spawned processes.
+export function armIdleWatchdog(soft: () => void, hard = () => {
+  try { process.kill(process.pid, "SIGKILL") } catch {}
+  process.exit(137)
+}) {
+  let timer: ReturnType<typeof setTimeout> | undefined
+  let disarmed = false
+  function schedule() {
+    if (timer) clearTimeout(timer)
+    timer = undefined
+    if (disarmed) return
+    const next = lifetime.next()
+    if (!next) return
+    timer = setTimeout(() => {
+      const due = lifetime.next()
+      if (!due || due.after > 0) return schedule()
+      // Write before disconnecting: existing windows must park, not respawn it.
+      try { sleeping(due.kind) } catch (error) {
+        console.error("[personalize] cannot record service sleep", error)
+        if (due.kind === "soft") {
+          // Avoid a soft-stop/auto-respawn loop. Hard control stays armed.
+          lifetime.softBlocked = true
+          return schedule()
+        }
+      }
+      console.error(`[personalize] ${due.kind} lifetime deadline reached`)
+      if (due.kind === "hard") {
+        lifetime.stopped = true
+        try { evictSelf() } catch {}
+        hard()
+      } else {
+        lifetime.softStopping = true
+        try { soft() } finally { schedule() }
+      }
+    }, next.after)
+    timer.unref?.()
+  }
+  lifetime.changed = schedule
+  schedule()
+  return () => {
+    disarmed = true
+    if (timer) clearTimeout(timer)
+    lifetime.changed = () => {}
+  }
+}
diff --git a/packages/server/src/personalize/process.ts b/packages/server/src/personalize/process.ts
new file mode 100644
index 0000000000000000000000000000000000000000..530d5f700bf2816bfc3b9786e2a4fc2fcea8511a
--- /dev/null
+++ b/packages/server/src/personalize/process.ts
@@ -0,0 +1,84 @@
+import { Effect, Option } from "effect"
+import { HttpServerRequest, HttpServerResponse } from "effect/http"
+import { PersonalizeBoot, withBootLock } from "@opencode/util/personalize-boot"
+import { publishStartup } from "@opencode/util/personalize-startup-state"
+import { defaults, duration } from "@opencode/util/personalize-lifetime"
+import { save } from "@opencode/util/personalize-lifetime-store"
+import { authorizedRequest, unauthorizedResponse } from "../middleware/authorization"
+import { armIdleWatchdog, lifetime } from "./idle-state"
+
+export function decorate(stock: typeof import("../process")) {
+  // Keep the complete stock signature and forward its tail unchanged.
+  const start: typeof stock.start = (options, ...rest) => {
+    const [lifecycle, transform] = rest
+    if (lifecycle) {
+      rest[0] = {
+        ...lifecycle,
+        onListen: (address, shutdown) => Effect.gen(function* () {
+            const cleanup = yield* lifecycle.onListen(address, shutdown)
+            armIdleWatchdog(() => { void Effect.runPromise(shutdown).catch(console.error) })
+            // The unref'd hard deadline survives graceful finalizers. If they
+            // hang it still kills; if the process exits normally it holds no
+            // handles open and needs no extra cleanup machinery.
+            return cleanup.pipe(Effect.ensuring(Effect.sync(() => {
+              lifetime.softStopping = true
+              lifetime.changed()
+            })))
+          }),
+      }
+      rest[1] = (app) => {
+        const next = transform ? transform(app) : app
+        return Effect.gen(function* () {
+          const request = yield* HttpServerRequest.HttpServerRequest
+          if (new URL(request.url, "http://localhost").pathname === "/_personalize/lifetime") {
+            if (!(yield* authorizedRequest(request, { password: Option.fromNullishOr(options.password), username: "opencode" })))
+              return unauthorizedResponse(request)
+            const reply = (body: unknown, status = 200) => HttpServerResponse.text(JSON.stringify(body), {
+              status, contentType: "application/json",
+            })
+            if (request.method === "GET") return reply(lifetime.settings)
+            if (request.method !== "PUT") return reply({ error: "Use GET or PUT" }, 405)
+            const body: unknown = yield* request.json.pipe(Effect.catch(() => Effect.succeed(undefined)))
+            if (!body || typeof body !== "object") return reply({ error: "Expected command and duration" }, 400)
+            const command = Reflect.get(body, "command"), input = Reflect.get(body, "duration")
+            if ((command !== "killtime" && command !== "softkilltime") || typeof input !== "string")
+              return reply({ error: "Expected killtime or softkilltime and a duration" }, 400)
+            const key = command === "killtime" ? "hardMs" : "softMs"
+            let ms: number
+            try { ms = duration(input, defaults[key]) }
+            catch (error) { return reply({ error: error instanceof Error ? error.message : String(error) }, 400) }
+            const settings = { ...lifetime.settings, [key]: ms }
+            try { save(settings) }
+            catch { return reply({ error: "Could not save lifetime settings; nothing changed" }, 500) }
+            lifetime.configure(settings)
+            return reply(settings)
+          }
+          // A mutation in progress protects soft shutdown; reads/heartbeats do
+          // not keep an idle server alive. Job leases protect asynchronous work.
+          if (request.method === "GET" || request.method === "HEAD") return yield* next
+          return yield* Effect.acquireUseRelease(
+            Effect.sync(() => lifetime.work("requests")),
+            () => next,
+            (done) => Effect.sync(done),
+          )
+        })
+      }
+    }
+    return withBootLock("service-bootstrap", (lease) => {
+      let finish = () => {}
+      let finished = false
+      const release = Effect.sync(() => {
+        finished = true
+        try { finish() } finally { lease.release() }
+      })
+      return stock.start(options, ...rest).pipe(
+        Effect.provideService(PersonalizeBoot, {
+          retry: Effect.void, release,
+          register: (info) => { if (!finished) finish = publishStartup(info) },
+        }),
+        Effect.ensuring(release),
+      )
+    })
+  }
+  return { start }
+}
diff --git a/packages/server/src/personalize/routes.ts b/packages/server/src/personalize/routes.ts
new file mode 100644
index 0000000000000000000000000000000000000000..1ba2eb45e5c0df3be6621b9c4bb1092ba2d9f9e4
--- /dev/null
+++ b/packages/server/src/personalize/routes.ts
@@ -0,0 +1,67 @@
+import { Context, Effect, Layer, Option } from "effect"
+import { Job } from "@opencode/core/job"
+import { Bus } from "@opencode/core/bus"
+import { SessionExecution } from "@opencode/core/session/execution"
+import { SessionEvent } from "@opencode/schema/session-event"
+import { lifetime } from "./idle-state"
+
+// One route-builder seam, using the app's actual services (not a second bus).
+export function decorate(stock: typeof import("../routes")) {
+  const createRoutes: typeof stock.createRoutes = (options, urls, ...rest) => {
+    const jobs = Job.node.mapLayer((layer) => layer.pipe(Layer.flatMap((context) => {
+      const service = Context.get(context, Job.Service)
+      // Admission and execution are separate lifetimes: start can join an
+      // existing generation without ever evaluating the supplied run effect.
+      // Stock start forks new work immediately before returning, so admission
+      // covers the handoff and only the executed generation owns a job lease.
+      const start: Job.Interface["start"] = (input) => Effect.acquireUseRelease(
+        Effect.sync(() => lifetime.work("requests")),
+        () => service.start({
+          ...input,
+          run: Effect.acquireUseRelease(
+            Effect.sync(() => lifetime.work()),
+            () => input.run,
+            (done) => Effect.sync(done),
+          ),
+        }),
+        (done) => Effect.sync(done),
+      )
+      return Layer.succeed(Job.Service, { ...service, start })
+    })))
+    const executions = SessionExecution.node.mapLayer((layer) => layer.pipe(Layer.flatMap((context) =>
+      Layer.effect(SessionExecution.Service, Effect.gen(function* () {
+        const service = Context.get(context, SessionExecution.Service)
+        // This dependency already belongs to the stock execution graph. Query
+        // it without changing mapLayer's dependency contract.
+        const bus = yield* Effect.serviceOption(Bus.Service)
+        if (Option.isNone(bus)) {
+          lifetime.softBlocked = true
+          return service // Hard control remains available if soft cannot prove safety.
+        }
+        const running = new Map<string, () => void>()
+        lifetime.externalBusy = () => Effect.runSync(service.active).size > 0
+        const unsubscribe = yield* bus.value.listen((event) => Effect.sync(() => {
+          if (!event.data || typeof event.data !== "object") return
+          const id = Reflect.get(event.data, "sessionID")
+          if (typeof id !== "string") return
+          if (event.type === SessionEvent.Execution.Started.type && !running.has(id))
+            running.set(id, lifetime.work())
+          if (event.type === SessionEvent.Execution.Succeeded.type || event.type === SessionEvent.Execution.Failed.type ||
+            event.type === SessionEvent.Execution.Interrupted.type) {
+            running.get(id)?.()
+            running.delete(id)
+          }
+        }))
+        yield* Effect.addFinalizer(() => unsubscribe.pipe(Effect.andThen(Effect.sync(() => {
+          for (const done of running.values()) done()
+          lifetime.externalBusy = () => false
+        }))))
+        return service
+      })),
+    )))
+    // Caller replacements retain priority. Forward every stock argument.
+    rest[0] = [Job.node.replace(jobs), SessionExecution.node.replace(executions), ...(rest[0] ?? [])]
+    return stock.createRoutes(options, urls, ...rest)
+  }
+  return { createRoutes }
+}
diff --git a/packages/server/src/personalize/service-status.ts b/packages/server/src/personalize/service-status.ts
new file mode 100644
index 0000000000000000000000000000000000000000..0c12ff3ac8c3093671ce60c390deed19a2e2c7b0
--- /dev/null
+++ b/packages/server/src/personalize/service-status.ts
@@ -0,0 +1,24 @@
+import { Effect, Option, Ref } from "effect"
+import { PersonalizeBoot } from "@opencode/util/personalize-boot"
+import { lifetime } from "./idle-state"
+
+export function decorate(stock: typeof import("../service-status")) {
+  const make: typeof stock.make = (options = {}) => Effect.gen(function* () {
+    type State = import("../service-status").State | { readonly type: "retrying" }
+    const state = yield* Ref.make<State>(options.initial ?? { type: "starting" })
+    const boot = yield* Effect.serviceOption(PersonalizeBoot)
+    const release = Option.isSome(boot) ? boot.value.release : Effect.void
+    if (Option.isSome(boot)) boot.value.retry = Ref.update(state, (value) =>
+      value.type === "starting" || value.type === "retrying" ? { type: "retrying" } as const : value)
+    return {
+      // The wire may expose retrying; the owned Promise client normalizes it to waiting.
+      current: Ref.get(state) as Effect.Effect<import("../service-status").State>,
+      ready: Ref.update(state, (value) => value.type === "starting" || value.type === "retrying" ? { type: "ready" } as const : value)
+        .pipe(Effect.andThen(release), Effect.tap(() => Effect.sync(() => lifetime.start()))),
+      fail: Ref.update(state, (value) => value.type === "starting" || value.type === "retrying" ? { type: "failed" } as const : value)
+        .pipe(Effect.andThen(release)),
+      beginStopping: Ref.update(state, (value) => value.type === "stopping" ? value : { type: "stopping" } as const),
+    }
+  })
+  return { make }
+}
