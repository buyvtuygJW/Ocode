index 0000000000000000000000000000000000000000..d599cc7ea1f8c5c2f38c35f6c2e1e2a483bb9176
--- /dev/null
+++ b/packages/util/src/personalize-boot.ts
@@ -0,0 +1,26 @@
+import { Context, Effect, Option } from "effect"
+
+export interface BootState {
+  retry: Effect.Effect<void>
+  release: Effect.Effect<void>
+}
+export class PersonalizeBoot extends Context.Service<PersonalizeBoot, BootState>()("@personalize/Boot") {}
+
+export const updateBoot = (kind: "retry" | "release") => Effect.serviceOption(PersonalizeBoot).pipe(
+  Effect.flatMap((state) => Option.isSome(state) ? state.value[kind] : Effect.void),
+)
+
+export function sqliteBusy(input: unknown): boolean {
+  const seen = new Set<unknown>()
+  const visit = (value: unknown): boolean => {
+    if (value === null || value === undefined || seen.has(value)) return false
+    seen.add(value)
+    if (typeof value === "string") return /SQLITE_(?:BUSY|LOCKED)|database (?:is )?(?:locked|busy)/i.test(value)
+    if (typeof value !== "object") return false
+    const record = value as Record<string, unknown>
+    if ([record.message, record.code, record.errno].some((part) => typeof part === "string" && visit(part))) return true
+    return [record.cause, record.error, record.reason, record.reasons, record.left, record.right]
+      .some((part) => Array.isArray(part) ? part.some(visit) : visit(part))
+  }
+  return visit(input)
+}
diff --git a/packages/util/src/personalize-lifetime-store.ts b/packages/util/src/personalize-lifetime-store.ts
new file mode 100644
index 0000000000000000000000000000000000000000..364aaed02572b3537188efaf6997c27c5fe078e7
--- /dev/null
+++ b/packages/util/src/personalize-lifetime-store.ts
@@ -0,0 +1,52 @@
+import fs from "node:fs"
+import path from "node:path"
+import { Global } from "./global"
+import { defaults, type Settings, type Stop } from "./personalize-lifetime"
+
+// Small settings/sleep files beside the existing service registration. These
+// are data only: no service, scheduler, autostart, polling, or process creation.
+const serviceFile = () => process.env.OPENCODE_SERVICE_FILE ?? path.join(Global.Path.state, "service.json")
+
+function read(file: string): unknown {
+  try { return JSON.parse(fs.readFileSync(file, "utf8")) } catch { return undefined }
+}
+
+function write(file: string, value: unknown) {
+  fs.mkdirSync(path.dirname(file), { recursive: true })
+  const temporary = `${file}.${process.pid}.tmp`
+  try {
+    fs.writeFileSync(temporary, JSON.stringify(value))
+    fs.renameSync(temporary, file)
+  } finally {
+    fs.rmSync(temporary, { force: true })
+  }
+}
+
+export function settings(): Settings {
+  const value = read(`${serviceFile()}.lifetime.json`)
+  if (!value || typeof value !== "object") return { ...defaults }
+  const result = { ...defaults }
+  for (const key of ["hardMs", "softMs"] as const) {
+    const ms = Reflect.get(value, key)
+    if (Number.isSafeInteger(ms) && ms > 0 && ms <= 2_147_483_647) result[key] = ms
+  }
+  return result
+}
+
+export function save(value: Settings) { write(`${serviceFile()}.lifetime.json`, value) }
+
+export function sleeping(kind: Stop) {
+  write(`${serviceFile()}.sleep.json`, { at: Date.now(), pid: process.pid, kind })
+}
+
+export function sleptAfter(time: number) {
+  const value = read(`${serviceFile()}.sleep.json`)
+  return !!value && typeof value === "object" && Number(Reflect.get(value, "at")) > time
+}
+
+export function evictSelf() {
+  const file = serviceFile()
+  const value = read(file)
+  if (value && typeof value === "object" && Reflect.get(value, "pid") === process.pid)
+    fs.rmSync(file, { force: true })
+}
diff --git a/packages/util/src/personalize-lifetime.ts b/packages/util/src/personalize-lifetime.ts
new file mode 100644
index 0000000000000000000000000000000000000000..9c028b081902a5a4b504535de0f64187f88a9215
--- /dev/null
+++ b/packages/util/src/personalize-lifetime.ts
@@ -0,0 +1,124 @@
+// Shared command syntax and pure lifetime policy. No processes, I/O, or timers.
+export const defaults = { hardMs: 20_000, softMs: 10_000 }
+export type Settings = typeof defaults
+export type Stop = "hard" | "soft"
+
+export function duration(input: string, fallback: number): number {
+  if (input.trim() === "default") return fallback
+  const match = /^(\d+(?:\.\d+)?)\s*(ms|s|m)$/i.exec(input.trim())
+  const ms = match ? Number(match[1]) * ({ ms: 1, s: 1000, m: 60_000 }[match[2].toLowerCase()] ?? 0) : NaN
+  if (!Number.isSafeInteger(ms) || ms < 1 || ms > 2_147_483_647)
+    throw new Error("Use a positive duration such as 1s, 500ms, 1m, or default. Zero does not disable shutdown.")
+  return ms
+}
+
+export class Lifetime {
+  clients = 0
+  jobs = 0
+  requests = 0
+  ready = false
+  stopped = false
+  softStopping = false
+  softBlocked = false
+  externalBusy = () => false
+  private disconnected = 0
+  private quiet = 0
+  changed = () => {}
+  settings: Settings
+  private now: () => number
+
+  constructor(settings: Settings = { ...defaults }, now = () => performance.now()) {
+    this.settings = settings
+    this.now = now
+  }
+
+  start() {
+    this.ready = true
+    this.disconnected = this.quiet = this.now()
+    this.changed()
+  }
+
+  configure(settings: Settings) {
+    this.settings = settings
+    this.softBlocked = false
+    // A custom value gets a full fresh countdown, not an already-expired one.
+    this.disconnected = this.quiet = this.now()
+    this.changed()
+  }
+
+  connect() {
+    this.clients++
+    this.changed()
+    return this.once(() => {
+      this.clients--
+      if (this.clients === 0) this.disconnected = this.now()
+      this.changed()
+    })
+  }
+
+  work(kind: "jobs" | "requests" = "jobs") {
+    this[kind]++
+    this.changed()
+    return this.once(() => {
+      this[kind]--
+      if (this.jobs === 0 && this.requests === 0) this.quiet = this.now()
+      this.changed()
+    })
+  }
+
+  next(): { kind: Stop; after: number } | undefined {
+    if (!this.ready || this.stopped) return
+    const hard = this.clients === 0 ? this.disconnected + this.settings.hardMs : Infinity
+    let busy = true
+    // A broken soft-state probe must never break or delay the hard timer.
+    try { busy = this.externalBusy() } catch {}
+    const soft = this.clients === 0 && !this.softStopping && !this.softBlocked && this.jobs === 0 && this.requests === 0 && !busy
+      ? Math.max(this.quiet + this.settings.softMs, this.disconnected + this.settings.hardMs / 2) : Infinity
+    if (!Number.isFinite(Math.min(hard, soft))) return
+    // Hard wins equal deadlines, and never waits for jobs or the soft timer.
+    return hard <= soft
+      ? { kind: "hard", after: Math.max(0, hard - this.now()) }
+      : { kind: "soft", after: Math.max(0, soft - this.now()) }
+  }
+
+  private once(fn: () => void) {
+    let done = false
+    return () => {
+      if (done) return
+      done = true
+      fn()
+    }
+  }
+}
+
+// Reconnect may wait here after an intentional sleep. Only user input wakes
+// it; SSE retries do not authorize spawning a replacement server.
+export class WakeGate {
+  private allowed: number
+  private pending = new Set<() => void>()
+  private sleptAfter: (time: number) => boolean
+  private now: () => number
+  constructor(sleptAfter: (time: number) => boolean, now = () => Date.now()) {
+    this.sleptAfter = sleptAfter
+    this.now = now
+    this.allowed = now()
+  }
+  wake() {
+    this.allowed = this.now()
+    for (const resolve of [...this.pending]) resolve()
+  }
+  wait(signal: AbortSignal): Promise<void> {
+    if (signal.aborted) return Promise.reject(signal.reason)
+    if (!this.sleptAfter(this.allowed)) return Promise.resolve()
+    return new Promise((resolve, reject) => {
+      const done = () => { cleanup(); resolve() }
+      const abort = () => { cleanup(); reject(signal.reason) }
+      const cleanup = () => {
+        this.pending.delete(done)
+        signal.removeEventListener("abort", abort)
+      }
+      this.pending.add(done)
+      signal.addEventListener("abort", abort, { once: true })
+    })
+  }
+}
