+      return { url: fixtureURL, shortCircuit: true }
+    if (context.parentURL?.includes("/core/src/") && specifier.startsWith(".") &&
+      stubs.has(new URL(specifier, context.parentURL).pathname.split("/core/src/")[1]))
+      return { url: fixtureURL, shortCircuit: true }
