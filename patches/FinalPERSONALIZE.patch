@@ -0,0 +1,80 @@
+import { For, Show, createEffect } from "solid-js"
+import { createStore } from "solid-js/store"
+import type { PermissionDecision, PresenterRequest } from "@opencode/schema/personalize/permission-controller"
+import { choices, choiceLabel, policyDirectories, policyError, policyHint, policyText, unknownShell } from "@opencode/schema/personalize/permission-policy"
+import { Button } from "@opencode/ui/button"
+import { useLanguage } from "@/runtime/i18n/language"
+
+export interface PermissionControlsProps {
+  request: PresenterRequest
+  responding: boolean
+  onDecide: (response: PermissionDecision) => void
+}
+
+// A decision editor, not a replacement for the stock request presentation.
+// Keeping the editor with its buttons gives it one owner and one request lifetime.
+export function PermissionControls(props: PermissionControlsProps) {
+  const language = useLanguage()
+  const [policy, setPolicy] = createStore({ text: "", error: "", show: false })
+  let requestKey = ""
+  createEffect(() => {
+    const key = JSON.stringify([props.request.sessionID, props.request.id])
+    if (key === requestKey) return
+    requestKey = key
+    setPolicy({ text: "", error: "", show: false })
+  })
+  const unknown = () => unknownShell(props.request)
+  const options = () => choices(props.request)
+  const label = (choice: "once" | "always" | "reject" | "session_read" | "policy") =>
+    choiceLabel(choice, unknown(), (stock) => {
+      if (stock === "once") return language.t("ui.permission.allowOnce")
+      if (stock === "always") return language.t("ui.permission.allowAlways")
+      return language.t("ui.permission.deny")
+    })
+  const applyPolicy = () => {
+    if (props.responding || !options().includes("policy")) return
+    const error = policyError(policy.text, unknown(), props.request)
+    setPolicy("error", error ?? "")
+    if (!error) props.onDecide({ scope: "session", policy: policy.text.trim() })
+  }
+
+  return (
+    <div class="flex flex-col gap-2 w-full">
+      <Show when={unknown()}><span>Unknown effects may bypass filesystem denies.</span></Show>
+      <Show when={options().includes("policy") && policy.show}>
+        <label data-slot="permission-policy">
+          <span>{policyText.label}</span>
+          <For each={policyDirectories(props.request)}>{(directory) => <code>{directory}</code>}</For>
+          <input
+            value={policy.text}
+            placeholder={unknown() ? `${policyText.placeholder} / ${policyText.unknownPlaceholder}` : policyText.placeholder}
+            disabled={props.responding}
+            onInput={(event) => setPolicy("text", event.currentTarget.value)}
+            onKeyDown={(event) => { if (event.key === "Enter") { event.preventDefault(); applyPolicy() } }}
+          />
+          <span>{policyHint(unknown(), props.request)}</span>
+          <Show when={policy.error}><span role="alert">{policy.error}</span></Show>
+        </label>
+        <Button variant="neutral" disabled={props.responding} onClick={applyPolicy}>{policyText.apply}</Button>
+      </Show>
+      <div data-slot="permission-footer-actions">
+        <For each={options()}>
+          {(choice) => (
+            <Button
+              variant={choice === "once" ? "submit" : choice === "reject" ? "ghost" : "neutral"}
+              size="normal"
+              disabled={props.responding}
+              onClick={() => {
+                if (props.responding) return
+                if (choice === "policy") setPolicy("show", !policy.show)
+                else props.onDecide(choice)
+              }}
+            >
+              {label(choice)}
+            </Button>
+          )}
+        </For>
+      </div>
+    </div>
+  )
+}
diff --git a/packages/core/src/permission/session-grant.ts b/packages/core/src/permission/session-grant.ts
new file mode 100644
index 0000000000000000000000000000000000000000..f5f94849f06f6b2ab04b1af3e68cac369c8df436
--- /dev/null
+++ b/packages/core/src/permission/session-grant.ts
@@ -0,0 +1,149 @@
+export * as SessionGrant from "./session-grant.js"
+
+import path from "node:path"
+import type { Permission } from "@opencode/schema/permission"
+import type { Operation, Reply, Selection } from "@opencode/schema/personalize/permission-contract"
+import { parsePolicy, readFacts, type RequestLike } from "@opencode/schema/personalize/permission-policy"
+
+/** Stored only in the root Session.permissions. Ordinary action matching must ignore this action. */
+export const action = "__opencode_filesystem_session_v1"
+export interface Grant extends Selection {
+  readonly directory: string
+  readonly machine?: string
+}
+type Input = Pick<RequestLike, "action" | "operations" | "paths" | "access" | "metadata">
+
+export function selections(reply: Reply): readonly Selection[] | undefined {
+  if (typeof reply === "object") {
+    if ("rules" in reply) return validate(reply.rules)
+    if ("policy" in reply) {
+      const parsed = parsePolicy(reply.policy, false)
+      if (parsed.kind !== "filesystem") throw new Error("Expected filesystem policy")
+      return validate(parsed.rules)
+    }
+    return validate((["read", "create", "update", "delete"] as const).flatMap((operation) =>
+      reply[operation] === "ask" ? [] : [{
+        operation, effect: reply[operation], lifetime: "session" as const,
+        recursive: reply.recursive?.includes(operation) ?? true, scope: "selected" as const,
+      }]))
+  }
+  const operations: readonly Operation[] | undefined = reply === "session_read" ? ["read"]
+    : reply === "session_create" ? ["create"] : reply === "session_update" ? ["update"]
+    : reply === "session_delete" ? ["delete"] : reply === "session_crud" ? ["read", "create", "update", "delete"] : undefined
+  return operations?.map((operation) => ({
+    operation, effect: "allow", lifetime: "session", recursive: true, scope: "selected",
+  }))
+}
+
+export function validate(rules: readonly Selection[]) {
+  if (!rules.length) throw new Error("Select at least one filesystem operation.")
+  const seen = new Set<Operation>()
+  for (const rule of rules) {
+    if (!["read", "create", "update", "delete"].includes(rule.operation) ||
+      !["allow", "deny", "ask"].includes(rule.effect) ||
+      !["once", "session"].includes(rule.lifetime) || typeof rule.recursive !== "boolean" ||
+      !["selected", "parent-list"].includes(rule.scope))
+      throw new Error("Invalid filesystem selection.")
+    if (seen.has(rule.operation)) throw new Error(`Duplicate or contradictory policy for ${rule.operation}.`)
+    seen.add(rule.operation)
+    if (rule.scope === "parent-list" && (rule.operation !== "read" || rule.recursive || rule.effect !== "allow"))
+      throw new Error("Parent-list scope is valid only for nonrecursive read allows.")
+  }
+  return rules
+}
+
+function normalize(value: string) {
+  const windows = /^[a-z]:[\\/]/i.test(value) || value.startsWith("\\\\") || value.startsWith("//")
+  const normalized = (windows ? path.win32.normalize(value) : path.posix.normalize(value)).replaceAll("\\", "/")
+  return (windows ? normalized.toLowerCase() : normalized).replace(/\/+$/, "")
+}
+export function contains(directory: string, target: string) {
+  const root = normalize(directory)
+  const file = normalize(target)
+  return file === root || file.startsWith(`${root}/`)
+}
+export function parent(directory: string) {
+  return (/^[a-z]:[\\/]/i.test(directory) || directory.startsWith("\\\\") || directory.startsWith("//")
+    ? path.win32.dirname(directory) : path.posix.dirname(directory)).replaceAll("\\", "/")
+}
+export function needs(input: Input) {
+  const facts = readFacts(input)
+  if (!["external_directory", "read", "edit", "glob", "grep", "list"].includes(input.action) || !facts) return false
+  return input.action === "external_directory" || input.action === "edit" ||
+    facts.operations.every((operation) => operation === "read")
+}
+function matches(grant: Grant, input: Input, target: string) {
+  if (grant.machine !== readFacts(input)?.machine) return false
+  if (grant.scope === "parent-list")
+    return input.metadata?.filesystemReadScope !== "recursive" &&
+      readFacts(input)?.access === "listing" && normalize(target) === normalize(parent(grant.directory))
+  // Search leaves inspect descendants, not just their root. Narrow allows cannot
+  // authorize that traversal, and nested denies/asks still constrain it.
+  if (input.metadata?.filesystemReadScope === "recursive") {
+    if (grant.effect === "allow") return grant.recursive && contains(grant.directory, target)
+    if (contains(target, grant.directory)) return true
+  }
+  return grant.recursive ? contains(grant.directory, target) : normalize(grant.directory) === normalize(target) ||
+    normalize(parent(target)) === normalize(grant.directory)
+}
+export function decision(grants: readonly Grant[], input: Input): Permission.Effect | undefined {
+  if (!needs(input)) return
+  const facts = readFacts(input)!
+  const effects = facts.operations.flatMap((operation) => facts.paths.map((target) => {
+    const candidates = grants.filter((grant) => grant.operation === operation && matches(grant, input, target))
+    if (candidates.some((grant) => grant.effect === "deny")) return "deny"
+    if (candidates.some((grant) => grant.effect === "ask")) return "explicit-ask"
+    if (candidates.some((grant) => grant.effect === "allow")) return "allow"
+    return "ask"
+  }))
+  if (effects.includes("deny")) return "deny"
+  if (effects.includes("explicit-ask")) return "ask"
+  if (effects.every((effect) => effect === "allow")) return "allow"
+}
+export function unknownEffectsDenied(grants: readonly Grant[], input: Input) {
+  return input.metadata?.filesystemEffects === "unknown" && grants.some((grant) => grant.effect === "deny")
+}
+/** Selected resources are precisely the displayed directories, never save patterns. */
+export function directories(input: RequestLike): string[] | undefined {
+  if (!needs(input)) return
+  const facts = readFacts(input)!
+  if (!facts.directories && (input.action !== "external_directory" || !input.resources.length ||
+    !input.resources.every((resource) => resource.endsWith("/*")))) return
+  const result = facts.directories ? [...facts.directories] : input.resources.map((resource) => resource.slice(0, -2))
+  if (!result.length || result.some((directory) => !path.posix.isAbsolute(directory) && !path.win32.isAbsolute(directory))) return
+  if (result.some((directory) => /[*?]/.test(directory))) return
+  if (!facts.paths.every((target) => result.some((directory) => contains(directory, target)))) return
+  return result
+}
+export function encode(grant: Grant): Permission.Rule {
+  return { action, resource: JSON.stringify(grant), effect: grant.effect }
+}
+/** Invalid reserved records fail closed rather than silently granting filesystem access. */
+export function decode(rules: Permission.Ruleset): Grant[] {
+  return rules.filter((rule) => rule.action === action).map((rule): Grant => {
+    const value: unknown = JSON.parse(rule.resource)
+    if (!value || typeof value !== "object" || !("directory" in value) || typeof value.directory !== "string" ||
+      !("operation" in value) || !["read", "create", "update", "delete"].includes(String(value.operation)) ||
+      !("effect" in value) || !["allow", "deny", "ask"].includes(String(value.effect)) ||
+      !("lifetime" in value) || value.lifetime !== "session" ||
+      !("recursive" in value) || typeof value.recursive !== "boolean" ||
+      !("scope" in value) || !["selected", "parent-list"].includes(String(value.scope)))
+      throw new Error("Invalid stored conversation filesystem policy. Revoke it using session permissions.")
+    const operation = value.operation
+    const effect = value.effect
+    const scope = value.scope
+    if ((operation !== "read" && operation !== "create" && operation !== "update" && operation !== "delete") ||
+      (effect !== "allow" && effect !== "deny" && effect !== "ask") ||
+      (scope !== "selected" && scope !== "parent-list")) throw new Error("Invalid stored filesystem policy.")
+    if (effect !== rule.effect) throw new Error("Stored filesystem policy effect disagrees with its permission rule.")
+    const machine = "machine" in value ? value.machine : undefined
+    if (machine !== undefined && (typeof machine !== "string" || !machine || /[\0\r\n]/.test(machine)))
+      throw new Error("Invalid stored filesystem machine.")
+    const grant: Grant = { operation, effect, scope, lifetime: "session", recursive: value.recursive,
+      directory: value.directory, ...(machine === undefined ? {} : { machine }) }
+    validate([grant])
+    if ((!path.posix.isAbsolute(grant.directory) && !path.win32.isAbsolute(grant.directory)) || /[*?]/.test(grant.directory))
+      throw new Error("Invalid stored filesystem directory.")
+    return grant
+  })
+}
diff --git a/packages/core/src/personalize/checked-publication.ts b/packages/core/src/personalize/checked-publication.ts
new file mode 100644
index 0000000000000000000000000000000000000000..adbed0900de14f4852a076131f9c9d8cfeab4a3a
--- /dev/null
+++ b/packages/core/src/personalize/checked-publication.ts
@@ -0,0 +1,72 @@
+import { Deferred, Effect, PubSub } from "effect"
+import type { Event } from "@opencode/schema/event"
+import type { PublishOptions, Subscriber } from "../bus.js"
+import type { KeyedMutex } from "../effect/keyed-mutex.js"
+
+/** Listeners see an advisory, non-durable proposal; streams see committed events. */
+export interface CheckedPublishOptions<E> extends PublishOptions {
+  readonly check: Effect.Effect<void, E>
+}
+
+export interface CheckedBus {
+  readonly publishChecked: <D extends Event.DurableDefinition, E>(
+    definition: D, data: Event.Data<D>, options: CheckedPublishOptions<E>,
+  ) => Effect.Effect<Event.Payload<D>, E>
+}
+
+// Exact proposal identity, not an event ID or a global "publication mode".
+// Entries exist only for the supervised worker's lifetime.
+const receipts = new WeakMap<Event.Payload, Deferred.Deferred<Event.Payload>>()
+
+/** The explicit Bus seam calls this AFTER SQLite commits and BEFORE delivery. */
+export const acknowledgeCommit = (proposal: Event.Payload, committed: Event.Payload) => Effect.suspend(() => {
+  const receipt = receipts.get(proposal)
+  return receipt ? Deferred.succeed(receipt, committed).pipe(Effect.asVoid) : Effect.void
+})
+
+export const makeCheckedPublisher = Effect.fn("Bus.makeCheckedPublisher")(function* (deps: {
+  listeners: readonly Subscriber[]
+  locks: KeyedMutex.KeyedMutex<string>
+  makePayload: (definition: Event.Definition, data: unknown, options?: PublishOptions) => Effect.Effect<Event.Payload>
+  aggregateID: (type: string, aggregate: string, data: unknown) => Effect.Effect<string>
+  commit: (definition: Event.Definition, event: Event.Payload, input: undefined, commit?: PublishOptions["commit"]) =>
+    Effect.Effect<{ event: Event.Payload } | void>
+  live: PubSub.PubSub<Event.Payload>
+  typed: ReadonlyMap<string, ReadonlySet<PubSub.PubSub<Event.Payload>>>
+}) {
+  const scope = yield* Effect.scope
+  const publishChecked: CheckedBus["publishChecked"] = (definition, data, options) =>
+    Effect.uninterruptible(Effect.gen(function* () {
+      const proposal = yield* deps.makePayload(definition, data, options)
+      const aggregateID = yield* deps.aggregateID(definition.type, definition.durable.aggregate, data)
+      // Fallible authorization work runs before the write and outside both
+      // locks. Listeners may publish other events without deadlocking.
+      for (const listener of [...deps.listeners])
+        yield* Effect.suspend(() => listener(proposal))
+      yield* options.check
+      const receipt = yield* Deferred.make<Event.Payload>()
+      receipts.set(proposal, receipt)
+      // Retain the aggregate lock through observation, but release the caller
+      // at the transaction receipt. Delivery cannot reverse a successful grant.
+      yield* deps.locks.withLock(aggregateID)(Effect.gen(function* () {
+        const committed = yield* deps.commit(definition, proposal, undefined, options.commit)
+        if (!committed) return yield* Effect.die(new Error("Checked publication did not commit"))
+        // The stock commit already routed the event and woke durable readers.
+        // Live precedes typed delivery, whose subscribers may publish followups.
+        yield* PubSub.publish(deps.live, committed.event)
+        const typed = deps.typed.get(committed.event.type)
+        if (typed) yield* Effect.forEach(typed, (subscriber) => PubSub.publish(subscriber, committed.event), { discard: true })
+      })).pipe(
+        Effect.catchCause((cause) => Deferred.failCause(receipt, cause).pipe(
+          Effect.flatMap((failed) => failed ? Effect.void : Effect.logError("Committed event delivery failed", {
+            eventID: proposal.id, eventType: proposal.type, cause,
+          })),
+        )),
+        Effect.ensuring(Effect.sync(() => { receipts.delete(proposal) })),
+        Effect.uninterruptible,
+        Effect.forkIn(scope),
+      )
+      return (yield* Deferred.await(receipt)) as Event.Payload<typeof definition>
+    }))
+  return { publishChecked } satisfies CheckedBus
+})
diff --git a/packages/core/src/personalize/filesystem-permission.ts b/packages/core/src/personalize/filesystem-permission.ts
new file mode 100644
index 0000000000000000000000000000000000000000..8ddf8dd0b8af87395793ba28fcd096fd4f8cb258
--- /dev/null
+++ b/packages/core/src/personalize/filesystem-permission.ts
@@ -0,0 +1,95 @@
+import path from "node:path"
+import { Effect } from "effect"
+import type { FileDiff } from "@opencode/schema/file-diff"
+import { metadataKey, readFacts, withFacts, type Facts, type Operation } from "@opencode/schema/personalize/permission-policy"
+import { Environment } from "../environment/index.js"
+import type { Environments } from "../environment/environments.js"
+import { FileAccess } from "../file-access.js"
+import { Permission } from "../permission.js"
+
+type Files = Environment.Interface["files"]
+type Metadata = Permission.AssertInput["metadata"]
+
+/** One stat policy for reads and writes: missing is distinct from inaccessible. */
+export const optionalStat = (files: Files, file: string) => files.stat(file).pipe(
+  Effect.catchTag("Environment.NotFound", () => Effect.undefined),
+)
+
+export function filesystemMetadata(
+  targets: readonly FileAccess.Target[],
+  operations: readonly Operation[],
+  access?: Facts["access"],
+  metadata?: Metadata,
+): Metadata {
+  const machine = targets[0]?.machine
+  if (targets.some((target) => target.machine !== machine))
+    throw new Error("Filesystem permission facts cannot combine different machines")
+  return withFacts({ metadata }, {
+    operations,
+    ...(machine === undefined ? {} : { machine }),
+    paths: targets.map((target) => target.absolute),
+    directories: [...new Set(targets.map((target) => access === "listing" || metadata?.filesystemReadScope === "recursive"
+      ? target.absolute : target.externalDirectory?.directory ?? (target.environment.path ?? path).dirname(target.absolute)))],
+    ...(access === undefined ? {} : { access }),
+  }).metadata
+}
+
+/** External approval uses only the exact external subset, never a saved parent glob. */
+export function externalMetadata(allTargets: readonly FileAccess.Target[], metadata: Metadata): Metadata {
+  const targets = allTargets.filter((target) => target.externalDirectory !== undefined)
+  const facts = readFacts({ metadata })
+  if (!facts) return metadata
+  if (!targets.every((target) => facts.paths.includes(target.absolute)))
+    throw new Error("External permission facts do not describe the requested targets")
+  const { [metadataKey]: _previous, ...rest } = metadata!
+  return withFacts({ metadata: rest }, {
+    ...facts,
+    paths: targets.map((target) => target.absolute),
+    directories: [...new Set(targets.map((target) => target.externalDirectory!.directory))],
+  }).metadata
+}
+
+/** Add facts to stock authorization; never resolve paths or recreate its requests. */
+export function filesystemReadMetadata(
+  target: FileAccess.Target, environments: Pick<Environments.Interface, "ready">,
+) {
+  return Effect.gen(function* () {
+  // The upstream resolver deliberately avoids waking a cold sandbox before approval.
+  // An unknown target is conservatively content, never eligible for listing-only grants.
+  const ready = yield* environments.ready(target.environment.id)
+  const stat = ready ? yield* optionalStat(target.environment.files, target.absolute) : undefined
+  return filesystemMetadata([target], ["read"], stat?.type === "directory" ? "listing" : "content")
+  })
+}
+
+export function makeFileWritePermissions(deps: {
+  readonly access: Pick<FileAccess.Interface, "resolve" | "authorizeExternal">
+  readonly permission: Pick<Permission.Interface, "assert">
+}) {
+  const externalApproved = new WeakMap<FileAccess.Target, Operation>()
+  const operation = (target: FileAccess.Target) => optionalStat(target.environment.files, target.absolute).pipe(
+    Effect.map((stat): Operation => stat ? "update" : "create"),
+  )
+  const target = Effect.fn("FileWrite.target")(function* (file: string, context: FileAccess.Invocation) {
+    const target = yield* deps.access.resolve({ path: file, kind: "file" })
+    const kind = yield* operation(target)
+    yield* deps.access.authorizeExternal([target], context, filesystemMetadata([target], [kind]))
+    externalApproved.set(target, kind)
+    return target
+  })
+  const authorize = Effect.fn("FileWrite.authorize")(function* (
+    target: FileAccess.Target, context: FileAccess.Invocation, preview?: FileDiff.Info,
+  ) {
+    const kind = yield* operation(target)
+    const metadata = filesystemMetadata([target], [kind], undefined, preview ? { files: [preview] } : undefined)
+    if (externalApproved.get(target) !== kind) {
+      yield* deps.access.authorizeExternal([target], context, metadata)
+      externalApproved.set(target, kind)
+    }
+    yield* deps.permission.assert({
+      action: "edit", resources: [target.resource], save: [FileAccess.always(target)], metadata,
+      ...Permission.invocation(context),
+    })
+  })
+  return { target, authorize }
+}
diff --git a/packages/core/src/personalize/patch-permission.ts b/packages/core/src/personalize/patch-permission.ts
new file mode 100644
index 0000000000000000000000000000000000000000..ed86bfd977d4ee8acaca3259f0a80b2b99105fd8
--- /dev/null
+++ b/packages/core/src/personalize/patch-permission.ts
@@ -0,0 +1,55 @@
+import { Effect } from "effect"
+import type { FileDiff } from "@opencode/schema/file-diff"
+import type { Operation } from "@opencode/schema/personalize/permission-contract"
+import type { Patch } from "@opencode/util/patch"
+import { FileAccess } from "../file-access.js"
+import { Permission } from "../permission.js"
+import { filesystemMetadata, optionalStat } from "./filesystem-permission.js"
+
+/** Per-invocation authorization ledger; patch parsing, previews and writes stay stock. */
+export function makePatchPermissions(deps: {
+  access: Pick<FileAccess.Interface, "resolve" | "authorizeExternal">
+  permission: Pick<Permission.Interface, "assert">
+  context: FileAccess.Invocation
+  updates: ReadonlyMap<string, { target: FileAccess.Target; content: string | null }>
+}) {
+  const needs: { target: FileAccess.Target; operation: Operation }[] = []
+  const authorizeTarget = Effect.fnUntraced(function* (target: FileAccess.Target, operation?: Operation) {
+    const key = FileAccess.key(target)
+    const exists = deps.updates.has(key) ? deps.updates.get(key)!.content !== null
+      : !!(yield* optionalStat(target.environment.files, target.absolute))
+    const actual = operation ?? (exists ? "update" : "create")
+    needs.push({ target, operation: actual })
+    if (target.externalDirectory) {
+      yield* deps.access.authorizeExternal([target], deps.context, filesystemMetadata([target], [actual], undefined, {
+        filepath: target.absolute,
+        parentDir: target.externalDirectory.directory,
+      }))
+    }
+    return target
+  })
+  const prepare = Effect.fnUntraced(function* (hunk: Patch.Hunk) {
+    const target = yield* deps.access.resolve({ path: hunk.path, kind: "file" })
+    const move = hunk.type === "update" && hunk.movePath
+      ? yield* deps.access.resolve({ path: hunk.movePath, kind: "file" }) : undefined
+    const moves = move && FileAccess.key(move) !== FileAccess.key(target)
+    yield* authorizeTarget(target, hunk.type === "delete" ? "delete"
+      : hunk.type === "update" ? (moves ? "delete" : "update") : undefined)
+    // Stock still resolves a syntactically present move. A move back to the
+    // same normalized path is an update, not a delete/create pair.
+    const resolveTarget = (_value: string) => moves ? authorizeTarget(move) : Effect.succeed(target)
+    return { target, resolveTarget }
+  })
+  const assert = Effect.fnUntraced(function* (targets: readonly FileAccess.Target[], files: readonly FileDiff.Info[]) {
+    for (const need of needs) yield* deps.permission.assert({
+      action: "edit", resources: [need.target.resource], save: [FileAccess.always(need.target)],
+      metadata: filesystemMetadata([need.target], [need.operation], undefined, {
+        filepath: targets.map((target) => target.resource).join(", "),
+        diff: files.map((file) => `${file.patch}\n`).join(""),
+        files,
+      }),
+      ...Permission.invocation(deps.context),
+    })
+  })
+  return { prepare, assert }
+}
