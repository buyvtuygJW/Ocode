new file mode 100644
index 0000000000000000000000000000000000000000..9b82f866fe187a9f627bff31c2124385ec0fd9c6
--- /dev/null
+++ b/packages/core/src/personalize/decay-policy.ts
@@ -0,0 +1,23 @@
+import { AsyncLocalStorage } from "node:async_hooks"
+
+// Per-resolved-model policy, not a URL or provider-name heuristic. Keeping the
+// marker out of the model avoids passing a client option to provider SDKs.
+const bypass = new WeakSet<object>()
+const scope = new AsyncLocalStorage<boolean>()
+
+export const rememberDecayBypass = <T extends object>(model: T, enabled: boolean): T => {
+  if (enabled) bypass.add(model)
+  return model
+}
+
+export const withDecayPolicy = <T>(model: object, run: () => T): T => scope.run(bypass.has(model), run)
+export const bypassDecay = () => scope.getStore() === true
+
+/** Strip the client-only setting before constructing a provider model. */
+export function splitDecaySetting<T extends { readonly settings?: Readonly<Record<string, unknown>> }>(model: T) {
+  const settings = model.settings
+  if (!settings || !("ocodeContextDecay" in settings)) return { model, bypass: false }
+  const { ocodeContextDecay, ...rest } = settings
+  if (typeof ocodeContextDecay !== "boolean") throw new TypeError("ocodeContextDecay must be a boolean")
+  return { model: { ...model, settings: rest }, bypass: ocodeContextDecay === false }
+}
diff --git a/packages/core/src/personalize/model-resolver.ts b/packages/core/src/personalize/model-resolver.ts
new file mode 100644
index 0000000000000000000000000000000000000000..08f7bb0a8ffbbbc4dbf52a57d0d7c307585244cf
--- /dev/null
+++ b/packages/core/src/personalize/model-resolver.ts
@@ -0,0 +1,33 @@
+import { Model } from "../model"
+import { Context, Effect, Layer } from "effect"
+import { rememberDecayBypass, splitDecaySetting } from "./decay-policy"
+
+export function decorate(stock: typeof import("../model-resolver")) {
+  // The stock node already depends on Model.node; mapLayer's generic R cannot
+  // express that existing requirement even though the node supplies it.
+  const node = stock.node.mapLayer((layer) => layer.pipe(Layer.flatMap((context) => Layer.effect(stock.Service, Effect.gen(function* () {
+    const service = Context.get(context, stock.Service)
+    const models = yield* Model.Service
+    const resolveModel: typeof service.resolveModel = (selected, variant) => {
+      const split = splitDecaySetting(selected)
+      // Variant-level overrides are not supported: remove the client-only key
+      // there too, so it can never leak to the provider.
+      const variants = split.model.variants?.map((item) => splitDecaySetting(item).model)
+      const cleaned = variants ? { ...split.model, variants } : split.model
+      return service.resolveModel(cleaned, variant).pipe(Effect.map((resolved) => rememberDecayBypass(resolved, split.bypass)))
+    }
+    const resolve: typeof service.resolve = Effect.fn("PersonalizeModelResolver.resolve")(function* (requested) {
+      const selected = requested
+        ? yield* models.get(requested.providerID, requested.id)
+        : yield* models.default().pipe(Effect.flatMap((model) =>
+            model && stock.hasPackage(model)
+              ? Effect.succeed(model)
+              : Effect.map(models.available(), (all) => all.find((model) => stock.hasPackage(model) && Model.supportsText(model))),
+          ))
+      if (!selected) return undefined
+      return yield* resolveModel(selected, requested?.variant)
+    })
+    return stock.Service.of({ ...service, resolve, resolveModel })
+  })))) as typeof layer)
+  return { node }
+}
diff --git a/packages/core/test/personalize-decay-policy.test.ts b/packages/core/test/personalize-decay-policy.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..7789dcd00099b000f01e0e132d2b99cdb6317130
--- /dev/null
+++ b/packages/core/test/personalize-decay-policy.test.ts
@@ -0,0 +1,49 @@
+import { expect, test } from "bun:test"
+import { Context, Effect, Layer } from "effect"
+import { Model } from "../src/model"
+import { decorate } from "../src/personalize/model-resolver"
+import { bypassDecay, rememberDecayBypass, splitDecaySetting, withDecayPolicy } from "../src/personalize/decay-policy"
+
+test("the decay opt-in is strict, model-scoped and removed from provider settings", () => {
+  const selected = { settings: { baseURL: "http://localhost", ocodeContextDecay: false } }
+  const split = splitDecaySetting(selected)
+  expect(split.bypass).toBe(true)
+  expect(split.model.settings.baseURL).toBe("http://localhost")
+  expect("ocodeContextDecay" in split.model.settings).toBe(false)
+  expect(selected.settings.ocodeContextDecay).toBe(false)
+  expect(splitDecaySetting({ settings: { baseURL: "x" } }).bypass).toBe(false)
+  expect(splitDecaySetting({ settings: { ocodeContextDecay: true } }).bypass).toBe(false)
