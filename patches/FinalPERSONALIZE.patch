index 0000000000000000000000000000000000000000..e362747a9694ad5c049894e7944650f72aeae689
--- /dev/null
+++ b/packages/core/src/personalize/database.ts
@@ -0,0 +1,40 @@
+import path from "node:path"
+import { Cause, Effect, Exit, Layer, Scope } from "effect"
+import { Global } from "@opencode/util/global"
+import { Flock } from "@opencode/util/flock"
+import { sqliteBusy, updateBoot } from "@opencode/util/personalize-boot"
+import { guardSessionSchema } from "./schema-guard"
+
+export function decorate(stock: typeof import("../database/database")) {
+  const layer: typeof stock.layer = (options = { path: ":memory:" }) => {
+    const filename = options.path ?? ":memory:"
+    if (filename === ":memory:") return stock.layer(options)
+    return Layer.effectContext(Effect.gen(function* () {
+      const global = yield* Global.Service
+      const file = path.isAbsolute(filename) ? filename : path.join(global.data, filename)
+      const parent = yield* Scope.Scope
+      return yield* Effect.acquireUseRelease(
+        Effect.promise((signal) => Flock.acquire(file, { dir: path.join(global.state, "locks"), signal })),
+        () => Effect.gen(function* () {
+          for (let attempt = 0; ; attempt++) {
+            const scope = yield* Scope.make()
+            yield* Scope.addFinalizerExit(parent, (exit) => Scope.close(scope, exit))
+            const exit = yield* Effect.exit(Layer.buildWithScope(stock.layer({ ...options, path: file }), scope))
+            if (Exit.isSuccess(exit)) {
+              // Schema drift guard: runs after migrations settle; never throws (see schema-guard.ts).
+              guardSessionSchema(file)
+              return exit.value
+            }
+            yield* Scope.close(scope, exit)
+            if (attempt >= 6 || !sqliteBusy(Cause.pretty(exit.cause))) return yield* Effect.failCause(exit.cause)
+            yield* updateBoot("retry")
+            yield* Effect.sleep((attempt + 1) * 200)
+          }
+        }),
+        (lease) => Effect.promise(() => lease.release()),
+      )
+    }))
+  }
+  const configured: typeof stock.configured = (options) => stock.configured(options).mapLayer(() => layer(options))
+  return { layer, configured, node: configured({ path: ":memory:" }) }
+}
diff --git a/packages/core/src/personalize/dedup.ts b/packages/core/src/personalize/dedup.ts
new file mode 100644
index 0000000000000000000000000000000000000000..1a2df6d26176e114612993bcf26851f494b345b8
--- /dev/null
+++ b/packages/core/src/personalize/dedup.ts
@@ -0,0 +1,117 @@
+// ============================================================================
+// PERSONALIZATION (deltav11) — duplicate guards.
+// Prose echo only: adjacent duplicate sentences inside one text part are
+// stripped and counted. The call-echo guard was removed 2026-11-02: it read
+// args from `call.arguments` (the event carries them at `.input`), so every
+// signature degenerated to `name(null)` and it flagged ANY adjacent
+// same-tool pair — including authorized parallel spawns, which are
+// observationally identical to blind echoes. Parallel same-turn tool calls
+// are operator-authorized and must never be blocked.
+// Pure module: no imports, no effects — unit-tested in .personalize/dedup.test.mjs.
+// ============================================================================
+
+export interface LedgerEntry {
+  readonly calls: number
+  readonly prose: number
+  readonly wastedTokens: number
+}
+
+const ledgers = new Map<string, LedgerEntry>()
+
+export function resetLedger(): void {
+  ledgers.clear()
+}
+
+export function ledgerState(key: string): LedgerEntry | undefined {
+  return ledgers.get(key)
+}
+
+export function estimateTokens(text: string): number {
+  return Math.max(1, Math.ceil(text.length / 4))
+}
+
+export function bumpLedger(key: string, kind: "calls" | "prose", wastedTokens: number): LedgerEntry {
+  const entry = ledgers.get(key) ?? { calls: 0, prose: 0, wastedTokens: 0 }
+  const next: LedgerEntry = {
+    calls: entry.calls + (kind === "calls" ? 1 : 0),
+    prose: entry.prose + (kind === "prose" ? 1 : 0),
+    wastedTokens: entry.wastedTokens + wastedTokens,
+  }
+  ledgers.set(key, next)
+  return next
+}
+
+/** Cumulative punch line, injected once the session has two or more duplicates total. */
+export function punchLine(entry: LedgerEntry | undefined): string {
+  if (!entry) return ""
+  const total = entry.calls + entry.prose
+  if (total < 2) return ""
+  return `\n*SystemPunch* duplicates this session: ${total} (≈${entry.wastedTokens} tkn wasted)`
+}
+
+// --- prose echo ---------------------------------------------------------------
+
+/** Sentences shorter than this (normalized) are structural noise — never compared. */
+const MIN_SENTENCE_CHARS = 24
+
+export function normalizeSentence(sentence: string): string {
+  return sentence
+    .toLowerCase()
+    .replace(/\s+/g, " ")
+    .replace(/[^\p{L}\p{N} ]/gu, "")
+    .trim()
+}
+
+export function splitSentences(text: string): string[] {
+  return text
+    .split(/(?<=[.!?])\s+|\n+/)
+    .map((sentence) => sentence.trim())
+    .filter((sentence) => sentence.length > 0)
+}
+
+export interface DedupeTextResult {
+  readonly text: string
+  readonly removed: number
+  readonly wastedTokens: number
+}
+
+/**
+ * Strips runs of adjacent duplicate sentences from ONE text part. The first
+ * occurrence is kept, each stripped run leaves one inline marker. Everything
+ * else — short sentences, non-adjacent repeats, cross-part or cross-turn
+ * repetition — is deliberately left alone.
+ */
+export function dedupeText(text: string): DedupeTextResult | undefined {
+  if (text.length < MIN_SENTENCE_CHARS * 2) return undefined
+  const sentences = splitSentences(text)
+  if (sentences.length < 2) return undefined
+  const out: string[] = []
+  let removed = 0
+  let wastedTokens = 0
+  let changed = false
+  let index = 0
+  while (index < sentences.length) {
+    const kept = sentences[index]!
+    out.push(kept)
+    const normalized = normalizeSentence(kept)
+    let run = 0
+    while (
+      index + 1 + run < sentences.length &&
+      normalized.length >= MIN_SENTENCE_CHARS &&
+      normalizeSentence(sentences[index + 1 + run]!) === normalized
+    ) {
+      run++
+    }
+    if (run > 0) {
+      changed = true
+      removed += run
+      wastedTokens += run * estimateTokens(kept)
+      const preview = kept.length > 60 ? `${kept.slice(0, 60)}…` : kept
+      out.push(`[duplicate removed ×${run}: "${preview}"]`)
+      index += run
+    }
+    index++
+  }
+  if (!changed) return undefined
+  return { text: out.join(" "), removed, wastedTokens }
+}
diff --git a/packages/core/src/personalize/hooks.ts b/packages/core/src/personalize/hooks.ts
new file mode 100644
index 0000000000000000000000000000000000000000..9e0025b65220b87f18a016f4c1c144b294ad4898
--- /dev/null
+++ b/packages/core/src/personalize/hooks.ts
@@ -0,0 +1,32 @@
+import { Context, Effect, Layer } from "effect"
+import { canonicalMessages, copyWith } from "./content"
+import { personalizeSystem } from "./model-request"
+
+export function decorate(stock: typeof import("../plugin/hooks")) {
+  return { node: stock.node.mapLayer((layer) => Layer.effectContext(Effect.map(Layer.build(layer), (context) => {
+    const original = Context.get(context, stock.Service)
+    const trigger: typeof original.trigger = (domain, name, event) => Effect.suspend(() => {
+      if (domain !== "session" || !["context", "compaction", "generate", "title"].includes(String(name))) {
+        return original.trigger(domain, name, event)
+      }
+      const before = event as unknown as { system?: unknown; messages?: unknown }
+      const system = Array.isArray(before.system) ? [...before.system] : []
+      const messages = canonicalMessages(before.messages)
+      return original.trigger(domain, name, event).pipe(Effect.map((result) => {
+        const value = result as unknown as { system?: unknown; messages?: unknown; result?: unknown }
+        const shaped = copyWith(value, {
+          system: personalizeSystem(Array.isArray(value.system) ? value.system : system),
+          messages: canonicalMessages(Array.isArray(value.messages) ? value.messages : messages),
+        })
+        if (name === "title" && typeof shaped.result !== "string") {
+          const first = canonicalMessages(shaped.messages).find((message) => message.role === "user")
+          const text = first?.content.filter((part) => part.type === "text").map((part) => part.text).join(" ") || "New session"
+          const title = text.replace(/\s+/g, " ").trim()
+          shaped.result = title.length > 50 ? title.slice(0, 50) + "…" : title
+        }
+        return shaped as typeof result
+      }))
+    })
+    return Context.add(context, stock.Service, { ...original, trigger })
+  }))) }
+}
diff --git a/packages/core/src/personalize/markdown.ts b/packages/core/src/personalize/markdown.ts
new file mode 100644
index 0000000000000000000000000000000000000000..dfb1489f5102edcc989a16f226e449219ce5676f
--- /dev/null
+++ b/packages/core/src/personalize/markdown.ts
@@ -0,0 +1,87 @@
+import matter from "gray-matter"
+export function sanitize(content: string) {
+  const stripped = content.charCodeAt(0) === 0xfeff ? content.slice(1) : content
+  const match = stripped.match(/^---\r?\n([\s\S]*?)\r?\n---/)
+  if (!match) return content
+  const frontmatter = match[1]
+
+  // top-level "key:" or "key: value" (hyphen/dot keys allowed; space after ":" optional)
+  const KEY = /^([A-Za-z0-9][\w.-]*)[ \t]*:(?:[ \t]*(.*))?$/
+  // an intentional block-scalar header ("|", ">", "|-", ">2", ...) — leave alone
+  const BLOCK_HEADER = /^[|>][+-]?\d*$/
+  const isComment = (line: string) => /^\s*#/.test(line)
+
+  // tabs are illegal as YAML indentation -> spaces
+  const detab = (line: string) => {
+    const m = line.match(/^[ \t]+/)
+    return m ? m[0].replace(/\t/g, "  ") + line.slice(m[0].length) : line
+  }
+
+  const lines = frontmatter.split(/\r?\n/).map(detab)
+
+  const groups: { key: string; value: string; children: string[] }[] = []
+  const preface: string[] = []
+  let current: { key: string; value: string; children: string[] } | null = null
+  for (const line of lines) {
+    const entry = /^[ \t]/.test(line) || isComment(line) ? null : line.match(KEY)
+    if (entry) {
+      current = { key: entry[1], value: (entry[2] ?? "").trim(), children: [] }
+      groups.push(current)
+    } else if (current) {
+      current.children.push(line)
+    } else {
+      preface.push(line)
+    }
+  }
+
+  const needsBlock = (v: string) => v.includes(":") || / #/.test(v)
+
+  const out: string[] = [...preface]
+  for (const g of groups) {
+    // content lines that belong to this key's value (drop blanks and comments)
+    const body = g.children.filter((c) => c.trim() !== "" && !isComment(c))
+    const structured = g.children.some((c) => /^[ \t]+\S/.test(c) || /^\s*- /.test(c))
+    const quoted = g.value.startsWith('"') || g.value.startsWith("'")
+
+    // keep verbatim: a real block/list (empty value + indented block), an
+    // explicit block-scalar header, or a clean single-line quoted value
+    if ((g.value === "" && structured) || BLOCK_HEADER.test(g.value) || (quoted && body.length === 0)) {
+      out.push(g.value ? `${g.key}: ${g.value}` : `${g.key}:`)
+      for (const c of g.children) out.push(c)
+      continue
+    }
+
+    // empty value followed only by loose unindented text -> fold it in
+    if (g.value === "") {
+      if (body.length === 0) {
+        out.push(`${g.key}:`)
+        for (const c of g.children) out.push(c)
+      } else {
+        out.push(`${g.key}: |-`)
+        for (const c of body) out.push(`  ${c.trim()}`)
+      }
+      continue
+    }
+
+    // inline value: block-scalar it if it wraps onto more lines or needs escaping
+    if (body.length > 0 || needsBlock(g.value)) {
+      out.push(`${g.key}: |-`)
+      out.push(`  ${g.value}`)
+      for (const c of body) out.push(`  ${c.trim()}`)
+    } else {
+      out.push(`${g.key}: ${g.value}`)
+    }
+  }
+
+  const result = stripped.replace(frontmatter, () => out.join("\n"))
+  // the rewrite must parse -- otherwise return the input untouched so the
+  // strict parse error propagates and callers skip the file
+  try {
+    matter(result, {})
+  } catch {
+    return content
+  }
+  return result
+}
+
+export const decorate = (_stock: typeof import("../config/markdown")) => ({ sanitize })
diff --git a/packages/core/src/personalize/message-updater.ts b/packages/core/src/personalize/message-updater.ts
new file mode 100644
index 0000000000000000000000000000000000000000..eff6f79388ce8d3c00c2ed3a17e3cee38e5b233a
--- /dev/null
+++ b/packages/core/src/personalize/message-updater.ts
@@ -0,0 +1,25 @@
+// PERSONALIZATION (deltav11) — guard 2: prose echo.
+// Strips runs of adjacent duplicate sentences from ONE assistant text part
+// before the message is projected and stored, so both the display and the
+// next request's context carry the deduped text. The first occurrence is
+// kept; each stripped run leaves one inline marker. Cross-part and
+// cross-turn repetition is deliberately untouched (it may be deliberate).
+import { bumpLedger, dedupeText, punchLine } from "./dedup"
+
+export function decorate(stock: typeof import("../session/message-updater")) {
+  const update: typeof stock.update = (adapter, event) => {
+    if (event.type === "session.text.ended") {
+      const data = event.data as { readonly text: string; readonly sessionID?: unknown; readonly assistantMessageID?: unknown }
+      const result = dedupeText(data.text)
+      if (result) {
+        const key = String(data.sessionID ?? data.assistantMessageID ?? "session")
+        const entry = bumpLedger(key, "prose", result.wastedTokens)
+        const punch = punchLine(entry)
+        const text = punch ? `${result.text}\n${punch}` : result.text
+        event = { ...event, data: { ...data, text } }
+      }
+    }
+    return stock.update(adapter, event)
+  }
+  return { update }
+}
diff --git a/packages/core/src/personalize/model-request.ts b/packages/core/src/personalize/model-request.ts
new file mode 100644
index 0000000000000000000000000000000000000000..c1a0fee967026428af50bfba218da2798c346c5c
--- /dev/null
+++ b/packages/core/src/personalize/model-request.ts
@@ -0,0 +1,53 @@
+import { canonicalMessages, copyWith } from "./content"
+import { personaLead, stripStockIdentity } from "./persona"
+import { Context, Effect, Layer } from "effect"
+import { capRequest } from "./output-request"
+type SystemBlock = ReturnType<typeof import("../session/model-request").baseTranscript>["system"][number]
+
+export function personalizeSystem(system: readonly SystemBlock[]): SystemBlock[] {
+  const persona = personaLead()
+  if (!persona || !system[0]) return [...system]
+  return [copyWith(system[0], { text: [persona, stripStockIdentity(system[0].text)].filter(Boolean).join("\n") }), ...system.slice(1)]
+}
+
+export function decorate(stock: typeof import("../session/model-request")) {
+  const baseTranscript: typeof stock.baseTranscript = (...args) => {
+    const result = stock.baseTranscript(...args)
+    return { ...result, system: personalizeSystem(result.system) }
+  }
+  const unsupportedParts: typeof stock.unsupportedParts = (messages, ...rest) => stock.unsupportedParts(canonicalMessages(messages), ...rest)
+  const boundImages: typeof stock.boundImages = (messages, ...rest) => stock.boundImages(canonicalMessages(messages), ...rest)
+
+  // Call-echo guard REMOVED (2026-11-02), two reasons, both proven live:
+  // 1. It signed calls via `input.call.arguments`, but the ToolCall event
+  //    carries parsed arguments at `.input` — every signature degenerated to
+  //    `name(null)`, so ANY adjacent same-tool pair collided. Different
+  //    reads, different greps, and authorized parallel spawns were all
+  //    replaced with a fake receipt instead of executing.
+  // 2. Even with correct signatures, an intentional parallel spawn is
+  //    observationally identical to a blind echo (adjacent calls, no result
+  //    between them yet) — the guard cannot tell them apart, so it must not
+  //    block. Parallel same-turn tool calls are authorized by the operator.
+  // executeTool still passes through stock untouched. The layer only limits
+  // model output; no call signatures, deduplication or fake tool receipts.
+
+  const node = stock.node.mapLayer((layer) => layer.pipe(Layer.flatMap((context) => {
+    const service = Context.get(context, stock.Service)
+    type Interface = import("../session/model-request").Interface
+    const primary: Interface["primary"] = (input) => service.primary(input).pipe(Effect.map((value) => ({
+      ...value, request: capRequest(value.request, input.model, input.inputTokens && Math.max(input.inputTokens.measured, input.inputTokens.estimated)),
+    })))
+    const compaction: Interface["compaction"] = (input) => service.compaction(input).pipe(Effect.map((value) => ({
+      ...value, request: capRequest(value.request, input.model),
+    })))
+    const generate: Interface["generate"] = (input) => service.generate(input).pipe(Effect.map((value) => ({
+      ...value, request: capRequest(value.request, input.model),
+    })))
+    const title: Interface["title"] = (input) => service.title(input).pipe(Effect.map((value) => ({
+      ...value, request: capRequest(value.request, input.model),
+    })))
+    return Layer.succeed(stock.Service, { ...service, primary, compaction, generate, title })
+  })))
+
+  return { baseTranscript, unsupportedParts, boundImages, node }
+}
diff --git a/packages/core/src/personalize/output-policy.ts b/packages/core/src/personalize/output-policy.ts
new file mode 100644
index 0000000000000000000000000000000000000000..e3ccab058d6dc9f79f6dbe0902bb7e7b78ee9822
--- /dev/null
+++ b/packages/core/src/personalize/output-policy.ts
@@ -0,0 +1,71 @@
+import type { LLMEvent } from "@opencode/ai/effect"
+
+export const outputCaps = { default: 16_000, high: 32_000, xhigh: 50_000, max: 100_000 } as const
+
+function record(value: unknown): Record<string, unknown> {
+  return value !== null && typeof value === "object" ? value as Record<string, unknown> : {}
+}
+
+export function outputEffort(options: unknown, fallback?: string): string {
+  const value = record(options)
+  const effort = value.reasoningEffort ?? value.reasoning_effort ?? record(value.reasoning).effort ??
+    value.effort ?? record(value.outputConfig).effort ?? record(value.output_config).effort ??
+    record(value.thinkingConfig).thinkingLevel ?? fallback ?? "default"
+  return typeof effort === "string" ? effort.toLowerCase() : "default"
+}
+
+export function outputCap(effort: string, ...limits: readonly (number | undefined)[]): number {
+  const cap = effort === "max" ? outputCaps.max : effort === "xhigh" ? outputCaps.xhigh :
+    effort === "high" ? outputCaps.high : outputCaps.default
+  return Math.min(cap, ...limits.filter((x): x is number => typeof x === "number" && Number.isFinite(x) && x > 0).map(Math.floor))
+}
+
+// Raw HTTP body overlays are applied AFTER protocol lowering. Do not let an
+// existing native override bypass the cap; do not inject foreign provider keys.
+export function capBody<T>(body: T, cap: number): T {
+  const value = record(body)
+  const result = { ...value }
+  for (const key of ["max_tokens", "max_completion_tokens", "max_output_tokens", "max_new_tokens", "maxTokens", "maxOutputTokens"]) {
+    if (!(key in value)) continue
+    const current = value[key]
+    result[key] = typeof current === "number" && Number.isFinite(current) && current >= 1
+      ? Math.min(cap, Math.floor(current)) : cap
+  }
+  for (const key of ["generationConfig", "generation_config", "inferenceConfig", "inference_config"]) {
+    if (value[key] !== undefined) result[key] = capBody(value[key], cap)
+  }
+  return result as T
+}
+
+// Only local tool calls are held. Text/reasoning remain live, and provider-run
+// tools are outside this process's execution control. Never repair partial JSON.
+export class OutputGate {
+  private calls: LLMEvent[] = []
+  private terminal: LLMEvent[] = []
+  private finished = false
+  rejected: "length" | "invalid" | "incomplete" | undefined
+
+  push(event: LLMEvent): LLMEvent[] {
+    if (event.type === "tool-input-error" || event.type === "provider-error") this.rejected ??= "invalid"
+    if (event.type === "tool-call" && !event.providerExecuted) {
+      this.calls.push(event)
+      return []
+    }
+    if (event.type === "step-finish" || event.type === "finish") {
+      this.finished = true
+      if (event.reason.normalized === "length") this.rejected = "length"
+      else if (event.reason.normalized !== "stop" && event.reason.normalized !== "tool-calls") this.rejected ??= "invalid"
+      this.terminal.push(event)
+      return []
+    }
+    return [event]
+  }
+
+  end(): LLMEvent[] {
+    if (!this.finished) this.rejected ??= "incomplete"
+    const events = this.rejected ? this.terminal : [...this.calls, ...this.terminal]
+    this.calls = []
+    this.terminal = []
+    return events
+  }
+}
diff --git a/packages/core/src/personalize/output-request.ts b/packages/core/src/personalize/output-request.ts
new file mode 100644
index 0000000000000000000000000000000000000000..86b93bbdd95ad0c6c99982d74320f6d728ac14e1
--- /dev/null
+++ b/packages/core/src/personalize/output-request.ts
@@ -0,0 +1,41 @@
+import type { LLMRequest } from "@opencode/ai/effect"
+import type { Resolved } from "../model-resolver"
+import { capBody, outputCap, outputEffort } from "./output-policy"
+
+const isRecord = (value: unknown): value is Record<string, unknown> =>
+  typeof value === "object" && value !== null && !Array.isArray(value)
+
+// Same layering the LLM client applies before lowering (route/client.ts
+// resolveRequestOptions): model.options sit under the request, later wins,
+// records merge by key. The ai package does not export its merge helpers.
+function merge(...items: unknown[]): Record<string, unknown> | undefined {
+  const result: Record<string, unknown> = {}
+  for (const item of items) {
+    if (!isRecord(item)) continue
+    for (const [key, value] of Object.entries(item)) {
+      if (value === undefined) continue
+      result[key] = isRecord(result[key]) && isRecord(value) ? merge(result[key], value) : value
+    }
+  }
+  return Object.keys(result).length === 0 ? undefined : result
+}
+
+// Shared by primary turns, subagents using the same runner, titles and
+// compaction. This sets the request's maxTokens, not only catalog metadata.
+export function capRequest(request: LLMRequest, model: Resolved, inputTokens?: number): LLMRequest {
+  const options = request.model.options
+  const providerOptions = merge(options?.providerOptions, request.providerOptions)
+  const body = merge(options?.http?.body, request.http?.body)
+  const effort = outputEffort(body, outputEffort(providerOptions, model.ref.variant))
+  const context = model.limit.context
+  const room = context > 0 ? Math.max(1, context - (inputTokens ?? 0) - 1024) : undefined
+  const requested = request.maxTokens ?? options?.maxTokens
+  const maxTokens = outputCap(effort, requested, model.limit.output, room)
+  return {
+    ...request,
+    // Only lower a limit the request already carries. Stock deliberately omits
+    // it for some routes (the ChatGPT/Codex backend rejects any output limit).
+    ...(requested === undefined ? {} : { maxTokens }),
+    ...(body ? { http: { ...request.http, body: capBody(body, maxTokens) } } : {}),
+  }
+}
diff --git a/packages/core/src/personalize/persona.ts b/packages/core/src/personalize/persona.ts
