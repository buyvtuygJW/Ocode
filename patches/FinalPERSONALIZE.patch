new file mode 100644
index 0000000000000000000000000000000000000000..52ee782d3f3e92fb295e375eef38b241448b07e4
--- /dev/null
+++ b/packages/schema/src/personalize/permission-contract.ts
@@ -0,0 +1,55 @@
+import { Schema } from "effect"
+import { optional } from "../schema.js"
+
+/** Owned reply vocabulary. Request facts use stock metadata, not extra wire fields. */
+// Keep implementation shapes inline in the wire Reply schema. They remain
+// exported here for runtime/type reuse, without separate generated SDK models.
+export const Operation = Schema.Literals(["read", "create", "update", "delete"])
+export type Operation = typeof Operation.Type
+
+export const SessionPolicy = Schema.Struct({
+  scope: Schema.Literal("session"),
+  read: Schema.Literals(["allow", "ask", "deny"]),
+  create: Schema.Literals(["allow", "ask", "deny"]),
+  update: Schema.Literals(["allow", "ask", "deny"]),
+  delete: Schema.Literals(["allow", "ask", "deny"]),
+  /** Omitted means all four operations apply recursively to the displayed subtree. */
+  recursive: Schema.Array(Operation).pipe(optional),
+})
+export interface SessionPolicy extends Schema.Schema.Type<typeof SessionPolicy> {}
+
+export const CompactPolicy = Schema.Struct({
+  scope: Schema.Literal("session"),
+  policy: Schema.String,
+})
+export interface CompactPolicy extends Schema.Schema.Type<typeof CompactPolicy> {}
+
+export const Selection = Schema.Struct({
+  operation: Operation,
+  effect: Schema.Literals(["allow", "deny", "ask"]),
+  lifetime: Schema.Literals(["once", "session"]),
+  recursive: Schema.Boolean,
+  scope: Schema.Literals(["selected", "parent-list"]),
+})
+export interface Selection extends Schema.Schema.Type<typeof Selection> {}
+
+export const StructuredPolicy = Schema.Struct({
+  scope: Schema.Literal("session"),
+  rules: Schema.Array(Selection),
+})
+export interface StructuredPolicy extends Schema.Schema.Type<typeof StructuredPolicy> {}
+
+export class InvalidPolicyError extends Schema.TaggedError<InvalidPolicyError>()(
+  "Permission.InvalidPolicyError",
+  { message: Schema.String },
+  { identifier: "PermissionInvalidPolicyError", httpApiStatus: 400 },
+) {}
+
+export const Reply = Schema.Union([
+  Schema.Literals([
+    "once", "always", "reject",
+    "session_read", "session_create", "session_update", "session_delete", "session_crud",
+  ]),
+  SessionPolicy, CompactPolicy, StructuredPolicy,
+]).annotate({ identifier: "Permission.Reply" })
+export type Reply = typeof Reply.Type
diff --git a/packages/schema/src/personalize/permission-controller.ts b/packages/schema/src/personalize/permission-controller.ts
new file mode 100644
index 0000000000000000000000000000000000000000..076266e09fd340fa03974217f693d4c860dac152
--- /dev/null
+++ b/packages/schema/src/personalize/permission-controller.ts
@@ -0,0 +1,134 @@
+import { choices, isPolicyReply, policyError, unknownShell, type Choice, type RequestLike } from "./permission-policy.js"
+
+/** Kept independent of the generated client, whose stock reply type lacks policy. */
+export type CompactPolicy = { readonly scope: "session"; readonly policy: string }
+export type PermissionDecision = "once" | "session_read" | "always" | "reject" | CompactPolicy
+export type PresenterRequest = RequestLike & { readonly id: string; readonly sessionID: string }
+export type PermissionReply = {
+  readonly sessionID: string
+  readonly requestID: string
+  readonly decision: PermissionDecision
+  readonly message?: string
+}
+export type PresenterStage = "permission" | "policy" | "always" | "reject"
+export type PresenterStatus = "idle" | "submitting" | "awaiting-event" | "resolved"
+export type PresenterState = {
+  readonly request: PresenterRequest
+  readonly stage: PresenterStage
+  readonly status: PresenterStatus
+  readonly message: string
+  readonly error?: string
+  readonly generation: number
+  readonly attempt: number
+}
+
+export type PresenterCallbacks = {
+  /** Must reject on backend errors; adapters for result-returning SDKs must unwrap them. */
+  readonly send: (reply: PermissionReply) => Promise<unknown> | unknown
+  readonly changed?: (state: PresenterState) => void
+  /** Receives the original backend error, in addition to state.error for inline display. */
+  readonly report?: (error: unknown) => void
+}
+
+const errorText = (error: unknown) => error instanceof Error ? error.message : String(error)
+
+/**
+ * One presenter instance owns one current request. Bind changed to the local store;
+ * call replaceRequest on request changes and resolved only for permission.replied.
+ * No successful HTTP response is itself treated as a permission.replied event.
+ */
+export function createPermissionController(request: PresenterRequest, callbacks: PresenterCallbacks) {
+  let state: PresenterState = {
+    request, stage: "permission", status: "idle", message: "", generation: 0, attempt: 0,
+  }
+  let disposed = false
+  const publish = (next: PresenterState) => {
+    state = next
+    callbacks.changed?.(state)
+  }
+  const active = (generation: number, attempt: number) =>
+    !disposed && state.generation === generation && state.attempt === attempt && state.status === "submitting"
+
+  function submit(decision: PermissionDecision, message?: string): boolean {
+    if (disposed || state.status !== "idle") return false
+    const option: Choice = typeof decision === "object" ? "policy" : decision
+    if (!choices(state.request).includes(option)) return false
+    if (typeof decision === "object") {
+      const error = policyError(decision.policy, unknownShell(state.request), state.request)
+      if (error !== undefined) {
+        publish({ ...state, error })
+        return false
+      }
+      decision = { scope: "session", policy: decision.policy.trim() }
+    }
+    const reply: PermissionReply = {
+      sessionID: state.request.sessionID,
+      requestID: state.request.id,
+      decision,
+      ...(message?.trim() ? { message: message.trim() } : {}),
+    }
+    const generation = state.generation
+    const attempt = state.attempt + 1
+    publish({ ...state, status: "submitting", error: undefined, attempt })
+    // A synchronous subscriber may have replaced or resolved the request.
+    if (!active(generation, attempt)) return false
+    const succeeded = () => {
+      if (!active(generation, attempt)) return
+      publish({
+        ...state,
+        status: isPolicyReply(decision) ? "idle" : "awaiting-event",
+        stage: "permission",
+        message: "",
+        error: undefined,
+      })
+    }
+    const failed = (error: unknown) => {
+      if (!active(generation, attempt)) return
+      publish({ ...state, status: "idle", error: errorText(error) })
+      // A subscriber may have changed the request during publication.
+      if (!disposed && state.generation === generation && state.attempt === attempt && state.status === "idle")
+        callbacks.report?.(error)
+    }
+    try {
+      Promise.resolve(callbacks.send(reply)).then(succeeded, failed)
+    } catch (error) {
+      failed(error)
+    }
+    return true
+  }
+
+  return {
+    getState: () => state,
+    choices: () => choices(state.request),
+    /** Replacing even the same ID starts a new generation and invalidates old completions. */
+    replaceRequest(next: PresenterRequest) {
+      if (disposed) return
+      publish({
+        request: next, stage: "permission", status: "idle", message: "",
+        generation: state.generation + 1, attempt: 0,
+      })
+    },
+    /** Route event stream notifications here, including those from another client. */
+    resolved(sessionID: string, requestID: string) {
+      if (disposed || state.request.sessionID !== sessionID || state.request.id !== requestID ||
+        state.status === "resolved") return
+      publish({ ...state, status: "resolved", error: undefined })
+    },
+    setMessage(message: string) {
+      if (disposed || state.status !== "idle") return
+      publish({ ...state, message, error: undefined })
+    },
+    open(stage: PresenterStage) {
+      if (disposed || state.status !== "idle") return
+      if (stage !== "permission" && !choices(state.request).includes(stage)) return
+      publish({ ...state, stage, message: "", error: undefined })
+    },
+    submit,
+    submitPolicy() {
+      return submit({ scope: "session", policy: state.message })
+    },
+    dispose() {
+      disposed = true
+    },
+  }
+}
diff --git a/packages/schema/src/personalize/permission-policy.ts b/packages/schema/src/personalize/permission-policy.ts
new file mode 100644
index 0000000000000000000000000000000000000000..12edc8501ac12f4197b1efb0272b3da43e3550aa
--- /dev/null
+++ b/packages/schema/src/personalize/permission-policy.ts
@@ -0,0 +1,202 @@
+import { parsePermissionShorthand, type FilesystemDecision } from "../permission-shorthand.js"
+import { singleExecutable, singleExecutableScope } from "./single-executable.js"
+
+/** Owned protocol data travels through stock Request.metadata, not new SDK fields. */
+export const metadataKey = "opencode.permission.v1"
+export type Operation = FilesystemDecision["operation"]
+export type Facts = {
+  readonly operations: readonly Operation[]
+  readonly paths: readonly string[]
+  readonly directories?: readonly string[]
+  readonly access?: "content" | "listing"
+  /** Absent means the server's local environment, never all machines. */
+  readonly machine?: string
+}
+export type RequestLike = {
+  readonly action: string
+  readonly message?: string
+  readonly metadata?: Readonly<Record<string, unknown>>
+  readonly resources: readonly string[]
+  readonly save?: readonly string[]
+  readonly operations?: readonly Operation[]
+  readonly paths?: readonly string[]
+  readonly directories?: readonly string[]
+  readonly access?: "content" | "listing"
+}
+
+const operations = new Set(["read", "create", "update", "delete"])
+const strings = (value: unknown): value is readonly string[] =>
+  Array.isArray(value) && value.every((item) => typeof item === "string" && item.length > 0)
+
+export function validateFacts(value: unknown): Facts {
+  if (!value || typeof value !== "object" || Array.isArray(value))
+    throw new Error("Invalid filesystem permission facts")
+  const facts = value as Record<string, unknown>
+  if (!strings(facts.operations) || facts.operations.length === 0 ||
+    facts.operations.some((operation) => !operations.has(operation)) ||
+    new Set(facts.operations).size !== facts.operations.length ||
+    !strings(facts.paths) || facts.paths.length === 0 ||
+    (facts.directories !== undefined && (!strings(facts.directories) || facts.directories.length === 0)) ||
+    (facts.access !== undefined && facts.access !== "content" && facts.access !== "listing") ||
+    (facts.machine !== undefined && (typeof facts.machine !== "string" || !facts.machine || /[\0\r\n]/.test(facts.machine))))
+    throw new Error("Invalid filesystem permission facts")
+  return {
+    operations: [...facts.operations] as Operation[],
+    paths: [...facts.paths],
+    ...(facts.directories === undefined ? {} : { directories: [...facts.directories as readonly string[]] }),
+    ...(facts.access === undefined ? {} : { access: facts.access as Facts["access"] }),
+    ...(facts.machine === undefined ? {} : { machine: facts.machine as string }),
+  }
+}
+
+/** No path or CRUD operation is inferred from a tool name, save glob, or search text. */
+export function readFacts(request: Pick<RequestLike, "metadata" | "operations" | "paths" | "directories" | "access">): Facts | undefined {
+  const hasOwned = request.metadata !== undefined && Object.hasOwn(request.metadata, metadataKey)
+  // Older external-directory callers can provide paths without classifying an
+  // operation (for example a shell). That is not a CRUD entitlement.
+  const hasLegacy = request.operations !== undefined
+  const owned = hasOwned ? validateFacts(request.metadata![metadataKey]) : undefined
+  const legacy = hasLegacy ? validateFacts(request) : undefined
+  // During migration, mixed old/new callers must agree; neither representation
+  // may silently widen or override the other.
+  if (owned && legacy && JSON.stringify(owned) !== JSON.stringify(legacy))
+    throw new Error("Conflicting filesystem permission facts")
+  return owned ?? legacy
+}
+
+export function withFacts<T extends { readonly metadata?: Readonly<Record<string, unknown>> }>(
+  request: T,
+  facts: Facts,
+): T & { readonly metadata: Readonly<Record<string, unknown>> } {
+  const value = validateFacts(facts)
+  const existing = request.metadata?.[metadataKey]
+  if (request.metadata && Object.hasOwn(request.metadata, metadataKey) &&
+    JSON.stringify(validateFacts(existing)) !== JSON.stringify(value))
+    throw new Error("Conflicting filesystem permission facts")
+  return { ...request, metadata: { ...request.metadata, [metadataKey]: value } }
+}
+
+export function unknownShell(request: Pick<RequestLike, "action" | "message" | "metadata">): boolean {
+  if (request.action !== "shell") return false
+  return request.metadata?.filesystemEffects === "unknown" || request.message?.startsWith("Unknown effects:") === true
+}
+
+/** Recompute from the full command; never trust an executable-name metadata hint. */
+export function unknownExecutable(request: Pick<RequestLike, "action" | "metadata">): string | undefined {
+  const metadata = request.metadata
+  if (request.action !== "shell" || metadata?.filesystemEffects !== "unknown" ||
+    typeof metadata.unknownCommand !== "string" || typeof metadata.unknownShell !== "string") return
+  return singleExecutable(metadata.unknownCommand, metadata.unknownShell)
+}
+
+export function unknownExecutableScope(request: Pick<RequestLike, "action" | "metadata">) {
+  const metadata = request.metadata
+  if (request.action !== "shell" || metadata?.filesystemEffects !== "unknown" ||
+    typeof metadata.unknownCommand !== "string" || typeof metadata.unknownShell !== "string" ||
+    typeof metadata.unknownCwd !== "string") return
+  return singleExecutableScope(metadata.unknownCommand, metadata.unknownShell, metadata.unknownCwd)
+}
+
+/** Shared by backend validation and every permission presenter. */
+export function parsePolicy(text: string, unknown: boolean):
+  | { readonly kind: "unknown"; readonly lifetime: "once" | "session"; readonly scope?: "executable" | "executable-all" }
+  | { readonly kind: "filesystem"; readonly rules: readonly FilesystemDecision[] } {
+  if (unknown && (!text.trim() || /^unknown(?:\s|=|$)/i.test(text.trim()))) {
+    const match = /^unknown=(1|s|se|sea)$/i.exec(text.trim())
+    if (!match) throw new Error("Use Unknown=1, Unknown=S, Unknown=SE, or Unknown=SEA; no wildcard.")
+    if (match[1].toLowerCase() === "se") return { kind: "unknown", lifetime: "session", scope: "executable" }
+    if (match[1].toLowerCase() === "sea") return { kind: "unknown", lifetime: "session", scope: "executable-all" }
+    return { kind: "unknown", lifetime: match[1].toLowerCase() === "s" ? "session" : "once" }
+  }
+  const parsed = parsePermissionShorthand(text)
+  if (parsed.mcp !== undefined)
+    throw new Error("MCP selection belongs to tool configuration, not a directory permission grant.")
+  if (parsed.filesystem.length === 0) throw new Error("Select at least one filesystem operation.")
+  return { kind: "filesystem", rules: parsed.filesystem }
+}
+
+export function policyError(text: string, unknown: boolean, request?: RequestLike): string | undefined {
+  try {
+    const parsed = parsePolicy(text, unknown)
+    if (parsed.kind === "unknown" && parsed.scope && request) {
+      if (!unknownExecutable(request)) throw new Error(executablePolicyError)
+      if (parsed.scope === "executable" && !unknownExecutableScope(request)) throw new Error(executableScopeError)
+    }
+    if (parsed.kind === "filesystem" && unknown && request) {
+      if (!unknownPolicyDirectory(request)) throw new Error("Shell CRUD settings require a displayed working directory.")
+      if (parsed.rules.some((rule) => rule.lifetime === "once"))
+        throw new Error("Shell CRUD settings require =S or =D; use Unknown=1 for one shell invocation.")
+    }
+  }
+  catch (error) { return error instanceof Error ? error.message : String(error) }
+}
+
+export const executablePolicyError = "Unknown=SE/SEA requires one command with a literal name or path; no dynamic command targets, command substitutions, pipes, or redirects."
+export const executableScopeError = "Unknown=SE requires literal arguments to keep their structure and directories fixed. Use Unknown=SEA to approve this command with variable arguments."
+
+/** Policy success is not proof that the original request was actually settled. */
+export function isPolicyReply(reply: unknown): boolean {
+  return (typeof reply === "object" && reply !== null) ||
+    (typeof reply === "string" && [
+      "session_read", "session_create", "session_update", "session_delete", "session_crud",
+    ].includes(reply))
+}
+
+export type Choice = "once" | "session_read" | "policy" | "always" | "reject"
+export const policyText = {
+  label: "Conversation filesystem policy",
+  placeholder: "RU=S* CD=D*",
+  unknownPlaceholder: "Unknown=1 / Unknown=S / Unknown=SE / Unknown=SEA",
+  apply: "Apply filesystem policy",
+} as const
+
+export function choices(request: RequestLike): readonly Choice[] {
+  if (unknownShell(request)) return ["once", "policy", "reject"]
+  const facts = readFacts(request)
+  const policy = facts !== undefined && (!!facts.directories?.length || request.action === "external_directory")
+  return [
+    "once",
+    ...(policy ? ["policy" as const] : []),
+    ...(policy && facts.operations.every((operation) => operation === "read") ? ["session_read" as const] : []),
+    ...(request.save?.length ? ["always" as const] : []),
+    "reject",
+  ]
+}
+
+export function choiceLabel(choice: Choice, unknown: boolean, stock: (choice: "once" | "always" | "reject") => string): string {
+  if (unknown) {
+    if (choice === "once") return "Allow one"
+    if (choice === "policy") return "CRUD policy"
+    if (choice === "reject") return "Deny"
+  }
+  if (choice === "session_read") return "only read recursive"
+  if (choice === "policy") return "Session CRUD policy…"
+  return stock(choice)
+}
+
+export function policyDirectories(request: RequestLike): readonly string[] {
+  // Presentation fallback only: the backend never derives a grant from save.
+  const facts = readFacts(request)
+  const shellDirectory = unknownPolicyDirectory(request)
+  if (shellDirectory) return [shellDirectory.machine ? `${shellDirectory.machine}:${shellDirectory.directory}` : shellDirectory.directory]
+  if (facts?.machine && facts.directories) return facts.directories.map((directory) => `${facts.machine}:${directory}`)
+  return facts?.directories ?? request.directories ??
+    request.resources.map((resource) => resource.replace(/\/\*$/, ""))
+}
+
+/** Shell CRUD edits configure a displayed directory; they do NOT approve shell execution. */
+export function unknownPolicyDirectory(request: Pick<RequestLike, "action" | "metadata">) {
+  const metadata = request.metadata
+  if (request.action !== "shell" || metadata?.filesystemEffects !== "unknown" ||
+    typeof metadata.unknownCwd !== "string" || !metadata.unknownCwd ||
+    (metadata.unknownMachine !== undefined && (typeof metadata.unknownMachine !== "string" ||
+      !metadata.unknownMachine || /[\0\r\n]/.test(metadata.unknownMachine)))) return
+  return { directory: metadata.unknownCwd, machine: metadata.unknownMachine as string | undefined }
+}
+
+export function policyHint(unknown: boolean, request?: RequestLike): string {
+  const executable = request && unknownExecutable(request)
+  return unknown
+    ? `RU=S* CD=D* edits the displayed directory's CRUD policy; shell execution still needs separate approval. Unknown=1 once · S exact command/session · SE fixed literal arguments · SEA any arguments including scalar variables${executable ? ` (${executable})` : ""} · names resolve in the shell · Unknown has no * · executable/code/child processes may bypass filesystem denies.`
+    : "RU=S* CD=D* · selected subtree + descendants · survives restart · =1 once · =S session · =D deny · * recursive · R=-S parent listing only. Omitted operations unchanged."
+}
diff --git a/packages/schema/src/personalize/single-executable.ts b/packages/schema/src/personalize/single-executable.ts
new file mode 100644
index 0000000000000000000000000000000000000000..1c413fc4f09a2ad2cff13d285a7331b30625170a
--- /dev/null
+++ b/packages/schema/src/personalize/single-executable.ts
@@ -0,0 +1,173 @@
+/**
+ * Identify a single PowerShell invocation by its literal command target.
+ * PATH names (git, node), script launchers and explicit paths are commands too;
+ * a filename extension neither proves nor disproves that a target is runnable.
+ * This is syntax classification, not binary resolution or a subprocess sandbox.
+ */
+export function singleExecutable(command: string, shell: string): string | undefined {
+  return parseCommand(command, shell)?.executable
+}
+
+function parseCommand(command: string, shell: string, expandArguments = true): { executable: string; arguments: string[] } | undefined {
+  const basename = shell.replaceAll("\\", "/").split("/").at(-1)?.toLowerCase()
+  if (!basename || !["powershell", "powershell.exe", "pwsh", "pwsh.exe"].includes(basename)) return undefined
+  // This intentionally rejects tabs as well as newlines and other controls.
+  if (/[\u0000-\u001f\u007f-\u009f]/u.test(command)) return undefined
+  // PowerShell also treats smart quotes as delimiters. An ASCII-only lexer must
+  // not mistake one for inert data inside a quoted argument.
+  if (/[\u2018-\u201f]/u.test(command)) return undefined
+  let index = 0
+  const spaces = () => { while (command[index] === " ") index++ }
+  spaces()
+  const call = command[index] === "&"
+  if (call) { index++; spaces() }
+
+  const variable = () => {
+    const match = /^\$(?:[a-z_][a-z0-9_]*(?::[a-z_][a-z0-9_]*)?|\{[a-z_][a-z0-9_]*(?::[a-z_][a-z0-9_]*)?\})/i.exec(command.slice(index))
+    if (!match) return undefined
+    index += match[0].length
+    return match[0]
+  }
+  const token = (expand = false): { value: string; quoted: boolean } | undefined => {
+    const first = command[index]
+    if (first === "'" || first === '"') {
+      index++
+      let value = ""
+      let closed = false
+      while (index < command.length) {
+        const char = command[index++]!
+        if (char === first) {
+          if (first === "'" && command[index] === "'") {
+            value += "'"
+            index++
+            continue
+          }
+          closed = true
+          break
+        }
+        if (first === '"' && char === "`") return undefined
+        if (first === '"' && char === "$") {
+          if (!expand) return undefined
+          index--
+          const name = variable()
+          if (!name) return undefined // In particular, never allow $(command).
+          value += name
+          continue
+        }
+        value += char
+      }
+      if (!closed || (index < command.length && command[index] !== " ")) return undefined
+      return { value, quoted: true }
+    }
+    const start = index
+    while (index < command.length && command[index] !== " ") {
+      if (expand && index === start && command[index] === "$") {
+        if (!variable()) return undefined
+        // A plain scalar/path argument, not member/index access or an expression.
+        if (index < command.length && ![" ", "/", "\\"].includes(command[index]!)) return undefined
+        continue
+      }
+      // No PowerShell metacharacters, quoting, escapes, variable/splat
+      // expansion, or wildcard syntax are permitted in a bare token.
+      if (!/^[\p{L}\p{N}_.:,/\\=+\-]$/u.test(command[index]!)) return undefined
+      index++
+    }
+    if (index === start) return undefined
+    return { value: command.slice(start, index), quoted: false }
+  }
+
+  const executable = token()
+  if (!executable || (executable.quoted && !call)) return undefined
+  const normalized = executable.value.replaceAll("/", "\\")
+  const absolute = /^[a-z]:\\/i.test(normalized)
+  const relative = normalized.startsWith(".\\")
+  const named = /^[\p{L}\p{N}_][\p{L}\p{N}_.-]*$/u.test(normalized)
+  if (!absolute && !relative && !named) return undefined
+  if (named && /^(?:begin|break|catch|class|continue|data|define|do|dynamicparam|else|elseif|end|enum|exit|filter|finally|for|foreach|from|function|if|in|inlinescript|parallel|param|process|return|sequence|switch|throw|trap|try|until|using|var|while|workflow)$/i.test(normalized)) return undefined
+  const segments = (absolute ? normalized.slice(3) : relative ? normalized.slice(2) : normalized).split("\\")
+  if (!segments.length || segments.some((segment) =>
+    !segment || segment === "." || segment === ".." || /[. ]$/.test(segment) ||
+    /[\u0000-\u001f\u007f-\u009f<>:"|?*\[\]{}()$`@#;&~]/u.test(segment) ||
+    /^(?:con|prn|aux|nul|com[1-9]|lpt[1-9])(?:\.|$)/i.test(segment))) return undefined
+
+  const args: string[] = []
+  while (index < command.length) {
+    if (command[index] !== " ") return undefined
+    spaces()
+    if (index === command.length) break
+    const argument = token(expandArguments)
+    if (!argument) return undefined
+    args.push(argument.value)
+  }
+  // Only drive letters are unconditionally case-insensitive. Windows can enable
+  // case-sensitive directories; different executable spellings must not alias.
+  // Do not merge PATH names with paths, or git with git.exe: resolution may
+  // differ. The policy key also binds cwd, shell, machine and lookup environment.
+  return { executable: absolute ? normalized[0]!.toLowerCase() + normalized.slice(1) : normalized, arguments: args }
+}
+
+// Only unambiguous Windows path components are eligible for directory scoping.
+// This is lexical classification, not a filesystem or subprocess sandbox.
+function pathParts(value: string): { absolute: boolean; parts: string[] } | undefined {
+  const path = value.replaceAll("/", "\\")
+  const absolute = /^[a-z]:\\/i.test(path)
+  if (!absolute && (path.startsWith("\\") || /^[a-z]:/i.test(path))) return undefined
+  const rest = absolute ? path.slice(3) : path
+  const parts = rest ? rest.split("\\") : []
+  if (parts.some((part) =>
+    !part || part === "." || part === ".." || /[. ]$/.test(part) ||
+    /[\u0000-\u001f\u007f-\u009f<>:"|?*\[\]{}()$`@#;&~=+]/u.test(part) ||
+    /^(?:con|prn|aux|nul|com[1-9]|lpt[1-9])(?:\.|$)/i.test(part))) return undefined
+  return { absolute, parts: absolute ? [path[0]!.toLowerCase() + ":", ...parts] : parts }
+}
+
+function pathParent(value: string, cwd?: string): string | undefined {
+  // Bare words are command names or ordinary values, not file operands.
+  if (!/[\\/]/.test(value) && !/^[^\\/]+\.[^\\/]+$/.test(value)) return undefined
+  if (!/[\\/]/.test(value) && /\s/u.test(value)) return undefined
+  const path = pathParts(value)
+  if (!path || !path.parts.length || (path.absolute && path.parts.length < 2)) return undefined
+  // An extensionless operand may name a directory/test root. Do not turn
+  // D:/work/test into an approval for D:/work/src merely because both have
+  // D:/work as their parent. Explicit/ambiguous directory operands stay exact.
+  if (!/^[^.].*\.[^.\s]+$/u.test(path.parts.at(-1)!)) return undefined
+  if (path.absolute) return path.parts.slice(0, -1).join("\\")
+  if (!cwd) return undefined
+  const base = pathParts(cwd.replace(/[\\/]+$/u, (suffix) => /^[a-z]:$/i.test(cwd.slice(0, -suffix.length)) ? "\\" : ""))
+  if (!base?.absolute) return undefined
+  return [...base.parts, ...path.parts.slice(0, -1)].join("\\")
+}
+
+/**
+ * Classify the parsed argv conservatively. Path-like operands can vary only in
+ * basename within the same lexical parent; all other arguments remain exact.
+ */
+export function singleExecutableScope(
+  command: string,
+  shell: string,
+  cwd?: string,
+): { executable: string; arguments: readonly string[]; modeKey: string } | undefined {
+  // SE promises fixed argument structure/parents. An unresolved variable cannot
+  // establish either; SEA explicitly opts into arbitrary executable arguments.
+  const parsed = parseCommand(command, shell, false)
+  if (!parsed) return undefined
+  const shape: string[][] = []
+  for (const argument of parsed.arguments) {
+    const option = /^(--?[a-zA-Z][a-zA-Z0-9-]*=)(.*)$/u.exec(argument)
+    // Other options, including unfamiliar equals forms, must remain exact.
+    if (argument.startsWith("-") && !option) {
+      shape.push(["literal", argument])
+      continue
+    }
+    const value = option ? option[2]! : argument
+    const parent = pathParent(value, cwd)
+    const entry = parent === undefined ? ["literal", argument] : ["path", option?.[1] ?? "", parent]
+    const previous = shape.at(-1)
+    // A positional file list can grow or shrink within the same parent. Never
+    // collapse repeated options or move operands across a command/option boundary.
+    if (entry[0] === "path" && entry[1] === "" &&
+      previous?.[0] === "path" && previous[1] === "" && previous[2] === entry[2]) continue
+    shape.push(entry)
+  }
+  return { ...parsed, modeKey: JSON.stringify(shape) }
+}
