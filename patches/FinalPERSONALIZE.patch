+import path from "node:path"
+import { Global } from "@opencode/util/global"
+import { Effect } from "effect"
+import { Skill } from "../skill"
+import { AbsolutePath } from "../schema"
+import template from "../plugin/skill/playwright-depth.md" with { type: "text" }
+
+export const PlaywrightDepthCachePath = path.join(Global.Path.state, "playwright-depth-cache.json")
+export const PlaywrightDepthContent = template.replaceAll("{{CACHE_PATH}}", PlaywrightDepthCachePath)
+const description = "Use when taking Playwright or browser MCP snapshots: picks snapshot depth from per-site memory instead of defaulting to full depth."
+
+export function decorate(stock: typeof import("../plugin/skill")) {
+  return { Plugin: { ...stock.Plugin, effect: Effect.fn(function* (ctx: Parameters<typeof stock.Plugin.effect>[0]) {
+    yield* stock.Plugin.effect(ctx)
+    yield* ctx.skill.transform((editor) => editor.add(Skill.Info.make({
+      id: Skill.ID.make("playwright-depth"), name: Skill.Name.make("Playwright Depth"), description,
+      path: AbsolutePath.make("/builtin/playwright-depth.md"), content: PlaywrightDepthContent,
+    })))
+  }) } }
+}
diff --git a/packages/core/src/personalize/step.ts b/packages/core/src/personalize/step.ts
new file mode 100644
index 0000000000000000000000000000000000000000..605856751a9f7c546732ecb7f51dbcf21c76f41e
--- /dev/null
+++ b/packages/core/src/personalize/step.ts
@@ -0,0 +1,39 @@
+import { LLMClient } from "@opencode/ai/effect"
+import { Context, Effect, Stream } from "effect"
+import { StepFailedError } from "../session/error"
+import { OutputGate } from "./output-policy"
+
+export function decorate(stock: typeof import("../session/runner/step")) {
+  const make: typeof stock.make = Effect.gen(function* () {
+    const context = yield* Effect.context<Effect.Services<typeof stock.make>>()
+    const client = Context.get(context, LLMClient.Service)
+    const attempt: Effect.Success<typeof stock.make>["attempt"] = (input) => Effect.gen(function* () {
+      // State belongs to this attempt, never to a shared session/global client.
+      let rejected: OutputGate["rejected"]
+      const stream: typeof client.stream = (...args) => Stream.suspend(() => {
+        const gate = new OutputGate()
+        return client.stream(...args).pipe(
+          Stream.flatMap((event) => Stream.fromArray(gate.push(event))),
+          Stream.concat(Stream.suspend(() => {
+            const events = gate.end()
+            rejected = gate.rejected
+            return Stream.fromArray(events)
+          })),
+        )
+      })
+      const service = yield* stock.make.pipe(Effect.provide(Context.add(context, LLMClient.Service, { ...client, stream })))
+      const outcome = yield* service.attempt(input)
+      if (rejected || outcome._tag === "OutputLimit") return yield* new StepFailedError({
+        error: {
+          type: rejected === "invalid" ? "invalid-response" : "output-limit",
+          message: rejected === "invalid"
+            ? "Invalid model response: local tool calls were withheld. No automatic retry."
+            : "Model response was truncated or incomplete: local tool calls were withheld. No automatic continuation; request a smaller output or explicitly change effort.",
+        },
+      })
+      return outcome
+    })
+    return { attempt }
+  })
+  return { make }
+}
diff --git a/packages/core/src/personalize/to-llm-message.ts b/packages/core/src/personalize/to-llm-message.ts
new file mode 100644
index 0000000000000000000000000000000000000000..140ecb2100310bb0fa0b49debcd6f0d661cfd49b
--- /dev/null
+++ b/packages/core/src/personalize/to-llm-message.ts
@@ -0,0 +1,16 @@
+import { Message } from "@opencode/ai/effect"
+import { decay, indexBlock } from "../session/runner/context-decay"
+import { historyMessages } from "./content"
+import { bypassDecay } from "./decay-policy"
+
+export function decorate(stock: typeof import("../session/runner/to-llm-message")) {
+  const toLLMMessages: typeof stock.toLLMMessages = (messages, ...rest) => {
+    const history = historyMessages(messages)
+    if (bypassDecay()) return stock.toLLMMessages(history, ...rest)
+    const decayed = decay(history)
+    const lowered = stock.toLLMMessages(decayed.messages, ...rest)
+    const index = indexBlock(decayed.archive)
+    return index === undefined ? lowered : [...lowered, Message.user(index)]
+  }
+  return { toLLMMessages }
+}
diff --git a/packages/core/src/personalize/v1-migration.ts b/packages/core/src/personalize/v1-migration.ts
new file mode 100644
index 0000000000000000000000000000000000000000..d70d2b83f21a2e17995877a118baefbe8ba44248
--- /dev/null
+++ b/packages/core/src/personalize/v1-migration.ts
@@ -0,0 +1,33 @@
+import { Effect, Layer } from "effect"
+import { sql } from "drizzle-orm"
+import { Database } from "../database/database"
+import { Project } from "@opencode/schema/project"
+
+export function decorate(stock: typeof import("../database/v1-migration.bun")) {
+  const run: typeof stock.run = (options) => Effect.gen(function* () {
+    const result = yield* stock.run(options)
+    const db = (yield* Database.Service).db
+    yield* db.transaction((tx) => tx.run(sql`
+      UPDATE session_v2 SET
+        project_id = (SELECT w.project_id FROM worktree w
+          WHERE session_v2.directory = w.directory
+             OR substr(session_v2.directory, 1, length(w.directory) + 1) = w.directory || '/'
+          ORDER BY length(w.directory) DESC LIMIT 1),
+        path = (SELECT ltrim(substr(session_v2.directory, length(w.directory) + 1), '/') FROM worktree w
+          WHERE session_v2.directory = w.directory
+             OR substr(session_v2.directory, 1, length(w.directory) + 1) = w.directory || '/'
+          ORDER BY length(w.directory) DESC LIMIT 1)
+      WHERE project_id = ${Project.ID.global} AND workspace_id IS NULL AND EXISTS (
+        SELECT 1 FROM worktree w WHERE session_v2.directory = w.directory
+          OR substr(session_v2.directory, 1, length(w.directory) + 1) = w.directory || '/')
+    `)).pipe(Effect.orDie)
+    return result
+  })
+  // Keep upstream's progress/status layer. Its migration lock makes the second
+  // call idempotent; this tail always performs adoption, including already-imported V1 data.
+  const layer = Layer.merge(stock.layer, Layer.effectDiscard(run().pipe(
+    Effect.catchCause((cause) => Effect.logError("Personalize V1 adoption failed", { cause })),
+    Effect.forkScoped({ startImmediately: true }),
+  )))
+  return { run, layer }
+}
diff --git a/packages/core/src/plugin/skill/playwright-depth.md b/packages/core/src/plugin/skill/playwright-depth.md
new file mode 100644
index 0000000000000000000000000000000000000000..379dc1864c068da95e7ab8b24f47936901696349
--- /dev/null
+++ b/packages/core/src/plugin/skill/playwright-depth.md
@@ -0,0 +1,60 @@
+# Playwright snapshot depth
+
+A full-depth `browser_snapshot` on a busy page is the most expensive single call in a
+browser session. Depth-limit it, and remember the depth that worked per site so the
+second visit is cheap.
+
+## Observed cost (one busy docs page)
+
+| call | tokens |
+|---|---|
+| `browser_navigate` | ~80 — returns a snapshot **file link**, not the tree |
+| `browser_snapshot` full depth | **~8,676** — worst case |
+| `browser_snapshot` depth=3 | ~600 — 14x cheaper |
+| `browser_take_screenshot` | ~969, inline PNG — quiet, looks harmless, is not |
+| `browser_network_requests` / `browser_console_messages` | 10–20 — bulk suppressed |
+
+Full depth costs roughly **14x** depth=3. One careless snapshot is worth fourteen
+careful ones. Treat these as the right order of magnitude, not a guarantee.
+
+## Memory file
+
+`{{CACHE_PATH}}`
+
+```json
+{ "example.com": { "depth": 3, "anchor": "main", "hits": 2, "updated": "2026-10-04" } }
+```
+
+Keyed by hostname only — no scheme, no path. `anchor` records the container the useful
+content sat under, so the next visit can go straight there. Create the file with `{}`
+if it does not exist.
+
+## Protocol
+
+1. **Before** the first snapshot of a hostname, read the memory file.
+2. **Hit** → snapshot at the stored depth. State the five-word hint, verbatim:
+   `cached depth=N, escalate if missing`
+3. **Miss** → start at `depth=3`. Never open above 3 on a first visit.
+   Hint: `no cache, starting depth=3`
+4. **Escalate only on failure**, one step at a time: 3 → 5 → full. "Failure" means the
+   node you actually need is absent — not that the tree merely looks small.
+5. **Write back** the depth that worked, incrementing `hits`. A site that genuinely
+   needed full depth is worth recording too: that is a real finding, not a failure.
+6. Prefer the file link `browser_navigate` already returned over re-snapshotting.
+   Prefer `browser_console_messages` / `browser_network_requests` over a screenshot
+   when you only need to know *state*.
+
+## Do not
+
+- **Do not truncate, cap, or post-process snapshot output.** Depth is the only lever
+  here. A capped snapshot silently drops the node you were looking for and costs a
+  retry, which is worse than the tokens it saved.
+- Do not write a cache entry for a site you have not actually snapshotted. An invented
+  depth is worse than no entry, because the next run will trust it.
+- Do not escalate straight from 3 to full. The 5 step resolves most misses.
+
+## If `depth` is rejected
+
+Tool names and parameters follow `@playwright/mcp`. If your server's `browser_snapshot`
+exposes no `depth` parameter, narrow by `ref`/selector to the subtree you need instead
+and record that selector as `anchor` — the memory protocol above is unchanged.
diff --git a/packages/core/src/session/runner/context-decay.ts b/packages/core/src/session/runner/context-decay.ts
new file mode 100644
index 0000000000000000000000000000000000000000..8ee7e1d3f857ef4b3dc2c28f19a734c65f7398a6
--- /dev/null
+++ b/packages/core/src/session/runner/context-decay.ts
@@ -0,0 +1,370 @@
+import { SessionMessage } from "../message.js"
+
+/**
+ * Conservative, relevance-segmented duplicate decay. Task budgets decide when
+ * duplicate text may refer to an earlier retained result in the same request.
+ * They are not hard context limits: unique evidence is never discarded without
+ * a verified recovery mechanism.
+ *
+ * Unique tool output is preserved. Message text never decays; it is the reasoning thread, it is cheap, and losing it is what
+ * makes agents repeat themselves.
+ */
+
+// ---------------------------------------------------------------------------------------------------- tunables
+
+/** Tool-output budget for the task we are on now. */
+export const BUDGET_LIVE_TASK = 20_000
+/** Shared pot for the task immediately before this one, in case we bounce back. */
+export const BUDGET_PRIOR_TASK = 2_000
+/** Turns compared either side of a candidate boundary. */
+export const TASK_WINDOW = 3
+/** Drift at or above which a new task provably began. */
+export const TASK_DRIFT_THRESHOLD = 0.6
+/** Share of drift owed to file paths; the remainder is vocabulary. */
+export const PATH_WEIGHT = 0.6
+/** Turns after which eligible duplicates may enter the index block. */
+export const ARCHIVE_AFTER_TURNS = 20
+/** Legacy tuning constants retained for callers. */
+export const STUB_HEAD_CHARS = 400
+export const STUB_TAIL_CHARS = 200
+/** Consecutive tool calls with no reasoning between them that force a label. */
+export const CHAIN_NARRATION_FLOOR = 5
+/**
+ * Re-evaluation quantum. Every drifting input is rounded down to a multiple of this, so the decision can only change
+ * every N turns (or on a provable task switch). Without it the archive frontier advances one turn at a time, every turn
+ * rewrites a different slice of the prefix, and the prompt cache misses forever - paying more than doing nothing at all.
+ */
+export const REEVAL_QUANTUM = 10
+
+/**
+ * Floor on what a replacement must actually free. The elision note alone runs ~115 chars and the archive path costs a
+ * marker plus a line in the index block, so a short tool output "collapses" into something *larger* than it was. Same
+ * reasoning as REEVAL_QUANTUM: under this margin, acting rewrites the cached prefix to make the request bigger, and
+ * doing nothing is strictly cheaper. Below it the body is left verbatim.
+ */
+export const MIN_DECAY_SAVING = 200
+
+/** Rough token estimate. Deliberately cheap - this gates trimming, not billing. */
+const tokens = (text: string) => Math.ceil(text.length / 4)
+
+/** Whether swapping `body` for `replacement` (plus any per-entry overhead it adds elsewhere) frees enough to be worth it. */
+const worthwhile = (body: string, replacement: string, overhead = 0) =>
+  body.length - replacement.length - overhead >= MIN_DECAY_SAVING
+
+// ------------------------------------------------------------------------------------------------- path probes
+
+const ABSOLUTE = /^(?:[A-Za-z]:[\\/]|\/)[^\s]*$/
+
+/** Pull absolute filesystem paths out of arbitrary tool input JSON. */
+export const absolutePaths = (input: unknown, found: string[] = []): string[] => {
+  if (typeof input === "string") {
+    if (ABSOLUTE.test(input)) found.push(input.replaceAll("\\", "/"))
+    return found
+  }
+  if (Array.isArray(input)) {
+    for (const item of input) absolutePaths(item, found)
+    return found
+  }
+  if (input && typeof input === "object") {
+    for (const value of Object.values(input)) absolutePaths(value, found)
+  }
+  return found
+}
+
+const segments = (path: string) => path.split("/").filter(Boolean)
+
+/**
+ * Depth of the deepest shared ancestor. Two paths on the same drive but in unrelated trees (`D:/tmp/a` vs
+ * `D:/Prog/Actdev/...`) share only the drive, which is depth 1 - a provable project boundary with no filesystem access.
+ */
+export const commonAncestorDepth = (left: string, right: string) => {
+  const a = segments(left)
+  const b = segments(right)
+  let depth = 0
+  while (depth < a.length && depth < b.length && a[depth]!.toLowerCase() === b[depth]!.toLowerCase()) depth++
+  return depth
+}
+
+/** Paths are in the same project when they agree beyond the drive/filesystem root. */
+const sameProject = (left: readonly string[], right: readonly string[]) => {
+  if (left.length === 0 || right.length === 0) return true // no evidence is not evidence of change
+  return left.some((l) => right.some((r) => commonAncestorDepth(l, r) > 1))
+}
+
+// ----------------------------------------------------------------------------------------------------- keywords
+
+const WORD = /[a-z][a-z0-9_]{2,}/g
+
+/** Filler that survives every topic switch and would mask real drift. */
+const STOPWORD = new Set(
+  `the and for you this that with not are was but have has from then than into out off now just like what why how when
+   where which who will can should would could does done need want file files code line lines run running use used
+   using add added fix fixed make made get got look looks next also only same still very much more most here there`
+    .split(/\s+/)
+    .filter(Boolean),
+)
+
+/** Content words of a turn. Short words and filler carry no topic signal. */
+export const keywords = (text: string): ReadonlySet<string> =>
+  new Set((text.match(WORD) ?? []).filter((word) => word.length >= 4 && !STOPWORD.has(word)))
+
+// -------------------------------------------------------------------------------------------------------- turns
+
+interface Turn {
+  readonly message: SessionMessage.Info
+  readonly tools: readonly SessionMessage.AssistantTool[]
+  readonly paths: readonly string[]
+  readonly text: string
+  readonly words: ReadonlySet<string>
+}
+
+// Info is a tagged union: only `assistant` is declared with a content array, but in-flight records and
+// tool `error` states carry no/optional `content` — treat "no array" as "no content", never throw.
+const contentOf = (message: SessionMessage.Info) =>
+  "content" in message && Array.isArray(message.content) ? message.content : []
+
+const toolsOf = (message: SessionMessage.Info): SessionMessage.AssistantTool[] => {
+  if (message.type !== "assistant") return []
+  return contentOf(message).filter((item): item is SessionMessage.AssistantTool => item.type === "tool")
+}
+
+// user/synthetic/system/etc. carry a plain `text`; everything else reads through the guarded content array.
+const textOf = (message: SessionMessage.Info): string => {
+  if ("text" in message && typeof message.text === "string") return message.text.toLowerCase()
+  return contentOf(message)
+    .map((item) => ("text" in item && typeof item.text === "string" ? item.text : ""))
+    .join(" ")
+    .toLowerCase()
+}
+
+const toTurn = (message: SessionMessage.Info): Turn => {
+  const tools = toolsOf(message)
+  const text = textOf(message)
+  // `streaming` holds the raw unparsed input string; every settled state holds the parsed input record.
+  const paths = tools.flatMap((tool) => absolutePaths(tool.state.status === "streaming" ? {} : tool.state.input))
+  return { message, tools, paths, text, words: keywords(text) }
+}
+
+// ------------------------------------------------------------------------------------------------ task boundaries
+
+interface Window {
+  readonly paths: readonly string[]
+  readonly pathSet: ReadonlySet<string>
+  readonly words: ReadonlySet<string>
+}
+
+const windowOf = (turns: readonly Turn[]): Window => {
+  const paths = turns.flatMap((turn) => [...turn.paths])
+  return { paths, pathSet: new Set(paths), words: new Set(turns.flatMap((turn) => [...turn.words])) }
+}
+
+/** 1 - overlap coefficient. Zero when either side offers no evidence. */
+const overlapDrift = (left: ReadonlySet<string>, right: ReadonlySet<string>) => {
+  if (left.size === 0 || right.size === 0) return 0
+  const shared = [...right].filter((item) => left.has(item)).length
+  return 1 - shared / Math.min(left.size, right.size)
+}
+
+/**
+ * How far the work moved between two windows: 0 same task, 1 unrelated. Progressive on purpose - a repo change is a hard
+ * 1 and needs no judgement, everything else is a blend of which files are touched and which words are used, so moving
+ * from auth work to log trimming *inside one repo* scores high without anyone maintaining a list of magic keywords.
+ */
+export const drift = (prior: Window, live: Window): number => {
+  if (!sameProject(prior.paths, live.paths)) return 1
+  const paths = overlapDrift(prior.pathSet, live.pathSet)
+  const words = overlapDrift(prior.words, live.words)
+  return paths * PATH_WEIGHT + words * (1 - PATH_WEIGHT)
+}
+
+/**
+ * Indices where a new task provably began, oldest first. A boundary needs a full window on both sides, so the newest
+ * turns cannot mint one until the evidence exists - which is also what stops the newest turn from re-cutting the prefix
+ * and missing the prompt cache every turn.
+ */
+export const taskBoundaries = (turns: readonly Turn[]): readonly number[] => {
+  const marks: number[] = []
+  for (let index = TASK_WINDOW; index + TASK_WINDOW <= turns.length; index++) {
+    const last = marks[marks.length - 1]
+    if (last !== undefined && index - last < TASK_WINDOW) continue
+    if (drift(windowOf(turns.slice(index - TASK_WINDOW, index)), windowOf(turns.slice(index, index + TASK_WINDOW))) >= TASK_DRIFT_THRESHOLD)
+      marks.push(index)
+  }
+  return marks
+}
+
+/** 0 for the task we are on, 1 for the one before it, and so on back. */
+export const taskRank = (index: number, marks: readonly number[]) => marks.filter((mark) => mark > index).length
+
+/**
+ * Budget as a function of rank. Unique output is always preserved even when this budget is exceeded.
+ */
+export const taskBudget = (rank: number) => {
+  if (rank === 0) return BUDGET_LIVE_TASK
+  if (rank === 1) return BUDGET_PRIOR_TASK
+  return 0
+}
+
+/**
+ * Tools inside an unnarrated chain: CHAIN_NARRATION_FLOOR or more consecutive calls with no reasoning text between
+ * them. Everywhere else the surrounding chat already says what the call did, so the archive carries a bare ref and pays
+ * ~10 tokens instead of a redundant label.
+ */
+export const unnarrated = (turns: readonly Turn[]): ReadonlySet<string> => {
+  const marked = new Set<string>()
+  let run: string[] = []
+  const flush = () => {
+    if (run.length >= CHAIN_NARRATION_FLOOR) for (const id of run) marked.add(id)
+    run = []
+  }
+  for (const turn of turns) {
+    if (turn.text.trim().length > 0) flush()
+    for (const tool of turn.tools) run.push(tool.id)
+  }
+  flush()
+  return marked
+}
+
+/**
+ * Task and archive boundaries. Equal keys do not imply equal inputs: tool results may stream or be edited.
+ */
+export interface ContextKey {
+  /** Count of provable task boundaries seen. Monotonic. */
+  readonly segment: number
+  /** Archive frontier, quantized so it steps rather than slides. */
+  readonly frontier: number
+  /** First turn of the live task. */
+  readonly live: number
+}
+
+const quantize = (value: number) => Math.max(0, Math.floor(value / REEVAL_QUANTUM) * REEVAL_QUANTUM)
+
+export const contextKey = (turns: readonly Turn[]): ContextKey => {
+  const marks = taskBoundaries(turns)
+  return { segment: marks.length, frontier: quantize(turns.length - ARCHIVE_AFTER_TURNS), live: marks[marks.length - 1] ?? 0 }
+}
+
+export const sameKey = (left: ContextKey | undefined, right: ContextKey) =>
+  left !== undefined && left.segment === right.segment && left.frontier === right.frontier && left.live === right.live
+
+// -------------------------------------------------------------------------------------------------------- decay
+
+const contentText = (tool: SessionMessage.AssistantTool) => {
+  if (tool.state.status !== "completed" && tool.state.status !== "error") return ""
+  // ToolStateError.content is optional in the V2 schema — error states may carry no content (see compaction.ts, which guards the same way)
+  return (tool.state.content ?? [])
+    .map((part) => ("text" in part && typeof part.text === "string" ? part.text : ""))
+    .join("\n")
+}
+
+/**
+ * Duplicate text refers to an earlier retained result. Content is never emptied:
+ * an empty result trips provider-side tool_call/tool_result pairing checks.
+ */
+const markerText = (ref: string) => `[Duplicate tool output; identical text is retained in earlier tool result ${JSON.stringify(ref)}.]`
+
+const archivedMarker = (tool: SessionMessage.AssistantTool, ref: string): SessionMessage.AssistantTool => {
+  if (tool.state.status !== "completed" && tool.state.status !== "error") return tool
+  return { ...tool, state: { ...tool.state, content: [{ type: "text", text: markerText(ref) }] } } as SessionMessage.AssistantTool
+}
+
+export interface ArchiveEntry {
+  readonly id: string
+  readonly ref: string
+  /** Carried only for unnarrated chains; elsewhere the chat is the label. */
+  readonly name?: string
+  readonly chars?: number
+}
+
+/** One entry's line in the index block. Shared with `indexBlock` so the cost model cannot drift from what is emitted. */
+const indexLine = (entry: ArchiveEntry) =>
+  entry.name ? `  ${entry.ref} — ${entry.name}, ${entry.chars} chars` : `  ${entry.ref}`
+
+export interface DecayResult {
+  readonly messages: readonly SessionMessage.Info[]
+  readonly archive: readonly ArchiveEntry[]
+  readonly key: ContextKey
+  /** True when at least one duplicate was replaced. */
+  readonly rewritten: boolean
+}
+
+/**
+ * Decay a projected history immediately before it is lowered to provider messages. Pure and synchronous: no filesystem,
+ * no git, no Effect, so it can sit inside `toLLMMessages` without changing its signature.
+ */
+export const decay = (messages: readonly SessionMessage.Info[], _previous?: ContextKey): DecayResult => {
+  const turns = messages.map(toTurn)
+  const key = contextKey(turns)
+
+  const marks = taskBoundaries(turns)
+  const labelled = unnarrated(turns)
+  const archiveBefore = key.frontier
+  const archive: ArchiveEntry[] = []
+
+  // Oldest-first keeps the lowered prefix stable when results are appended.
+  // It favors older results over fresher ones until a task/frontier boundary.
+  // Only identical single-text results can be replaced: their full text is
+  // retained in an earlier result in this very request, without filesystem access.
+  const verdict = new Map<string, SessionMessage.AssistantTool>()
+  const spent = new Map<number, number>()
+  const retained = new Map<string, string>()
+  const counts = new Map<string, number>()
+  for (const turn of turns) for (const tool of turn.tools) counts.set(tool.id, (counts.get(tool.id) ?? 0) + 1)
+
+  for (let index = 0; index < turns.length; index++) {
+    const turn = turns[index]!
+    const rank = taskRank(index, marks)
+    const allowance = taskBudget(rank)
+    const archived = index < archiveBefore
+
+    for (const tool of turn.tools) {
+      const body = contentText(tool)
+      if (body.length === 0) continue
+
+      const cost = tokens(body)
+      const used = spent.get(rank) ?? 0
+      const content = tool.state.status === "completed" || tool.state.status === "error" ? tool.state.content : undefined
+      // Stock lowering can drop calls from failed assistant messages and error
+      // calls without time.ran. Only completed calls in unfailed messages are
+      // guaranteed to survive lowering as a source for a later duplicate.
+      const eligible = turn.message.type === "assistant" && turn.message.error === undefined &&
+        tool.state.status === "completed" && content?.length === 1 && content[0]?.type === "text" && counts.get(tool.id) === 1
+      const ref = eligible ? retained.get(body) : undefined
+      if (ref !== undefined && (archived || used + cost > allowance)) {
+        const entry: ArchiveEntry = labelled.has(tool.id) ? { id: tool.id, ref, name: tool.name, chars: body.length } : { id: tool.id, ref }
+        if (worthwhile(body, markerText(ref), indexLine(entry).length + 1)) {
+          archive.push(entry)
+          verdict.set(tool.id, archivedMarker(tool, ref))
+          continue
+        }
+      }
+      spent.set(rank, used + cost)
+      if (eligible && !retained.has(body)) retained.set(body, tool.id)
+    }
+  }
+
+  const next = messages.map((message) => {
+    if (message.type !== "assistant") return message
+    const items = Array.isArray(message.content) ? message.content : []
+    if (!items.some((item) => item.type === "tool" && verdict.has(item.id))) return message
+    const content = items.map((item) => (item.type === "tool" && verdict.has(item.id) ? verdict.get(item.id)! : item))
+    return { ...message, content } as SessionMessage.Info
+  })
+
+  return { messages: verdict.size ? next : messages, archive, key, rewritten: verdict.size > 0 }
+}
+
+/**
+ * Single consolidated block standing in for everything archived. Bare refs: the chat above each call already says what
+ * it was for, and a label per entry would cost more than the entries it describes.
+ */
+export const indexBlock = (archive: readonly ArchiveEntry[]) => {
+  if (archive.length === 0) return undefined
+  const lines = archive.map(indexLine)
+  return [
+    `<archived-tool-output count="${archive.length}">`,
+    "Duplicate text is retained in the earlier tool results listed below; no automatic retrieval is performed.",
+    ...lines,
+    "</archived-tool-output>",
+  ].join("\n")
+}
diff --git a/packages/core/test/session-context-decay.test.ts b/packages/core/test/session-context-decay.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..64a1a9b28495c7b67f087bc4cdd83f93828605e6
--- /dev/null
+++ b/packages/core/test/session-context-decay.test.ts
@@ -0,0 +1,234 @@
+import { expect, test } from "bun:test"
+import { SessionMessage } from "@opencode/schema/session-message"
+import {
+  ARCHIVE_AFTER_TURNS,
+  REEVAL_QUANTUM,
+  decay,
+  indexBlock,
+} from "@opencode/core/session/runner/context-decay"
+import { Schema } from "effect"
+
+// ------------------------------------------------------------------------------------------------- fixtures
+
+let counter = 0
+const callID = () => `call_${counter++}`
+
+const user = (text: string) =>
+  Schema.decodeUnknownSync(SessionMessage.User)({
+    id: SessionMessage.ID.create(),
+    type: "user",
+    text,
+    time: { created: 0 },
+  })
+
+const assistant = (content: readonly unknown[]) =>
+  Schema.decodeUnknownSync(SessionMessage.Assistant)({
+    id: SessionMessage.ID.create(),
+    type: "assistant",
+    agent: "build", // Agent.defaultID — decode validates it against the Agent.ID brand
+
+    model: { id: "test-model", providerID: "test" },
+    content,
+    time: { created: 0, completed: 0 },
+  })
+
+const tool = (state: Record<string, unknown>, id = callID()) => ({
+  type: "tool",
+  id,
+  name: "read",
+  state,
+  time: { created: 0 },
+})
+
+const text = (value: string) => ({ type: "text", text: value })
+
+const err = { type: "unknown", message: "tool blew up" }
+
+/** Every tool part in a projected history, across every assistant message. */
+const toolsOf = (messages: readonly SessionMessage.Info[]) =>
+  messages.flatMap((message) =>
+    message.type === "assistant"
+      ? message.content.filter((item): item is SessionMessage.AssistantTool => item.type === "tool")
+      : [],
+  )
+
+/**
+ * The exact read compaction/lowering performs on a tool result. This is the line that crashed in production
+ * (`e.content.map` on an error state that carried no content) — it must never see `undefined` on a completed
+ * state and must never be handed an emptied array on a rewritten one.
+ */
+const compactionRead = (state: SessionMessage.ToolState) => {
+  if (state.status === "completed") return state.content.map((part) => ("text" in part ? part.text : "")).join("\n")
+  if (state.status === "error") return (state.content ?? []).map((part) => ("text" in part ? part.text : "")).join("\n")
+  return ""
+}
+
+// ----------------------------------------------------------------------------------------------------- tests
+
+test("reader survives every tool state — including an error state with no content", () => {
+  const noContentID = callID()
+  const messages = [
+    user("please read the file"),
+    assistant([
+      text("running the tools"),
+      tool({ status: "streaming", input: '{"filePath": "D:/tmp/a' }),
+      tool({ status: "running", input: { filePath: "D:/tmp/a/x.ts" }, metadata: {} }),
+      tool({ status: "completed", input: {}, content: [text("short output")] }),
+      tool({ status: "error", input: {}, error: err, content: [text("stack trace")] }),
+      // The regression: ToolStateError.content is optional — V2 rows can legally omit it entirely.
+      tool({ status: "error", input: {}, error: err }, noContentID),
+    ]),
+  ]
+
+  expect(() => decay(messages)).not.toThrow()
+  const result = decay(messages)
+
+  for (const item of toolsOf(result.messages)) {
+    // The reader itself must come back as a string for every state, never undefined, never a throw.
+    expect(() => compactionRead(item.state)).not.toThrow()
+    expect(typeof compactionRead(item.state)).toBe("string")
+    // Completed content is a NonEmptyArray in the schema; decay must never have emptied or dropped it.
+    if (item.state.status === "completed") {
+      expect(Array.isArray(item.state.content)).toBe(true)
+      expect(item.state.content.length).toBeGreaterThan(0)
+    }
+    // Error content stays either absent (untouched) or a non-empty array — never null, never [].
+    if (item.state.status === "error" && item.state.content !== undefined) {
+      expect(item.state.content.length).toBeGreaterThan(0)
+    }
+  }
+
+  // The no-content error tool passed through untouched: no fabricated body, no crash, content still absent.
+  const untouched = toolsOf(result.messages).find((item) => item.id === noContentID)
+  expect(untouched).toBeDefined()
+  expect(untouched!.state.status).toBe("error")
+  expect((untouched!.state as SessionMessage.ToolStateError).content).toBeUndefined()
+})
+
+test("unique archived tools retain their evidence, including error content", () => {
+  const big = "x".repeat(5_000)
+  const oldCompleted = callID()
+  const oldErrored = callID()
+
+  const history: SessionMessage.Info[] = [
+    user("task one"),
+    assistant([
+      text("reading the big files"),
+      tool({ status: "completed", input: { filePath: "D:/tmp/a/big.ts" }, content: [text(big)] }, oldCompleted),
+      tool({ status: "error", input: { filePath: "D:/tmp/a/gone.ts" }, error: err, content: [text(big + "error")] }, oldErrored),
+    ]),
+  ]
+  // Push the first turns behind the archive frontier: frontier = quantize(length - ARCHIVE_AFTER_TURNS) >= 2.
+  const padding = ARCHIVE_AFTER_TURNS + REEVAL_QUANTUM * 2
+  for (let i = 0; i < padding; i++) history.push(user(`filler turn ${i}`), assistant([text(`noted ${i}`)]))
+
+  const result = decay(history)
+  expect(result.rewritten).toBe(false)
+  expect(result.archive.length).toBe(0)
+
+  const byID = new Map(toolsOf(result.messages).map((item) => [item.id, item]))
+  for (const id of [oldCompleted, oldErrored]) {
+    const item = byID.get(id)!
+    expect(item).toBeDefined()
+    const state = item.state as SessionMessage.ToolStateCompleted | SessionMessage.ToolStateError
+    // Never emptied outright — an empty tool result trips provider tool_call/tool_result pairing checks,
+    // and an undefined one is exactly the `e.content.map` crash this test pins down.
+    expect(Array.isArray(state.content)).toBe(true)
+    expect(state.content!.length).toBeGreaterThan(0)
+    const body = compactionRead(state)
+    expect(body).toBe(id === oldCompleted ? big : big + "error")
+    expect(body.length).toBeGreaterThan(0)
+  }
+
+  // Every surviving tool in the whole history still reads cleanly through the compaction path.
+  for (const item of toolsOf(result.messages)) {
+    expect(typeof compactionRead(item.state)).toBe("string")
+  }
+
+  // The index block mirrors the archive and stays a plain string.
+  const block = indexBlock(result.archive)
+  expect(block).toBeUndefined()
+  expect(indexBlock([])).toBeUndefined()
+})
+
+test("content-less V2 variants (idle, compaction, marker turns) pass through decay untouched — no crash, no fabricated content", () => {
+  // The production crash: `undefined is not an object (evaluating 'e.content.map')` inside SessionCompaction.compact.
+  // V2 `Info` is an 11-variant union and these variants have NO `content` field and NO `role` field at all.
+  const idle = Schema.decodeUnknownSync(SessionMessage.Info)({
+    id: SessionMessage.ID.create(),
+    type: "idle",
+    outcome: "succeeded",
+    time: { created: 0 },
+  })
+  const compaction = Schema.decodeUnknownSync(SessionMessage.Info)({
+    id: SessionMessage.ID.create(),
+    type: "compaction",
+    status: "completed",
+    reason: "auto",
+    summary: "compacted earlier work",
+    recent: "recent tail",
+    time: { created: 0 },
+  })
+
+  const toolID = callID()
+  const messages = [
+    user("do the thing"),
+    assistant([text("on it"), tool({ status: "completed", input: {}, content: [text("ok")] }, toolID)]),
+    idle,
+    compaction,
+    user("next task"),
+  ]
+
+  // Must not throw on any variant, with or without a prior key.
+  expect(() => decay(messages)).not.toThrow()
+  const result = decay(messages)
+  expect(() => decay(result.messages, result.key)).not.toThrow()
+
+  // Markers come back as the exact same references — decay never rewrites, clones, or invents `content` on them.
+  expect(result.messages).toHaveLength(messages.length)
+  expect(result.messages[2]).toBe(idle)
+  expect(result.messages[3]).toBe(compaction)
+  expect("content" in result.messages[2]!).toBe(false)
+  expect("content" in result.messages[3]!).toBe(false)
+
+  // The assistant turn's tool still reads cleanly through the compaction path.
+  const item = toolsOf(result.messages).find((entry) => entry.id === toolID)!
+  expect(item).toBeDefined()
+  expect(typeof compactionRead(item.state)).toBe("string")
+})
+
+test("unchanged history without eligible duplicates retains its references", () => {
+  const messages = [
+    user("hello"),
+    assistant([text("done"), tool({ status: "completed", input: {}, content: [text("ok")] })]),
+  ]
+  const first = decay(messages)
+  const second = decay(first.messages, first.key)
+  expect(second.rewritten).toBe(false)
+  expect(second.messages).toBe(first.messages)
+  expect(second.archive).toEqual([])
+})
+
+test("mixed text and file parts read without crashing and short output is left verbatim", () => {
+  const mixedID = callID()
+  const messages = [
+    user("read the image"),
+    assistant([
+      text("reading"),
+      tool(
+        {
+          status: "completed",
+          input: {},
+          content: [text("tiny"), { type: "file", mime: "image/png", uri: "data:image/png;base64,QUJD" }],
+        },
+        mixedID,
+      ),
+    ]),
+  ]
+  const result = decay(messages)
+  const item = toolsOf(result.messages).find((entry) => entry.id === mixedID)!
+  const state = item.state as SessionMessage.ToolStateCompleted
+  // Too short to be worth touching: body, including the non-text part, survives byte-identical.
+  expect(state.content.length).toBe(2)
+  expect(() => compactionRead(state)).not.toThrow()
+})
