@@ -0,0 +1,4 @@
+export function normalizeChannel(value) {
+  return typeof value === "string" && /^[a-z0-9][a-z0-9._-]*$/i.test(value.trim()) &&
+    !["undefined", "null"].includes(value.trim().toLowerCase()) ? value.trim() : "local"
+}
diff --git a/.personalize/content.test.mjs b/.personalize/content.test.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..56bff6ccfd5593c5db2676603f65e4f7ff197d3e
--- /dev/null
+++ b/.personalize/content.test.mjs
@@ -0,0 +1,75 @@
+import { test } from "node:test"
+import assert from "node:assert/strict"
+import { mkdtempSync, mkdirSync, readFileSync, rmSync, writeFileSync } from "node:fs"
+import { tmpdir } from "node:os"
+import path from "node:path"
+import { canonicalMessages, historyMessages, copyWith } from "../packages/core/src/personalize/content.ts"
+import { personaLead, stripStockIdentity } from "../packages/core/src/personalize/persona.ts"
+
+test("valid messages retain their exact object identity and metadata", () => {
+  const message = { role: "user", content: [{ type: "text", text: "hello" }], metadata: { instruction: [1] } }
+  assert.equal(canonicalMessages([message])[0], message)
+})
+
+test("missing content is repaired without losing prototypes, symbols, readonly or hidden metadata", () => {
+  const marker = Symbol("metadata")
+  class Message { content = undefined; role = "user"; get kind() { return "original" } }
+  const message = new Message()
+  Object.defineProperty(message, marker, { value: { instructions: [1] }, enumerable: false })
+  Object.defineProperty(message, "content", { value: undefined, writable: false, enumerable: true })
+  const result = canonicalMessages([message])[0]
+  assert(result instanceof Message)
+  assert.equal(result.kind, "original")
+  assert.equal(result[marker], message[marker])
+  assert.equal(Object.getOwnPropertyDescriptor(result, marker).enumerable, false)
+  assert.equal(Object.getOwnPropertyDescriptor(result, "content").writable, false)
+  assert.deepEqual(result.content, [])
+  assert.equal(message.content, undefined)
+})
+
+test("nullish arrays and tool-result values are repaired, not mutated", () => {
+  assert.deepEqual(canonicalMessages(undefined), [])
+  const message = { role: "tool", content: [{ type: "tool-result", result: { type: "content", value: undefined } }] }
+  const result = canonicalMessages([message])[0]
+  assert.deepEqual(result.content[0].result.value, [])
+  assert.equal(message.content[0].result.value, undefined)
+})
+
+test("history repair keeps completed-tool metadata and leaves healthy records alone", () => {
+  const good = { role: "assistant", content: [] }
+  assert.equal(historyMessages([good])[0], good)
+  const bad = { role: "assistant", content: [{ type: "tool", state: { status: "completed", content: undefined, metadata: { id: 1 } } }] }
+  const result = historyMessages([bad])[0]
+  assert.deepEqual(result.content[0].state.content, [])
+  assert.equal(result.content[0].state.metadata, bad.content[0].state.metadata)
+})
+
+test("system-part replacement preserves instruction/cache metadata", () => {
+  const part = { content: "stock", metadata: { experimental: { instructions: [{ id: 1 }] } } }
+  const result = copyWith(part, { content: "persona\nstock" })
+  assert.equal(result.metadata, part.metadata)
+  assert.equal(part.content, "stock")
+})
+
+test("persona seeds the existing role schema and reads only assistant_system", () => {
+  const root = path.join(tmpdir(), "opencode")
+  mkdirSync(root, { recursive: true })
+  const directory = mkdtempSync(path.join(root, "personalize-role-"))
+  const previous = process.env.OPENCODE_ROLE_FILE
+  try {
+    const file = path.join(directory, "role.json")
+    process.env.OPENCODE_ROLE_FILE = file
+    assert.equal(personaLead(), "")
+    assert.deepEqual(JSON.parse(readFileSync(file, "utf8")), { usersystem: "", assistant_system: "" })
+    writeFileSync(file, JSON.stringify({ usersystem: "not this", assistant_system: "exact persona" }))
+    assert.equal(personaLead(), "exact persona")
+    writeFileSync(file, "{broken")
+    assert.equal(personaLead(), "")
+    assert.equal(stripStockIdentity("You are OpenCode, a coding assistant. Keep tools."), "Keep tools.")
+    assert.equal(stripStockIdentity("You are opencode, an agent of change."), "You are opencode, an agent of change.")
+  } finally {
+    if (previous === undefined) delete process.env.OPENCODE_ROLE_FILE
+    else process.env.OPENCODE_ROLE_FILE = previous
+    rmSync(directory, { recursive: true, force: true })
+  }
+})
diff --git a/.personalize/dedup.test.mjs b/.personalize/dedup.test.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..3d6c103a8695421451d4ae88547c38a2ab6a2a07
--- /dev/null
+++ b/.personalize/dedup.test.mjs
@@ -0,0 +1,62 @@
+import { test } from "node:test"
+import assert from "node:assert/strict"
+import {
+  bumpLedger,
+  dedupeText,
+  estimateTokens,
+  ledgerState,
+  normalizeSentence,
+  punchLine,
+  resetLedger,
+  splitSentences,
+} from "../packages/core/src/personalize/dedup.ts"
+
+test("punch line appears only from the second duplicate onward and counts both kinds", () => {
+  resetLedger()
+  assert.equal(punchLine(ledgerState("s1")), "")
+  bumpLedger("s1", "calls", 10)
+  assert.equal(punchLine(ledgerState("s1")), "")
+  bumpLedger("s1", "prose", 30)
+  assert.match(punchLine(ledgerState("s1")), /\*SystemPunch\* duplicates this session: 2 \(≈40 tkn wasted\)/)
+  assert.equal(ledgerState("nope"), undefined)
+  resetLedger()
+  assert.equal(ledgerState("s1"), undefined)
+})
+
+test("dedupeText strips adjacent duplicate sentences, keeps the first, leaves a marker", () => {
+  const text = "Build finished with exit zero. Build finished with exit zero. Now running the serve test."
+  const result = dedupeText(text)
+  assert.ok(result)
+  assert.equal(result.removed, 1)
+  assert.match(result.text, /\[duplicate removed ×1: "Build finished[^"]*"\]/)
+  assert.ok(result.text.includes("Now running the serve test."))
+  assert.ok(result.wastedTokens > 0)
+  const withoutMarker = result.text.replace(/\[duplicate[^\]]*\]/, "")
+  assert.ok(!withoutMarker.includes("Build finished with exit zero. Build"))
+})
+
+test("dedupeText collapses longer runs into one marker", () => {
+  const text = "Alpha beta gamma delta epsilon. Alpha beta gamma delta epsilon. Alpha beta gamma delta epsilon."
+  const result = dedupeText(text)
+  assert.ok(result)
+  assert.equal(result.removed, 2)
+  assert.match(result.text, /×2/)
+})
+
+test("dedupeText leaves non-adjacent repeats, short sentences and healthy text alone", () => {
+  assert.equal(dedupeText("Just one sentence, nothing repeated here at all."), undefined)
+  assert.equal(dedupeText("Fine. Fine. Fine. Fine. Fine. Fine. Fine. Fine. Fine. Fine."), undefined)
+  const nonAdjacent =
+    "Alpha beta gamma delta epsilon zeta. A completely different sentence follows here. Alpha beta gamma delta epsilon zeta."
+  assert.equal(dedupeText(nonAdjacent), undefined)
+})
+
+test("sentence normalization ignores case, punctuation and whitespace", () => {
+  assert.equal(normalizeSentence("  Build, FINISHED!!  "), normalizeSentence("build finished"))
+  assert.deepEqual(splitSentences("One. Two!\nThree?"), ["One.", "Two!", "Three?"])
+})
+
+test("estimateTokens is a deterministic chars/4 ceiling", () => {
+  assert.equal(estimateTokens("1234"), 1)
+  assert.equal(estimateTokens("12345"), 2)
+})
diff --git a/.personalize/lifetime-effect.test.mjs b/.personalize/lifetime-effect.test.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..d18c25fb18e844295f92794b9593f41629bdc7c5
--- /dev/null
+++ b/.personalize/lifetime-effect.test.mjs
@@ -0,0 +1,205 @@
+import assert from "node:assert/strict"
+import fs from "node:fs"
+import path from "node:path"
+import { stripTypeScriptTypes } from "node:module"
+import { test } from "node:test"
+import { Lifetime, defaults, duration } from "../packages/util/src/personalize-lifetime.ts"
+
+const { Context, Effect, Layer, Option } = await import(process.env.PERSONALIZE_EFFECT ?? "effect")
+
+// Exercise the actual owned factories with the actual pinned Effect runtime;
+// only the host services are test doubles. No server or child processes.
+function load(relative, dependencies, names = ["decorate"], extra = {}) {
+  let code = stripTypeScriptTypes(fs.readFileSync(new URL(`../${relative}`, import.meta.url), "utf8"), { mode: "transform" })
+  code = code.replace(/^import\s+\{([^}]+)\}\s+from\s+["']([^"']+)["'];?$/gm,
+    (_, fields, specifier) => `const {${fields.replace(/\bas\b/g, ":")}} = deps[${JSON.stringify(specifier)}];`)
+  code = code.replace(/^import\s+(\w+)\s+from\s+["']([^"']+)["'];?$/gm,
+    (_, name, specifier) => `const ${name} = deps[${JSON.stringify(specifier)}];`)
+  code = code.replace(/^export /gm, "")
+  return new Function("deps", ...Object.keys(extra), `${code}\nreturn {${names.join(",")}}`)(dependencies, ...Object.values(extra))
+}
+
+function graph(tag, service) {
+  return {
+    mapLayer: (f) => ({ layer: f(Layer.succeed(tag, service)) }),
+    replace: (replacement) => ({ tag, ...replacement }),
+  }
+}
+
+test("route seam forwards trailing arguments and counts real session/job lifetimes", async () => {
+  const policy = new Lifetime(); policy.start(); policy.connect()
+  const JobService = Context.Service()("test/Job")
+  const ExecutionService = Context.Service()("test/Execution")
+  const BusService = Context.Service()("test/Bus")
+  const queued = [], active = new Set()
+  let subscriber, unsubscribed = false, forwarded
+  const job = { start: ({ run }) => Effect.sync(() => { queued.push(run); return "job-id" }) }
+  const execution = { active: Effect.sync(() => active) }
+  const events = Object.fromEntries(["Started", "Succeeded", "Failed", "Interrupted"].map((name) => [name, { type: name }]))
+  const { decorate } = load("packages/server/src/personalize/routes.ts", {
+    effect: { Context, Effect, Layer, Option },
+    "@opencode/core/job": { Job: { Service: JobService, node: graph(JobService, job) } },
+    "@opencode/core/session/execution": { SessionExecution: { Service: ExecutionService, node: graph(ExecutionService, execution) } },
+    "@opencode/core/bus": { Bus: { Service: BusService } },
+    "@opencode/schema/session-event": { SessionEvent: { Execution: events } },
+    "./idle-state": { lifetime: policy },
+  })
+  const options = {}, urls = () => [], caller = { caller: true }, instances = {}, future = {}
+  decorate({ createRoutes: (...args) => { forwarded = args } }).createRoutes(options, urls, [caller], instances, future)
+  assert.equal(forwarded[0], options); assert.equal(forwarded[1], urls)
+  assert.equal(forwarded[2].at(-1), caller)
+  assert.equal(forwarded[3], instances); assert.equal(forwarded[4], future)
+  const bus = { listen: (fn) => Effect.sync(() => {
+    subscriber = fn
+    return Effect.sync(() => { unsubscribed = true })
+  }) }
+  const combined = Layer.mergeAll(...forwarded[2].slice(0, 2).map((replacement) => replacement.layer)).pipe(
+    Layer.provide(Layer.succeed(BusService, bus)),
+  )
+  await Effect.runPromise(Effect.scoped(Effect.gen(function* () {
+    const context = yield* Layer.build(combined)
+    const jobs = Context.get(context, JobService)
+    yield* jobs.start({ run: Effect.void })
+    assert.equal(policy.jobs, 1, "queued work is already protected")
+    yield* queued.shift()
+    assert.equal(policy.jobs, 0)
+    yield* jobs.start({ run: Effect.fail(new Error("tool failed")) })
+    yield* queued.shift().pipe(Effect.exit)
+    assert.equal(policy.jobs, 0, "failed tools release their lease")
+    yield* subscriber({ type: "Started", data: { sessionID: "parent" } })
+    yield* subscriber({ type: "Started", data: { sessionID: "child" } })
+    yield* subscriber({ type: "Started", data: { sessionID: "child" } })
+    assert.equal(policy.jobs, 2, "parallel sessions count separately; duplicate events do not")
+    yield* subscriber({ type: "Succeeded", data: { sessionID: "parent" } })
+    assert.equal(policy.jobs, 1)
+    yield* subscriber({ type: "Interrupted", data: { sessionID: "child" } })
+    assert.equal(policy.jobs, 0)
+    active.add("unreported-session")
+    assert.equal(policy.next(), undefined, "actual active-session state protects against a missing lifecycle event")
+    active.clear()
+  })))
+  assert.equal(unsubscribed, true)
+})
+
+test("native commands show warnings, query status, and update without model/tool calls", async () => {
+  let commandLayer, keyboard, request, toast, rendered
+  const client = { url: "http://localhost:28894", headers: { Authorization: "test-auth" }, connection: { status: () => "connected" } }
+  const { decorate } = load("packages/tui/src/personalize/lifetime.ts", {
+    "@opencode/plugin/tui": { Plugin: { define: (plugin) => plugin } },
+    "@opentui/solid": { useKeyboard: (fn) => { keyboard = fn } },
+    "solid-js": {},
+    "@opencode/util/personalize-lifetime": { defaults, duration },
+    "../context/client": { useClient: () => client },
+    "./lifetime-state": { wake: { wake() {} } },
+  }, ["decorate"], { fetch: async (url, options) => {
+    request = { url: String(url), ...options }
+    return { ok: true, json: async () => ({ hardMs: 1000, softMs: 10000 }) }
+  } })
+  const original = {}
+  const plugins = decorate({ builtins: [original] }).builtins
+  assert.equal(plugins[0], original)
+  plugins.at(-1).setup({
+    ui: { slot: ({ render }) => { rendered = render }, toast: { show: (value) => { toast = value } } },
+    keymap: { layer: (factory) => { commandLayer = factory() } },
+  })
+  rendered()
+  assert.equal(typeof keyboard, "function")
+  const hard = commandLayer.commands.find((command) => command.slash.name === "killtime")
+  const soft = commandLayer.commands.find((command) => command.slash.name === "softkilltime")
+  assert.match(hard.description, /priority.*unfinished work/)
+  assert.match(soft.description, /all tasks, subagents and background tools/)
+  await hard.run("1s")
+  assert.equal(request.method, "PUT")
+  assert.equal(request.headers.Authorization, "test-auth")
+  assert.deepEqual(JSON.parse(request.body), { command: "killtime", duration: "1s" })
+  assert.match(toast.message, /1s/)
+  await soft.run()
+  assert.equal(request.method, "GET")
+})
+
+test("watchdog cancels reconnect grace and reschedules after final disconnect", () => {
+  let now = 0, timer, soft = 0, hard = 0
+  const policy = new Lifetime({ hardMs: 1000, softMs: 100 }, () => now)
+  const { armIdleWatchdog } = load("packages/server/src/personalize/idle-state.ts", {
+    "@opencode/util/personalize-lifetime": { Lifetime: class { constructor() { return policy } } },
+    "@opencode/util/personalize-lifetime-store": { settings: () => policy.settings, sleeping() {}, evictSelf() {} },
+  }, ["armIdleWatchdog"], {
+    setTimeout: (fn, ms) => (timer = { fn, ms, unref() {} }),
+    clearTimeout: (handle) => { if (timer === handle) timer = undefined }, console: { error() {} },
+  })
+  const disarm = armIdleWatchdog(() => soft++, () => hard++)
+  policy.start()
+  const close = policy.connect()
+  assert.equal(timer, undefined)
+  now = 3000; close()
+  assert.equal(timer.ms, 500)
+  now = 3499; const reconnect = policy.connect()
+  assert.equal(timer, undefined)
+  now = 3600; reconnect()
+  assert.equal(timer.ms, 500)
+  now = 4100; timer.fn()
+  assert.equal(soft, 1); assert.equal(hard, 0)
+  disarm()
+})
+
+test("deadline timer invokes hard kill despite work", () => {
+  let now = 0, callback, delay, soft = 0, hard = 0, marked
+  const policy = new Lifetime({ hardMs: 1000, softMs: 500 }, () => now)
+  const { armIdleWatchdog } = load("packages/server/src/personalize/idle-state.ts", {
+    "@opencode/util/personalize-lifetime": { Lifetime: class { constructor() { return policy } } },
+    "@opencode/util/personalize-lifetime-store": { settings: () => policy.settings, sleeping: (kind) => { marked = kind }, evictSelf() {} },
+  }, ["armIdleWatchdog"], {
+    setTimeout: (fn, ms) => { callback = fn; delay = ms; return { unref() {} } },
+    clearTimeout: () => {}, console: { error() {} },
+  })
+  const disarm = armIdleWatchdog(() => soft++, () => hard++)
+  policy.start(); policy.work()
+  assert.equal(delay, 1000)
+  now = 1000; callback()
+  assert.equal(hard, 1); assert.equal(soft, 0); assert.equal(marked, "hard")
+  disarm()
+})
+
+test("soft cleanup hanging does not disarm the eventual hard kill", () => {
+  let now = 0, callback, delay, soft = 0, hard = 0
+  const policy = new Lifetime({ hardMs: 1000, softMs: 500 }, () => now)
+  const { armIdleWatchdog } = load("packages/server/src/personalize/idle-state.ts", {
+    "@opencode/util/personalize-lifetime": { Lifetime: class { constructor() { return policy } } },
+    "@opencode/util/personalize-lifetime-store": { settings: () => policy.settings, sleeping() {}, evictSelf() {} },
+  }, ["armIdleWatchdog"], {
+    setTimeout: (fn, ms) => { callback = fn; delay = ms; return { unref() {} } },
+    clearTimeout() {}, console: { error() {} },
+  })
+  const disarm = armIdleWatchdog(() => { soft++ /* shutdown never finishes */ }, () => hard++)
+  policy.start()
+  assert.equal(delay, 500)
+  now = 500; callback()
+  assert.equal(soft, 1); assert.equal(hard, 0); assert.equal(delay, 500)
+  now = 1000; callback()
+  assert.equal(hard, 1)
+  disarm()
+})
+
+test("marker or registration failure cannot block hard shutdown", () => {
+  let now = 0, callback, delay, soft = 0, hard = 0
+  const policy = new Lifetime({ hardMs: 1000, softMs: 500 }, () => now)
+  const { armIdleWatchdog } = load("packages/server/src/personalize/idle-state.ts", {
+    "@opencode/util/personalize-lifetime": { Lifetime: class { constructor() { return policy } } },
+    "@opencode/util/personalize-lifetime-store": {
+      settings: () => policy.settings,
+      sleeping() { throw new Error("disk unavailable") },
+      evictSelf() { throw new Error("registration locked") },
+    },
+  }, ["armIdleWatchdog"], {
+    setTimeout: (fn, ms) => { callback = fn; delay = ms; return { unref() {} } },
+    clearTimeout() {}, console: { error() {} },
+  })
+  const disarm = armIdleWatchdog(() => soft++, () => hard++)
+  policy.start()
+  now = 500; callback()
+  assert.equal(soft, 0, "unsafe soft stop is withheld, not allowed to respawn-loop")
+  assert.equal(delay, 500, "the hard deadline remains armed")
+  now = 1000; callback()
+  assert.equal(hard, 1, "disk/registration failures do not prevent force-kill")
+  disarm()
+})
diff --git a/.personalize/lifetime.test.mjs b/.personalize/lifetime.test.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..d3da95e10bd09fbd15b8986406a03e20b9798340
--- /dev/null
+++ b/.personalize/lifetime.test.mjs
@@ -0,0 +1,176 @@
+import assert from "node:assert/strict"
+import { test } from "node:test"
+import { Lifetime, WakeGate, defaults, duration } from "../packages/util/src/personalize-lifetime.ts"
+
+function clock(settings = defaults) {
+  let now = 0
+  const policy = new Lifetime({ ...settings }, () => now)
+  policy.start()
+  return { policy, at: (time) => { now = time } }
+}
+
+test("defaults are hard 20s / soft 10s", () => {
+  assert.deepEqual(defaults, { hardMs: 20_000, softMs: 10_000 })
+})
+
+test("duration accepts short custom times and rejects disabling/invalid input", () => {
+  for (const [input, ms] of [["1s", 1000], ["50ms", 50], ["0.5s", 500], ["2m", 120000], ["default", 20000]])
+    assert.equal(duration(input, 20000), ms)
+  for (const input of ["0s", "-1s", "1", "Infinitys", "1s garbage", "0.1ms", "999999999m"])
+    assert.throws(() => duration(input, 20000))
+})
+
+test("last window disconnect, not heartbeats, starts the hard countdown", () => {
+  const { policy, at } = clock({ hardMs: 1000, softMs: 10000 })
+  const first = policy.connect(), second = policy.connect()
+  policy.work()
+  at(5000); first()
+  assert.equal(policy.next(), undefined)
+  at(9000); second()
+  assert.deepEqual(policy.next(), { kind: "hard", after: 1000 })
+  at(10000)
+  assert.deepEqual(policy.next(), { kind: "hard", after: 0 })
+})
+
+test("hard deadline never waits for tasks, subagents, or soft shutdown", () => {
+  const { policy, at } = clock({ hardMs: 1000, softMs: 10000 })
+  policy.work(); policy.work(); policy.work("requests")
+  at(1000)
+  assert.deepEqual(policy.next(), { kind: "hard", after: 0 })
+})
+
+test("soft never stops the service while a window stays connected", () => {
+  const { policy, at } = clock({ hardMs: 20000, softMs: 1000 })
+  const close = policy.connect()
+  const parent = policy.work(), child = policy.work(), tool = policy.work()
+  at(4000); parent(); child()
+  assert.equal(policy.next(), undefined)
+  at(5000); tool()
+  assert.equal(policy.next(), undefined, "an idle open window keeps the service alive")
+  at(6000); close()
+  assert.deepEqual(policy.next(), { kind: "soft", after: 10000 })
+})
+
+test("new work cancels and completion resets the soft countdown", () => {
+  const { policy, at } = clock({ hardMs: 20000, softMs: 1000 })
+  const close = policy.connect()
+  at(900); const done = policy.work()
+  at(5000); assert.equal(policy.next(), undefined)
+  done(); close()
+  assert.deepEqual(policy.next(), { kind: "soft", after: 10000 })
+})
+
+test("idle disconnect gets half the hard timeout to reconnect", () => {
+  const { policy, at } = clock()
+  const close = policy.connect()
+  at(30000); close()
+  assert.deepEqual(policy.next(), { kind: "soft", after: 10000 })
+  at(39999); assert.deepEqual(policy.next(), { kind: "soft", after: 1 })
+  const reconnect = policy.connect()
+  at(40001); assert.equal(policy.next(), undefined)
+  reconnect()
+  assert.deepEqual(policy.next(), { kind: "soft", after: 10000 })
+})
+
+test("grace starts only when the last window disconnects", () => {
+  const { policy, at } = clock({ hardMs: 12000, softMs: 1000 })
+  const first = policy.connect(), second = policy.connect()
+  at(30000); first()
+  assert.equal(policy.next(), undefined)
+  at(31000); second()
+  assert.deepEqual(policy.next(), { kind: "soft", after: 6000 })
+  at(37000); assert.deepEqual(policy.next(), { kind: "soft", after: 0 })
+})
+
+test("active work blocks soft shutdown but not the original hard deadline", () => {
+  const { policy, at } = clock({ hardMs: 12000, softMs: 1000 })
+  const close = policy.connect(), done = policy.work()
+  at(30000); close()
+  assert.deepEqual(policy.next(), { kind: "hard", after: 12000 })
+  at(37000); done()
+  assert.deepEqual(policy.next(), { kind: "soft", after: 1000 })
+  const again = policy.work()
+  at(42000); assert.deepEqual(policy.next(), { kind: "hard", after: 0 })
+  again()
+})
+
+test("half-hard grace preserves longer soft deadlines and hard priority", () => {
+  const { policy, at } = clock({ hardMs: 1000, softMs: 750 })
+  assert.deepEqual(policy.next(), { kind: "soft", after: 750 })
+  at(100); policy.configure({ hardMs: 1000, softMs: 1000 })
+  assert.deepEqual(policy.next(), { kind: "hard", after: 1000 })
+  at(200); policy.configure({ hardMs: 1000, softMs: 2000 })
+  assert.deepEqual(policy.next(), { kind: "hard", after: 1000 })
+})
+
+test("startup and odd millisecond hard timeouts get the half-hard minimum", () => {
+  const { policy } = clock({ hardMs: 1001, softMs: 100 })
+  assert.deepEqual(policy.next(), { kind: "soft", after: 500.5 })
+})
+
+test("a window reconnect cancels the hard countdown without touching soft work state", () => {
+  const { policy, at } = clock({ hardMs: 1000, softMs: 10000 })
+  policy.work()
+  at(999); policy.connect()
+  at(1001); assert.equal(policy.next(), undefined)
+})
+
+test("soft may stop sooner, hard wins equal deadlines", () => {
+  const { policy } = clock()
+  assert.deepEqual(policy.next(), { kind: "soft", after: 10000 })
+  policy.configure({ hardMs: 1000, softMs: 1000 })
+  assert.deepEqual(policy.next(), { kind: "hard", after: 1000 })
+})
+
+test("custom settings reset the deadline and finalizers are idempotent", () => {
+  const { policy, at } = clock()
+  const close = policy.connect(), done = policy.work()
+  close(); close(); done(); done()
+  assert.equal(policy.clients, 0); assert.equal(policy.jobs, 0)
+  at(30000); policy.configure({ hardMs: 1000, softMs: 2000 })
+  assert.deepEqual(policy.next(), { kind: "hard", after: 1000 })
+})
+
+test("no shutdown during boot or after stopping", () => {
+  const policy = new Lifetime()
+  assert.equal(policy.next(), undefined)
+  policy.start(); policy.stopped = true
+  assert.equal(policy.next(), undefined)
+})
+
+test("broken soft probe and hung soft cleanup cannot cancel the hard deadline", () => {
+  const { policy, at } = clock()
+  policy.externalBusy = () => { throw new Error("probe failed") }
+  assert.deepEqual(policy.next(), { kind: "hard", after: 20000 })
+  policy.externalBusy = () => false
+  policy.softStopping = true
+  at(20000)
+  assert.deepEqual(policy.next(), { kind: "hard", after: 0 })
+})
+
+test("intentional sleep parks automatic reconnect until user input", async () => {
+  let now = 0, slept = -1
+  const gate = new WakeGate((time) => slept > time, () => now)
+  const abort = new AbortController()
+  await gate.wait(abort.signal)
+  now = slept = 1000
+  let connected = false
+  const reconnect = gate.wait(abort.signal).then(() => { connected = true })
+  await Promise.resolve()
+  assert.equal(connected, false, "SSE retries cannot wake a sleeping service")
+  now = 1100; gate.wake()
+  await reconnect
+  assert.equal(connected, true)
+  await gate.wait(abort.signal)
+})
+
+test("parked reconnect is aborted cleanly when its window exits", async () => {
+  let slept = -1
+  const gate = new WakeGate((time) => slept > time, () => 0)
+  const abort = new AbortController()
+  slept = 1000
+  const reconnect = gate.wait(abort.signal)
+  abort.abort(new Error("window closed"))
+  await assert.rejects(reconnect, /window closed/)
+  gate.wake()
+})
