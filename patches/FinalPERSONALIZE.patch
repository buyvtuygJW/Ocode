diff --git a/.personalize/build.mjs b/.personalize/build.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..a82f635eff1e8108137a47cb378116dd4456350a
--- /dev/null
+++ b/.personalize/build.mjs
@@ -0,0 +1,127 @@
+import { existsSync, readFileSync } from "node:fs"
+import path from "node:path"
+import { fileURLToPath } from "node:url"
+import { normalizeChannel } from "./channel.mjs"
+export { normalizeChannel } from "./channel.mjs"
+
+const ORIGINAL = "personalize-original"
+const PREFIX = "personalize:original:"
+// Bun dedupes modules by path while ignoring the namespace, so the original must never
+// collide with the shim's real file path. The marker sits in the basename, keeping the
+// real directory so Bun's default resolver (extensions, index files, tsconfig) resolves
+// the stock module's imports exactly like upstream.
+const VIRTUAL = ".personalize-original~"
+const directory = path.dirname(fileURLToPath(import.meta.url))
+
+// This module is the FIRST build-script import, before Script computes its constants.
+if (process.env.OPENCODE_CHANNEL !== undefined) {
+  process.env.OPENCODE_CHANNEL = normalizeChannel(process.env.OPENCODE_CHANNEL)
+}
+
+const key = (value) => {
+  const normalized = path.resolve(value).replaceAll("\\", "/")
+  return process.platform === "win32" ? normalized.toLowerCase() : normalized
+}
+
+export function loadManifest(root) {
+  const result = new Map()
+  for (const name of ["manifest.json", "R.json", "S.json", "X.json"]) {
+    const filename = path.join(root, ".personalize", name)
+    if (!existsSync(filename)) continue
+    const manifest = JSON.parse(readFileSync(filename, "utf8"))
+    for (const item of manifest.modules) {
+      const target = path.resolve(root, item.target)
+      if (!existsSync(target)) throw new Error(`Personalize target missing: ${item.target}`)
+      for (const filename of [...(item.before || []), ...(item.factory ? [item.factory] : [])]) {
+        if (!existsSync(path.resolve(root, filename))) throw new Error(`Personalize owned module missing: ${filename}`)
+      }
+      const current = result.get(key(target)) || { target, modules: [] }
+      current.modules.push(item)
+      result.set(key(target), current)
+    }
+  }
+  return result
+}
+
+export function moduleShim(root, entry) {
+  const original = PREFIX + encodeURIComponent(entry.target)
+  const code = []
+  for (const item of entry.modules) for (const filename of item.before || []) {
+    code.push(`import ${JSON.stringify(path.resolve(root, filename).replaceAll("\\", "/"))}`)
+  }
+  code.push(`export * from ${JSON.stringify(original)}`)
+  const factories = entry.modules.filter((item) => item.factory)
+  if (!factories.length) return code.join("\n") + "\n"
+  code.push(`import * as original from ${JSON.stringify(original)}`)
+  const names = new Set()
+  factories.forEach((item, index) => {
+    for (const name of item.exports) {
+      if (!/^[A-Za-z_$][\w$]*$/.test(name) || name === "default") throw new Error(`Invalid Personalize export: ${name}`)
+      names.add(name)
+    }
+    code.push(`import { decorate as decorate${index} } from ${JSON.stringify(path.resolve(root, item.factory).replaceAll("\\", "/"))}`)
+    for (const name of item.exports) code.push(`if (!(${JSON.stringify(name)} in original)) throw new Error(${JSON.stringify(`Personalize public export changed: ${entry.target}#${name}`)})`)
+    code.push(`const stage${index} = { ...${index ? `stage${index - 1}` : "original"}, ...decorate${index}(${index ? `stage${index - 1}` : "original"}) }`)
+  })
+  for (const name of names) code.push(`export const ${name} = stage${factories.length - 1}.${name}`)
+  return code.join("\n") + "\n"
+}
+
+/** Adapt normal plugin registrations so original TSX still uses the STOCK Solid compiler. */
+export function forwardPlugin(plugin) {
+  return {
+    ...plugin,
+    setup(build) {
+      const facade = Object.create(build)
+      for (const method of ["onLoad", "onResolve"]) Object.defineProperty(facade, method, {
+        value(options, callback) {
+          build[method]({ namespace: "file", ...options }, callback)
+          if (!options.namespace || options.namespace === "file") {
+            build[method]({ ...options, namespace: ORIGINAL }, (args) => callback({ ...args, namespace: "file", path: args.path.replaceAll(VIRTUAL, ""), importer: args.importer?.replaceAll(VIRTUAL, "") }))
+          }
+        },
+      })
+      return plugin.setup(facade)
+    },
+  }
+}
+
+export function personalizationPlugins(plugins, options = {}) {
+  const root = options.root || path.resolve(directory, "..")
+  const manifest = loadManifest(root)
+  const aliases = {
+    name: "personalize-owned-module-boundaries",
+    setup(build) {
+      const original = (args) => {
+        const filename = decodeURIComponent(args.path.slice(PREFIX.length))
+        if (!manifest.has(key(filename))) throw new Error(`Unregistered Personalize original: ${filename}`)
+        const normalized = filename.replaceAll("\\", "/")
+        const slash = normalized.lastIndexOf("/")
+        return { path: normalized.slice(0, slash + 1) + VIRTUAL + normalized.slice(slash + 1), namespace: ORIGINAL }
+      }
+      build.onResolve({ filter: /^personalize:original:/, namespace: "file" }, original)
+      build.onResolve({ filter: /^personalize:original:/, namespace: ORIGINAL }, original)
+      build.onLoad({ filter: /\.[cm]?[jt]sx?$/, namespace: "file" }, (args) => {
+        const entry = manifest.get(key(args.path))
+        if (!entry) return
+        return { loader: "js", contents: moduleShim(root, entry) }
+      })
+    },
+  }
+  const originals = {
+    name: "personalize-stock-modules-unchanged",
+    setup(build) {
+      build.onLoad({ filter: /.*/, namespace: ORIGINAL }, (args) => {
+        const filename = args.path.replaceAll("\\", "/").replaceAll(VIRTUAL, "")
+        return {
+          // No substitutions, AST edits, copied framework implementations, or source anchors.
+          contents: readFileSync(filename, "utf8"),
+          loader: args.path.endsWith(".tsx") ? "tsx" : args.path.endsWith(".jsx") ? "jsx" : "ts",
+        }
+      })
+    },
+  }
+  return [aliases, ...plugins.map(forwardPlugin), originals]
+}
+
+export const PersonalizeBuild = { plugins: personalizationPlugins }
diff --git a/.personalize/build.test.mjs b/.personalize/build.test.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..f889883cdc027a5ab1e74e3fd3a5cb1e1fd5f299
--- /dev/null
+++ b/.personalize/build.test.mjs
@@ -0,0 +1,103 @@
+import { afterEach, test } from "node:test"
+import assert from "node:assert/strict"
+import { mkdirSync, mkdtempSync, readFileSync, rmSync, writeFileSync } from "node:fs"
+import { tmpdir } from "node:os"
+import path from "node:path"
+import { forwardPlugin, loadManifest, moduleShim, normalizeChannel, personalizationPlugins } from "./build.mjs"
+
+const directories = []
+afterEach(() => {
+  for (const directory of directories.splice(0)) rmSync(directory, { recursive: true, force: true })
+})
+
+function fixture() {
+  const temporary = path.join(tmpdir(), "opencode")
+  mkdirSync(temporary, { recursive: true })
+  const root = mkdtempSync(path.join(temporary, "personalize-resolver-"))
+  directories.push(root)
+  mkdirSync(path.join(root, ".personalize"))
+  writeFileSync(path.join(root, "stock.ts"), "// deliberately unlike ANY old source\nexport const value = 1\n")
+  writeFileSync(path.join(root, "owned.ts"), "export const decorate = stock => ({ value: stock.value + 1 })\n")
+  writeFileSync(path.join(root, ".personalize/manifest.json"), JSON.stringify({ modules: [
+    { target: "stock.ts", factory: "owned.ts", exports: ["value"] },
+  ] }))
+  return root
+}
+
+function registrations(plugins) {
+  const registrations = { onLoad: [], onResolve: [] }
+  for (const plugin of plugins) plugin.setup({
+    onLoad(options, callback) { registrations.onLoad.push({ options, callback }) },
+    onResolve(options, callback) { registrations.onResolve.push({ options, callback }) },
+  })
+  return registrations
+}
+
+test("channel normalization handles null/undefined/bad names without trim crashes", () => {
+  for (const value of [undefined, null, "", "undefined", " null ", "a/b", 1]) assert.equal(normalizeChannel(value), "local")
+  assert.equal(normalizeChannel(" custom "), "custom")
+})
+
+test("wrapper delegates every untouched export and contains no stock implementation", () => {
+  const root = fixture()
+  const shim = moduleShim(root, [...loadManifest(root).values()][0])
+  assert.match(shim, /export \* from "personalize:original:/)
+  assert.match(shim, /export const value = stage0.value/)
+  assert(!shim.includes("value = 1"))
+  assert(!shim.includes("deliberately unlike"))
+})
+
+test("unknown optional files are not invented and missing owned modules fail closed", () => {
+  const root = fixture()
+  assert.equal(loadManifest(root).size, 1)
+  rmSync(path.join(root, "owned.ts"))
+  assert.throws(() => loadManifest(root), /owned module missing/)
+})
+
+test("original module bytes stay byte-for-byte untouched", () => {
+  const root = fixture()
+  const hooks = registrations(personalizationPlugins([], { root }))
+  const original = hooks.onLoad.find((h) => h.options.namespace === "personalize-original")
+  assert.equal(original.callback({ path: path.join(root, "stock.ts") }).contents,
+    readFileSync(path.join(root, "stock.ts"), "utf8"))
+})
+
+test("private originals cannot address arbitrary unregistered files", () => {
+  const root = fixture()
+  const hooks = registrations(personalizationPlugins([], { root }))
+  const resolve = hooks.onResolve.find((h) => h.options.namespace === "file")
+  assert.throws(() => resolve.callback({ path: "personalize:original:" + encodeURIComponent(path.join(root, "secret.ts")) }), /Unregistered/)
+})
+
+test("stock Solid/virtual/native callbacks receive originals in their expected file namespace", () => {
+  const seen = []
+  const hooks = registrations([forwardPlugin({ name: "stock-solid", setup(build) {
+    build.onLoad({ filter: /\.tsx$/ }, (args) => { seen.push(args); return { contents: "compiled-by-stock-solid", loader: "js" } })
+  } })])
+  const original = hooks.onLoad.find((h) => h.options.namespace === "personalize-original")
+  assert.equal(original.callback({ path: "stock.tsx", namespace: "personalize-original" }).contents, "compiled-by-stock-solid")
+  assert.equal(seen[0].namespace, "file")
+})
+
+test("custom upstream plugin namespaces are not duplicated or rewritten", () => {
+  const hooks = registrations([forwardPlugin({ name: "stock-virtual", setup(build) {
+    build.onLoad({ filter: /.*/, namespace: "opencode" }, () => ({ contents: "embedded" }))
+  } })])
+  assert.equal(hooks.onLoad.length, 1)
+  assert.equal(hooks.onLoad[0].options.namespace, "opencode")
+})
+
+test("non-writable SDK methods can be adapted without assigning to inherited fields", () => {
+  const calls = []
+  const build = Object.freeze({ onLoad: (...args) => calls.push(args), onResolve() {} })
+  forwardPlugin({ name: "frozen-sdk", setup(api) { api.onLoad({ filter: /x/ }, () => undefined) } }).setup(build)
+  assert.equal(calls.length, 2)
+  assert.equal(calls[0][0].namespace, "file")
+  assert.equal(calls[1][0].namespace, "personalize-original")
+})
+
+test("plugin order intercepts the selected file, then delegates original transforms before raw fallback", () => {
+  const root = fixture()
+  const plugins = personalizationPlugins([{ name: "stock", setup() {} }], { root })
+  assert.deepEqual(plugins.map((p) => p.name), ["personalize-owned-module-boundaries", "stock", "personalize-stock-modules-unchanged"])
+})
