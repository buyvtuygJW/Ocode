index 0000000000000000000000000000000000000000..a8f3c59361aa5661ec3697b26a0147cd086c16a0
--- /dev/null
+++ b/packages/core/src/personalize/plugin-registration.ts
@@ -0,0 +1,15 @@
+import type { Plugin } from "@opencode/plugin/effect/plugin"
+import type { Effect } from "effect"
+import type { PluginInternal } from "../plugin/internal"
+
+type Registry = Effect.Success<ReturnType<typeof PluginInternal.list>>
+
+/** Register through the builtin list, without decorating a builtin's module or implementation. */
+export function registerAfter(registry: Registry, anchor: string, plugin: Plugin): Registry {
+  const matches = registry.pre.flatMap((entry, index) => entry.id === anchor ? [index] : [])
+  if (matches.length !== 1) throw new Error(`Expected one builtin registration for ${anchor}; found ${matches.length}`)
+  if ([...registry.pre, ...registry.post].some((entry) => entry.id === plugin.id))
+    throw new Error(`Duplicate builtin registration: ${plugin.id}`)
+  const entry = { id: plugin.id, effect: plugin.effect, revision: "internal", source: { type: "builtin" as const } }
+  return { ...registry, pre: [...registry.pre.slice(0, matches[0] + 1), entry, ...registry.pre.slice(matches[0] + 1)] }
+}
diff --git a/packages/core/src/personalize/shell-permission.ts b/packages/core/src/personalize/shell-permission.ts
new file mode 100644
index 0000000000000000000000000000000000000000..9ccf58ff6786bab73d7333f078737c58e1ef4b54
--- /dev/null
+++ b/packages/core/src/personalize/shell-permission.ts
@@ -0,0 +1,58 @@
+import path from "node:path"
+import { createHash } from "node:crypto"
+import { Effect } from "effect"
+import type { ShellCreateBefore } from "@opencode/plugin/effect/shell"
+import type { Tool } from "@opencode/schema/tool"
+import type { FileAccess } from "../file-access.js"
+import { Permission } from "../permission.js"
+
+// Only simple built-in queries and literal output in system Windows PowerShell
+// without profiles are known not to touch the filesystem. Parsing alone is not
+// proof: redirects, pipes, substitutions and scripts must remain unknown.
+export function hasNoFilesystemEffects(
+  command: string,
+  shell: string,
+  platform: string = process.platform,
+  systemRoot = process.env.SystemRoot,
+): boolean {
+  if (platform !== "win32" || !systemRoot || !path.win32.isAbsolute(systemRoot)) return false
+  const expected = path.win32.join(systemRoot, "System32", "WindowsPowerShell", "v1.0", "powershell.exe")
+  if (path.win32.normalize(shell).toLowerCase() !== expected.toLowerCase()) return false
+  if (/[\r\n]/.test(command)) return false
+  const output = /^[ \t]*(?:Write-Output|Write-Host|echo)(?:[ \t]+(?:[A-Za-z0-9_.:,!?/-]+|'[A-Za-z0-9 ._,:!?/-]*'|"[A-Za-z0-9 ._,:!?/-]*"))+[ \t]*$/i
+  const date = /^[ \t]*Get-Date(?:[ \t]+-Format[ \t]+(?:[A-Za-z0-9_.:/-]+|'[A-Za-z0-9 ._,:/-]+'|"[A-Za-z0-9 ._,:/-]+"))?[ \t]*$/i
+  const query = /^[ \t]*(?:Get-Location|pwd|Get-Host|Get-Culture|Get-UICulture|Get-Random)[ \t]*$/i
+  return output.test(command) || date.test(command) || query.test(command)
+}
+
+/** Stock resolves the final target and scans denies; add unknown-effect policy
+ * to its requests without replacing machine routing or pre-spawn validation. */
+export const authorizeShellRequests = Effect.fnUntraced(function* (deps: {
+  readonly invocation: ShellCreateBefore
+  readonly target: FileAccess.Target
+  readonly context: Tool.Context
+  readonly permission: Pick<Permission.Interface, "assert" | "assertNotDenied">
+  readonly requests: readonly Pick<Permission.AssertInput, "action" | "resources" | "save" | "metadata">[]
+}) {
+  const { invocation, target, context } = deps
+  const unknown = target.machine !== undefined || !hasNoFilesystemEffects(invocation.command, invocation.shell)
+  yield* deps.permission.assertNotDenied({
+    action: "shell", resources: [invocation.command], ...Permission.invocation(context),
+  })
+  const requests = unknown && !deps.requests.some((request) => request.action === "shell")
+    ? [...deps.requests, { action: "shell", resources: [invocation.command] }] : deps.requests
+  for (const request of requests) yield* deps.permission.assert({
+    ...request,
+    ...Permission.invocation(context),
+    metadata: request.action === "shell" && unknown ? {
+      ...request.metadata, filesystemEffects: "unknown",
+      unknownCommand: invocation.command, unknownCwd: target.absolute, unknownShell: invocation.shell,
+      // PATH/other environment changes must not silently reuse a named-command
+      // grant. Hash the final shell environment; never publish its secret values.
+      unknownLookup: createHash("sha256").update(JSON.stringify(
+        Object.entries(invocation.env).sort(([a], [b]) => a < b ? -1 : a > b ? 1 : 0),
+      )).digest("hex"),
+      ...(target.machine === undefined ? {} : { unknownMachine: target.machine }),
+    } : request.metadata,
+  })
+})
diff --git a/packages/core/src/personalize/title-request.ts b/packages/core/src/personalize/title-request.ts
new file mode 100644
index 0000000000000000000000000000000000000000..655e18271098ee5144a03e5228ad06db524ea0a1
--- /dev/null
+++ b/packages/core/src/personalize/title-request.ts
@@ -0,0 +1,44 @@
+import { Message, SystemPart } from "@opencode/ai/effect"
+import { TextBoundary } from "@opencode/util/text-boundary"
+import { Effect } from "effect"
+import type { SessionContext } from "../session/context.js"
+
+// User-approved naming policy. Hooks still run, and their redactions are kept.
+const instruction = "Summarize: one word, max 5 chars, no spaces."
+const outputLimit = 20
+const outputTokenKeys = new Set([
+  "maxTokens", "maxOutputTokens", "maxCompletionTokens", "max_tokens",
+  "max_output_tokens", "max_completion_tokens", "max_tokens_to_sample",
+])
+
+export const prepareTitle = Effect.fn("Personalize.prepareTitle")(function* (
+  context: SessionContext.Interface,
+  input: Parameters<SessionContext.Interface["request"]["title"]>[0],
+) {
+  const prepared = yield* context.request.title({ ...input, system: [SystemPart.make(instruction)] })
+  const safeText = prepared.request.messages
+    .flatMap((message) => message.role === "user" ? message.content : [])
+    .flatMap((part) => part.type === "text" ? [part.text] : [])
+    .join(" ")
+  const { maxTokens: requestedMaxTokens, ...request } = prepared.request
+  const baseURL = request.model.route.endpoint.baseURL
+  const codex = baseURL && URL.canParse(baseURL) && new URL(baseURL).origin === "https://chatgpt.com" &&
+    new URL(baseURL).pathname.startsWith("/backend-api/codex")
+  const maxTokens = codex ? undefined : Math.min(requestedMaxTokens ?? outputLimit, outputLimit)
+  const providerOptions = codex || !request.providerOptions
+    ? request.providerOptions
+    : Object.fromEntries(Object.entries(request.providerOptions).map(([key, value]) => [
+        key,
+        outputTokenKeys.has(key) && typeof value === "number" ? Math.min(value, outputLimit) : value,
+      ]))
+  return {
+    ...prepared,
+    request: {
+      ...request,
+      ...(maxTokens === undefined ? {} : { maxTokens }),
+      providerOptions,
+      system: [SystemPart.make(instruction)],
+      messages: [Message.user(TextBoundary.head(safeText, 1_000))],
+    },
+  }
+})
diff --git a/packages/core/test/permission/personalize.integration.test.ts b/packages/core/test/permission/personalize.integration.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..9402af9554cec436fd2d31c98319cc8ee5aaa421
--- /dev/null
+++ b/packages/core/test/permission/personalize.integration.test.ts
@@ -0,0 +1,968 @@
+import { expect, test } from "bun:test"
+import { Deferred, Effect, Exit, Fiber, Layer, Scope, Stream } from "effect"
+import { Agent } from "@opencode/core/agent"
+import { Database } from "@opencode/core/database/database"
+import { AppNodeBuilder } from "@opencode/core/effect/app-node-builder"
+import { LayerNode } from "@opencode/util/effect/layer-node"
+import { Bus } from "@opencode/core/bus"
+import { Location } from "@opencode/core/location"
+import { Permission } from "@opencode/core/permission"
+import { PermissionSaved } from "@opencode/core/permission/saved"
+import { Project } from "@opencode/core/project"
+import { ProjectTable } from "@opencode/core/project/sql"
+import { AbsolutePath } from "@opencode/core/schema"
+import { Session } from "@opencode/core/session"
+import { SessionTable } from "@opencode/core/session/sql"
+import { SessionStore } from "@opencode/core/session/store"
+import { Tool } from "@opencode/core/tool"
+import { readFacts, withFacts, type Facts } from "@opencode/schema/personalize/permission-policy"
+import { SessionEvent } from "@opencode/schema/session-event"
+import { hasNoFilesystemEffects } from "../../src/personalize/shell-permission"
+import { eq } from "drizzle-orm"
+import { location } from "../fixture/location"
+import { testEffect } from "../lib/effect"
+
+// Exercise the real permission service using the same public graph and fixture
+// boundaries as the upstream suite, without editing or importing that suite.
+const current = Layer.succeed(
+  Location.Service,
+  Location.Service.of(location({ directory: AbsolutePath.make("/project") })),
+)
+const it = testEffect(
+  AppNodeBuilder.build(
+    LayerNode.group([Database.node, Bus.node, SessionStore.node, PermissionSaved.node, Agent.node, Permission.node]),
+    [Location.node.replace(current), Bus.node.replace(Bus.configured({ persist: true }))],
+  ),
+)
+
+function setup(rules: Permission.Ruleset = [], sessionID = Session.ID.make("ses_test")) {
+  return Effect.gen(function* () {
+    const { db } = yield* Database.Service
+    yield* db.insert(ProjectTable)
+      .values({ id: Project.ID.global, worktree: AbsolutePath.make("/project"), sandboxes: [] })
+      .onConflictDoNothing().run().pipe(Effect.orDie)
+    yield* db.insert(SessionTable).values({
+      id: sessionID, project_id: Project.ID.global, slug: "test", directory: "/project",
+      title: "test", version: "test", agent: Agent.ID.make("test"),
+    }).onConflictDoNothing().run().pipe(Effect.orDie)
+    yield* setRules(rules)
+  })
+}
+
+function setRules(rules: Permission.Ruleset) {
+  return Effect.gen(function* () {
+    const agents = yield* Agent.Service
+    yield* agents.transform((editor) =>
+      editor.update(Agent.ID.make("test"), (agent) => { agent.permissions = [...rules] }),
+    )
+  })
+}
+
+type Assertion = Partial<Permission.AssertInput> & Partial<Facts>
+function assertion(input: Assertion = {}) {
+  const value = {
+    id: Permission.ID.create(),
+    sessionID: Session.ID.make("ses_test"),
+    action: "read",
+    resources: ["src/index.ts"],
+    ...input,
+  } satisfies Permission.AssertInput
+  const facts = readFacts(value)
+  return facts ? withFacts(value, facts) : value
+}
+
+function waitForRequest(input: Assertion = {}) {
+  return Effect.gen(function* () {
+    const value = assertion(input)
+    const service = yield* Permission.Service
+    const bus = yield* Bus.Service
+    const asked = yield* Deferred.make<Permission.Request>()
+    const unsubscribe = yield* bus.listen((event) => {
+      if (event.type !== Permission.Event.Asked.type) return Effect.void
+      const request = event.data as Permission.Request
+      return request.id === value.id ? Deferred.succeed(asked, request).pipe(Effect.asVoid) : Effect.void
+    })
+    yield* Effect.addFinalizer(() => unsubscribe)
+    const fiber = yield* service.assert(value).pipe(Effect.forkScoped)
+    const request = yield* Deferred.await(asked)
+    return { service, fiber, request }
+  })
+}
+
+it.effect("owned facts survive stock request publication and lookup without extra wire fields", () =>
+  Effect.gen(function* () {
+    yield* setup()
+    const first = yield* waitForRequest({
+      operations: ["read"], paths: ["/project/file"], directories: ["/project"], access: "content",
+    })
+    for (const value of [first.request, yield* first.service.get(first.request.id)]) {
+      expect(value).toBeDefined()
+      expect(readFacts(value!)).toEqual({
+        operations: ["read"], paths: ["/project/file"], directories: ["/project"], access: "content",
+      })
+      expect("operations" in value!).toBe(false)
+      expect("paths" in value!).toBe(false)
+      expect("directories" in value!).toBe(false)
+    }
+    yield* first.service.reply({ requestID: first.request.id, reply: "once" })
+    yield* Fiber.join(first.fiber)
+  }),
+)
+
+it.effect("shell CRUD policy persists without approving the pending PowerShell program", () =>
+  Effect.gen(function* () {
+    yield* setup()
+    const command = "[IO.File]::ReadAllBytes($p)"
+    const first = yield* waitForRequest({
+      action: "shell", resources: [command], metadata: {
+        filesystemEffects: "unknown", unknownCommand: command,
+        unknownCwd: "/project", unknownShell: "powershell.exe",
+      },
+    })
+    yield* first.service.reply({
+      requestID: first.request.id, reply: { scope: "session", policy: "RU=S* CD=D*" },
+    })
+    expect((yield* first.service.list()).some((request) => request.id === first.request.id)).toBe(true)
+    const sessions = yield* SessionStore.Service
+    const rules = (yield* sessions.get(first.request.sessionID))!.permissions!
+    expect(rules.filter((rule) => rule.action === "__opencode_filesystem_session_v1")).toHaveLength(4)
+    expect(rules.some((rule) => rule.action === "__opencode_shell_unknown_v1")).toBe(false)
+    expect((yield* first.service.ask(assertion({
+      action: "read", operations: ["read"], paths: ["/project/file"], directories: ["/project"],
+    }))).effect).toBe("allow")
+    expect((yield* first.service.ask(assertion({
+      action: "edit", operations: ["create"], paths: ["/project/new"], directories: ["/project"],
+    }))).effect).toBe("deny")
+    yield* first.service.reply({ requestID: first.request.id, reply: { scope: "session", policy: "Unknown=1" } })
+    yield* Fiber.join(first.fiber)
+  }),
+)
+
+it.effect("CRUD settlements retain machine identity and never overwrite another environment's grant", () =>
+  Effect.gen(function* () {
+    yield* setup()
+    const facts = { operations: ["read"] as const, paths: ["/work/file"], directories: ["/work"], access: "content" as const }
+    const local = yield* waitForRequest(facts)
+    yield* local.service.reply({ requestID: local.request.id, reply: { scope: "session", policy: "R=S*" } })
+    yield* Fiber.join(local.fiber)
+    const remote = yield* waitForRequest({ ...facts, machine: "gpu", resources: ["gpu:/work/file"] })
+    expect(readFacts(remote.request)?.machine).toBe("gpu")
+    yield* remote.service.reply({ requestID: remote.request.id, reply: { scope: "session", policy: "R=D*" } })
+    expect(Exit.isFailure(yield* Fiber.await(remote.fiber))).toBe(true)
+    expect((yield* local.service.ask(assertion(facts))).effect).toBe("allow")
+    expect((yield* local.service.ask(assertion({ ...facts, machine: "gpu" }))).effect).toBe("deny")
+    expect((yield* local.service.ask(assertion({ ...facts, machine: "other" }))).effect).toBe("ask")
+    const store = yield* SessionStore.Service
+    const rules = (yield* store.get(local.request.sessionID))!.permissions!
+    expect(rules.filter((rule) => rule.action === "__opencode_filesystem_session_v1")).toHaveLength(2)
+  }),
+)
+
+for (const policy of ["Unknown=S", "Unknown=SE", "Unknown=SEA"]) {
+  it.effect(`${policy} settlements cannot approve the same executable on another machine`, () =>
+    Effect.gen(function* () {
+      yield* setup([{ action: "*", resource: "*", effect: "allow" }])
+      const input = { action: "shell", resources: ["runner"], metadata: {
+        filesystemEffects: "unknown", unknownCommand: "& 'C:/Tools/runner.exe' test/a.ts",
+        unknownCwd: "C:/work", unknownShell: "powershell.exe", unknownMachine: "gpu",
+      } }
+      const first = yield* waitForRequest(input)
+      yield* first.service.reply({ requestID: first.request.id, reply: { scope: "session", policy } })
