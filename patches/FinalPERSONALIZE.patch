+import type { Info } from "../service"
+
+export function decorate(stock: typeof import("../service-probe")) {
+  const decide: typeof stock.decide = (service, options) => {
+    const state = service && typeof service === "object" ? Reflect.get(service, "state") : undefined
+    return state === "waiting" || state === "retrying" ? { _tag: "wait" } : stock.decide(service, options)
+  }
+  const probeResult: typeof stock.probeResult = async (info: Info, timeout) => {
+    const result = await stock.probeResult(info, timeout)
+    if (result.service || result.timedOut) return result
+    // A registered owner must not be killed merely because the published version
+    // changes while that same PID is starting. All other stock health rules stay intact.
+    const endpoint = { url: info.url, auth: info.password === undefined ? undefined : {
+      type: "basic" as const, username: "opencode", password: info.password,
+    } }
+    try {
+      const response = await fetch(new URL("/api/info", info.url), {
+        headers: stock.headers(endpoint), signal: AbortSignal.timeout(timeout ?? 1000),
+      })
+      if (response.status !== 503) return result
+      const body: unknown = await response.json()
+      if (!body || typeof body !== "object" || !("pid" in body) || body.pid !== info.pid ||
+          !("version" in body) || typeof body.version !== "string") return result
+      return { timedOut: false, service: { info, endpoint, version: body.version,
+        state: "waiting" as const, compatible: true } }
+    } catch { return result }
+  }
+  return { decide, probeResult }
+}
diff --git a/packages/core/src/personalize/content.ts b/packages/core/src/personalize/content.ts
new file mode 100644
index 0000000000000000000000000000000000000000..031c11b3c2aa19dbbc190db469d7432c3abcced8
--- /dev/null
+++ b/packages/core/src/personalize/content.ts
@@ -0,0 +1,35 @@
+import type { Message } from "@opencode/ai/effect"
+import type { SessionMessage } from "../session/message"
+
+export function copyWith<T extends object>(value: T, changes: Partial<T>): T {
+  const descriptors = Object.getOwnPropertyDescriptors(value)
+  for (const [key, replacement] of Object.entries(changes)) {
+    const before = Object.getOwnPropertyDescriptor(value, key)
+    Object.defineProperty(descriptors, key, { enumerable: true, configurable: true, value: {
+      value: replacement, enumerable: before?.enumerable ?? true,
+      configurable: before?.configurable ?? true, writable: before && "writable" in before ? before.writable : true,
+    } })
+  }
+  return Object.create(Object.getPrototypeOf(value), descriptors)
+}
+
+export function canonicalMessages(messages: unknown): Message[] {
+  if (!Array.isArray(messages)) return []
+  return messages.filter((message) => message && typeof message === "object").map((message) => {
+    const content = (Array.isArray(message.content) ? message.content : []).filter(Boolean).map((part) =>
+      part.type === "tool-result" && part.result?.type === "content" && !Array.isArray(part.result.value)
+        ? copyWith(part, { result: copyWith(part.result, { value: [] }) }) : part)
+    return Array.isArray(message.content) && content.length === message.content.length && content.every((part, i) => part === message.content[i])
+      ? message : copyWith(message, { content })
+  })
+}
+
+export function historyMessages(messages: readonly SessionMessage.Info[]): SessionMessage.Info[] {
+  return messages.map((message) => {
+    const content = (Array.isArray(message.content) ? message.content : []).filter(Boolean).map((part) =>
+      part.type === "tool" && part.state?.status === "completed" && !Array.isArray(part.state.content)
+        ? copyWith(part, { state: copyWith(part.state, { content: [] }) }) : part)
+    return Array.isArray(message.content) && content.length === message.content.length && content.every((part, i) => part === message.content[i])
+      ? message : copyWith(message, { content })
+  })
+}
