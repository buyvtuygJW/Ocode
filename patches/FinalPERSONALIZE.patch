@@ -0,0 +1,61 @@
+import { expect } from "bun:test"
+import { Effect } from "effect"
+import type { PermissionReplyInput } from "@opencode/client/promise"
+import { it } from "../../core/test/lib/effect"
+import { tmpdirScoped } from "../../core/test/fixture/tmpdir"
+import { ServerFetch } from "../src/fetch"
+
+it.live("invalid permission policies retain the request and return the standard typed HTTP error without a grant", () =>
+  Effect.gen(function* () {
+    const directory = yield* tmpdirScoped("permission-policy-http-")
+    const handler = yield* ServerFetch.make({
+      app: { version: "test" }, database: { path: ":memory:" },
+      fs: { filewatcher: false }, models: { fetch: false },
+      config: { directory: directory.path, project: false, content: "{}" },
+    })
+    const request = (route: string, method: string, body?: unknown) => Effect.promise(async () => {
+      const url = new URL(route, "http://opencode.local")
+      url.searchParams.set("location[directory]", directory.path)
+      const response = await handler(new Request(url, {
+        method, headers: { "content-type": "application/json" },
+        body: body === undefined ? undefined : JSON.stringify(body),
+      }))
+      return { status: response.status, body: response.status === 204 ? undefined : await response.json() }
+    })
+    const created = yield* request("/api/session", "POST", {
+      permissions: [{ action: "shell", resource: "*", effect: "ask" }],
+    })
+    expect(created.status).toBe(200)
+    const sessionID = created.body.data.id
+    const route = `/api/session/${sessionID}/permission`
+    const command = "& 'C:/Tools/runner.exe' --test 'C:/project/test/a.test.ts'"
+    const input = {
+      action: "shell", resources: [command],
+      metadata: { filesystemEffects: "unknown", unknownCommand: command,
+        unknownCwd: "C:/project", unknownShell: "powershell.exe" },
+    }
+    const ask = yield* request(route, "POST", input)
+    expect(ask.status).toBe(200)
+    expect(ask.body.data.effect).toBe("ask")
+    const requestID = ask.body.data.id
+    for (const policy of ["Unknown=S*", "Unknown=SE*", "Unknown=SEA*", "Unknown=E"]) {
+      const decision = { scope: "session", policy } satisfies PermissionReplyInput["decision"]
+      const failed = yield* request(`${route}/${requestID}/reply`, "POST", { decision })
+      expect(failed.status).toBe(400)
+      expect(failed.body).toMatchObject({ _tag: "InvalidRequestError", kind: "permission_policy", field: "decision" })
+      expect(failed.body.message.length).toBeGreaterThan(0)
+      expect((yield* request(`${route}/${requestID}`, "GET")).status).toBe(200)
+      const repeated = yield* request(route, "POST", input)
+      expect(repeated.body.data.effect).toBe("ask")
+      expect((yield* request(`/api/session/${sessionID}`, "GET")).body.data.permissions).toEqual(created.body.data.permissions)
+      expect((yield* request("/api/permission/saved", "GET")).body.data).toEqual([])
+    }
+    // Positive control exercises the same HTTP transport, schema, handler and
+    // real permission service; only an explicit valid decision may authorize.
+    const decision = { scope: "session", policy: "Unknown=S" } satisfies PermissionReplyInput["decision"]
+    expect((yield* request(`${route}/${requestID}/reply`, "POST", { decision })).status).toBe(204)
+    expect((yield* request(route, "POST", input)).body.data.effect).toBe("allow")
+    expect((yield* request(route, "POST", { ...input, resources: [command + " --watch"],
+      metadata: { ...input.metadata, unknownCommand: command + " --watch" } })).body.data.effect).toBe("ask")
+  }).pipe(Effect.scoped),
+)
diff --git a/packages/tui/src/personalize/mini-permission-controls.tsx b/packages/tui/src/personalize/mini-permission-controls.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..75ce34d2fdb2532d9c0f0041cc0105e0fe5742a7
--- /dev/null
+++ b/packages/tui/src/personalize/mini-permission-controls.tsx
@@ -0,0 +1,195 @@
+/** @jsxImportSource @opentui/solid */
+import { TextAttributes, type ScrollBoxRenderable, type TextareaRenderable } from "@opentui/core"
+import { useKeyboard, useTerminalDimensions } from "@opentui/solid"
+import { createEffect, createMemo, createSignal, For, onCleanup, Show, type JSX } from "solid-js"
+import { createPermissionController } from "@opencode/schema/personalize/permission-controller"
+import { policyDirectories, policyHint, policyText, readFacts, unknownShell } from "@opencode/schema/personalize/permission-policy"
+import { createPermissionBodyState, permissionCancel, permissionEscape, permissionHover, permissionLabel,
+  permissionOptions, permissionReject, permissionRun, permissionShift, type PermissionOption, type PermissionReply } from "./mini-permission"
+import type { MiniPermissionRequest } from "../mini/types"
+import { transparent, type RunFooterTheme } from "../mini/theme"
+import { stringWidth } from "../util/string-width"
+
+type FieldProps = {
+  theme: RunFooterTheme; text: string; disabled: boolean
+  onChange: (text: string) => void; onConfirm: () => void; onCancel: () => void
+}
+
+/** Decision chrome only: the caller retains stock request/diff/scroll rendering. */
+export function createMiniPermissionView(
+  props: { request: MiniPermissionRequest; theme: RunFooterTheme; mono?: boolean; onReply: (input: PermissionReply) => void | Promise<void> },
+  scroll: () => ScrollBoxRenderable | undefined,
+  RejectField: (props: FieldProps) => JSX.Element,
+) {
+  const dims = useTerminalDimensions()
+  const [size, setSize] = createSignal(dims())
+  const width = () => size().width
+  const compact = () => width() < 56 || size().height < 12
+  const scrollbar = createMemo(() => ({
+    visible: !props.mono,
+    trackOptions: { backgroundColor: props.theme.surface, foregroundColor: props.theme.line },
+  }))
+  const [state, setState] = createSignal(createPermissionBodyState(props.request))
+  const controller = createPermissionController(props.request, {
+    send: (reply) => props.onReply(reply),
+    changed: (next) => setState((prev) => ({ ...prev, stage: next.stage, message: next.message,
+      submitting: next.status !== "idle", error: next.error })),
+  })
+  onCleanup(() => controller.dispose())
+  const stage = createMemo(() => state().stage)
+  const unknown = () => unknownShell(props.request)
+  const busy = () => state().submitting
+  const opts = createMemo(() => {
+    props.request.id
+    props.request.sessionID
+    state().requestID
+    state().sessionID
+    return stage() === "permission" ? [...controller.choices()] : permissionOptions(stage())
+  })
+  const label = (option: PermissionOption) => permissionLabel(option, unknown())
+  const controlsWidth = () => opts().reduce((sum, option) => sum + stringWidth(label(option)) + 3, -1)
+  const hint = () => compact() && width() < 56 ? "pgup/pgdn scroll"
+    : `${props.mono ? "left/right" : "⇆"} select  enter confirm  esc ${stage() === "always" ? "cancel" : "reject"}`
+  const inline = () => controlsWidth() + stringWidth(hint()) + 1 <= width() - (compact() ? 0 : 5)
+  const title = () => stage() === "policy" ? "Session CRUD policy" : stage() === "always" ? "Always allow"
+    : stage() === "reject" ? (width() < 24 ? "Reject" : "Reject permission")
+    : width() < 24 ? "Permission" : "Permission required"
+  createEffect(() => {
+    const request = props.request
+    if (state().requestID === request.id && state().sessionID === request.sessionID) return
+    setState(createPermissionBodyState(request))
+    controller.replaceRequest(request)
+  })
+  createEffect(() => {
+    stage()
+    props.request.id
+    const current = scroll()
+    if (current && !current.isDestroyed) current.scrollTo(0)
+  })
+  const submit = (reply: PermissionReply) => controller.submit(reply.decision, reply.message)
+  const run = (option: PermissionOption) => {
+    if (busy() || !opts().includes(option)) return
+    if (option === "reject" && unknown() && stage() === "permission") {
+      controller.submit("reject")
+      return
+    }
+    const before = state()
+    const next = permissionRun(before, props.request.id, option)
+    if (next.state !== before) {
+      setState(next.state)
+      if (next.state.stage !== before.stage) controller.open(next.state.stage)
+    }
+    if (next.reply) submit(next.reply)
+  }
+  const confirm = () => {
+    const reply = permissionReject(state(), props.request.id)
+    if (reply) submit(reply)
+  }
+  const cancel = () => {
+    if (busy()) return
+    setState((previous) => permissionCancel(previous))
+    controller.open("permission")
+  }
+  useKeyboard((event) => {
+    const current = state()
+    if (current.stage === "reject" || current.stage === "policy") return
+    if (event.name === "pageup" || event.name === "pagedown") {
+      scroll()?.scrollBy(event.name === "pageup" ? -1 : 1, "viewport")
+      event.preventDefault()
+      return
+    }
+    if (current.submitting) {
+      if (["left", "right", "h", "l", "tab", "return", "escape"].includes(event.name)) event.preventDefault()
+      return
+    }
+    const shift = (direction: -1 | 1) => setState((previous) => permissionShift(previous, direction, opts()))
+    if (event.name === "tab") shift(event.shift ? -1 : 1)
+    else if (event.name === "left" || event.name === "h") shift(-1)
+    else if (event.name === "right" || event.name === "l") shift(1)
+    else if (event.name === "return") run(state().selected)
+    else if (event.name === "escape") {
+      if (unknown() && current.stage === "permission") controller.submit("reject")
+      else {
+        const next = permissionEscape(current)
+        setState(next)
+        controller.open(next.stage)
+      }
+    } else return
+    event.preventDefault()
+  })
+  function Frame(input: { children: JSX.Element }) {
+    const editing = () => stage() === "reject" || stage() === "policy"
+    return <box width="100%" height="100%" minHeight={0} flexDirection="column" backgroundColor={props.theme.surface}
+      onSizeChange={function () { setSize({ width: this.width, height: this.height }) }}>
+      <box paddingLeft={compact() ? 0 : 2} paddingRight={compact() ? 0 : 3}
+        paddingTop={compact() ? 0 : 1} paddingBottom={compact() ? 0 : 1} gap={compact() ? 0 : 1} flexShrink={0}>
+        <text height={1} fg={props.theme.text} wrapMode="none" truncate>
+          <span style={{ fg: props.theme.permission }}>{props.mono ? "! " : "△ "}</span>
+          {title()}{readFacts(props.request)?.operations.length ? ` · ${readFacts(props.request)!.operations.join("/")}` : ""}
+        </text>
+        <Show when={!compact() && editing()}>
+          <text fg={props.theme.muted}>{stage() === "policy" ? policyHint(unknown(), props.request) : "Tell OpenCode what to do differently"}</text>
+        </Show>
+        <Show when={state().error}><text fg={props.theme.permission}>{state().error}</text></Show>
+        <Show when={stage() === "permission" && unknown()}>
+          <text fg={props.theme.permission}>Unknown effects may bypass filesystem denies.</text>
+        </Show>
+        <Show when={stage() === "policy" || stage() === "permission"}>
+          <For each={policyDirectories(props.request)}>{(directory) => <text fg={props.theme.text}>{directory}</text>}</For>
+        </Show>
+      </box>
+      <Show when={!editing()} fallback={
+        <box width="100%" flexGrow={1} minHeight={0} justifyContent="flex-end">
+          <box backgroundColor={props.theme.line} paddingLeft={compact() ? 0 : 2} paddingRight={compact() ? 0 : 3}
+            paddingTop={compact() ? 0 : 1} paddingBottom={compact() ? 0 : 1} gap={1}>
+            <Show when={stage() === "policy"} fallback={
+              <RejectField theme={props.theme} text={state().message} disabled={busy()}
+                onChange={(text) => controller.setMessage(text)} onConfirm={confirm} onCancel={cancel} />
+            }>
+              <PolicyField theme={props.theme} text={state().message} disabled={busy()}
+                placeholder={unknown() ? `${policyText.placeholder} / ${policyText.unknownPlaceholder}` : policyText.placeholder}
+                onChange={(text) => controller.setMessage(text)} onConfirm={confirm} onCancel={cancel} />
+            </Show>
+            <text fg={props.theme.muted}>{busy() ? "Waiting for permission event…" : "enter confirm  esc cancel"}</text>
+          </box>
+        </box>
+      }>
+        {input.children}
+        <box width="100%" flexDirection={inline() ? "row" : "column"} justifyContent="space-between"
+          gap={compact() ? 0 : 1} paddingLeft={compact() ? 0 : 2} paddingRight={compact() ? 0 : 3}
+          paddingTop={compact() ? 0 : 1} paddingBottom={compact() ? 0 : 1} flexShrink={0} backgroundColor={props.theme.pane}>
+          <box width={inline() ? controlsWidth() : "100%"} flexDirection="row" flexWrap="wrap" columnGap={1} flexShrink={0}>
+            <For each={opts()}>{(option) => (
+              <box width={stringWidth(label(option)) + 2} height={1} flexShrink={0} paddingLeft={1} paddingRight={1}
+                backgroundColor={option === state().selected ? props.theme.actionFocusedBg : transparent}
+                onMouseMove={() => { if (!busy()) setState((before) => permissionHover(before, option)) }}
+                onMouseUp={() => run(option)}>
+                <text wrapMode="none" fg={option === state().selected ? props.theme.actionFocusedText : props.theme.actionSecondaryText}
+                  attributes={option === state().selected && props.mono ? TextAttributes.INVERSE : undefined}>
+                  {label(option)}
+                </text>
+              </box>
+            )}</For>
+          </box>
+          <text fg={busy() ? props.theme.running : props.theme.text} height={1} wrapMode="none" truncate flexShrink={0}>
+            {busy() ? (compact() ? "Waiting…" : "Waiting for permission event…") : hint()}
+          </text>
+        </box>
+      </Show>
+    </box>
+  }
+  return { width, compact, stage, scrollbar, Frame }
+}
+
+function PolicyField(props: FieldProps & { placeholder: string }) {
+  let input: TextareaRenderable | undefined
+  return <textarea width="100%" minHeight={1} maxHeight={3} wrapMode="word"
+    placeholder={props.placeholder} placeholderColor={props.theme.muted}
+    textColor={props.theme.formfieldText} focusedTextColor={props.theme.formfieldFocusedText}
+    backgroundColor={props.theme.surface} focusedBackgroundColor={props.theme.formfieldFocusedBg}
+    cursorColor={props.theme.formfieldFocusedText} focused={!props.disabled}
+    ref={(value) => { input = value; value.setText(props.text) }}
+    onContentChange={() => { if (input && !input.isDestroyed && !props.disabled) props.onChange(input.plainText) }}
+    onSubmit={() => { if (!props.disabled) props.onConfirm() }}
+    onKeyDown={(event) => { if (event.name === "escape") { event.preventDefault(); if (!props.disabled) props.onCancel() } }} />
+}
diff --git a/packages/tui/src/personalize/mini-permission.ts b/packages/tui/src/personalize/mini-permission.ts
new file mode 100644
index 0000000000000000000000000000000000000000..4297716fe0a3b090b2e7f7b1b5ed0f2bfe2ef3df
--- /dev/null
+++ b/packages/tui/src/personalize/mini-permission.ts
@@ -0,0 +1,71 @@
+import * as stock from "../mini/permission.shared"
+import type { MiniPermissionRequest } from "../mini/types"
+import { choiceLabel, choices, type Choice } from "@opencode/schema/personalize/permission-policy"
+import type { PermissionDecision } from "@opencode/schema/personalize/permission-controller"
+
+export { permissionAlwaysLines, permissionInfo } from "../mini/permission.shared"
+export type PermissionStage = stock.PermissionStage | "policy"
+export type PermissionOption = Choice | "confirm" | "cancel"
+export type PermissionBodyState = Omit<stock.PermissionBodyState, "stage" | "selected"> & {
+  stage: PermissionStage
+  selected: PermissionOption
+  error?: string
+}
+export type PermissionReply = {
+  sessionID: string
+  requestID: string
+  decision: PermissionDecision
+  message?: string
+}
+export type PermissionStep = { state: PermissionBodyState; reply?: PermissionReply }
+
+export const createPermissionBodyState = (request: Pick<MiniPermissionRequest, "id" | "sessionID">): PermissionBodyState =>
+  stock.createPermissionBodyState(request)
+export const permissionOptions = (stage: PermissionStage, request?: MiniPermissionRequest): PermissionOption[] =>
+  stage === "policy" ? [] : stage === "permission" && request ? [...choices(request)] : stock.permissionOptions(stage)
+export const permissionLabel = (option: PermissionOption, unknown = false) =>
+  option === "confirm" || option === "cancel" ? stock.permissionLabel(option) : choiceLabel(option, unknown, stock.permissionLabel)
+
+// Only the custom policy/shortcut branches are owned here. Ordinary stage
+// transitions and request presentation keep using the unmodified stock module.
+function stockState(state: PermissionBodyState): stock.PermissionBodyState {
+  return { ...state, stage: state.stage === "policy" ? "reject" : state.stage,
+    selected: state.selected === "policy" || state.selected === "session_read" ? "once" : state.selected }
+}
+function stockReply(reply: stock.PermissionStep["reply"]): PermissionReply | undefined {
+  if (!reply) return
+  if (reply.decision !== "once" && reply.decision !== "always" && reply.decision !== "reject")
+    throw new Error("Unsupported stock permission decision")
+  return { ...reply, decision: reply.decision, message: reply.message ?? undefined }
+}
+export function permissionRun(state: PermissionBodyState, requestID: string, option: PermissionOption): PermissionStep {
+  if (state.submitting) return { state }
+  if (state.stage === "permission" && option === "policy")
+    return { state: { ...state, stage: "policy", message: "", error: undefined } }
+  if (state.stage === "permission" && option === "session_read")
+    return { state, reply: { sessionID: state.sessionID, requestID, decision: option } }
+  if (option === "policy" || option === "session_read" || state.stage === "policy" ||
+    (state.stage === "permission" && option !== "once" && option !== "always" && option !== "reject") ||
+    (state.stage === "always" && option !== "confirm" && option !== "cancel"))
+    return { state }
+  const result = stock.permissionRun(stockState(state), requestID, option)
+  return { state: result.state, reply: stockReply(result.reply) }
+}
+export function permissionReject(state: PermissionBodyState, requestID: string): PermissionReply | undefined {
+  if (state.submitting) return
+  if (state.stage === "policy") return {
+    sessionID: state.sessionID, requestID, decision: { scope: "session", policy: state.message.trim() },
+  }
+  return stockReply(stock.permissionReject(stockState(state), requestID))
+}
+export const permissionCancel = (state: PermissionBodyState): PermissionBodyState =>
+  ({ ...stock.permissionCancel(stockState(state)), error: undefined })
+export const permissionEscape = (state: PermissionBodyState): PermissionBodyState =>
+  stock.permissionEscape(stockState(state))
+export const permissionHover = (state: PermissionBodyState, selected: PermissionOption): PermissionBodyState =>
+  ({ ...state, selected })
+export function permissionShift(state: PermissionBodyState, dir: -1 | 1, list = permissionOptions(state.stage)): PermissionBodyState {
+  if (!list.length) return state
+  const index = Math.max(0, list.indexOf(state.selected))
+  return { ...state, selected: list[(index + dir + list.length) % list.length] }
+}
diff --git a/packages/tui/src/personalize/permission-view.tsx b/packages/tui/src/personalize/permission-view.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..ec4b6460becb5d20fa29ac73a2471883e64a069a
--- /dev/null
+++ b/packages/tui/src/personalize/permission-view.tsx
@@ -0,0 +1,145 @@
+import { createEffect, createMemo, createSignal, For, onCleanup, Show, type JSX } from "solid-js"
+import type { TextareaRenderable } from "@opentui/core"
+import type { PermissionRequest } from "@opencode/client"
+import { createPermissionController } from "@opencode/schema/personalize/permission-controller"
+import { choiceLabel, policyDirectories, policyHint, policyText, readFacts, unknownShell } from "@opencode/schema/personalize/permission-policy"
+import { useData } from "../context/data"
+import { usePathFormatter } from "../context/path-format"
+import { useTheme } from "../context/theme"
+import { useToast } from "../ui/toast"
+import { useCursorStyle } from "../config"
+import { useInteractivity } from "../context/interactivity"
+import { Keymap } from "../context/keymap"
+import { permissionAlwaysLines, permissionOptionLabel } from "../util/permission"
+import { SplitBorder } from "../ui/border"
+import type { SessionQuestion, permissionSemanticLabel } from "../routes/session/permission"
+
+/** Own only decision state/navigation. Stock renders request details and diffs. */
+export function createPermissionView(
+  props: { request: PermissionRequest },
+  stock: {
+    Question: typeof SessionQuestion
+    Reject: (props: { action: string; instance: string; onConfirm: (text: string) => void; onCancel: () => void }) => JSX.Element
+    label: typeof permissionSemanticLabel
+  },
+) {
+  const data = useData()
+  const pathFormatter = usePathFormatter()
+  const theme = useTheme()
+  const toast = useToast()
+  const [state, setState] = createSignal({ stage: "permission", status: "idle", error: undefined as string | undefined })
+  const controller = createPermissionController(props.request, {
+    send: (reply) => data.session.permission.reply(reply),
+    changed: (next) => setState({ stage: next.stage, status: next.status, error: next.error }),
+    report: (error) => toast.error(error),
+  })
+  onCleanup(() => controller.dispose())
+  createEffect(() => { controller.replaceRequest(props.request) })
+  const busy = () => state().status !== "idle"
+  const unknown = () => unknownShell(props.request)
+  const source = createMemo(() => {
+    const tool = props.request.source
+    if (!tool) return { input: undefined, metadata: undefined }
+    const message = data.session.message.get(props.request.sessionID, tool.messageID)
+    if (message?.type !== "assistant") return { input: undefined, metadata: undefined }
+    const part = message.content.find((part) => part.type === "tool" && part.id === tool.id)
+    if (part?.type === "tool" && part.state.status !== "streaming")
+      return { input: part.state.input, metadata: part.state.metadata }
+    return { input: undefined, metadata: undefined }
+  })
+  const open = (stage: "permission" | "reject" | "policy") => { if (!busy()) controller.open(stage) }
+  function Frame(input: { children: () => JSX.Element }) {
+    return (
+      <Show when={JSON.stringify([props.request.sessionID, props.request.id])} keyed>
+        {(_identity) => (
+          <Show when={state().stage === "permission"} fallback={
+            <box flexDirection="column">
+              <Show when={state().error}><text fg={theme.text.feedback.error.base}>{state().error}</text></Show>
+              <Show when={busy()}><text fg={theme.text.muted}>Waiting for permission event…</text></Show>
+              <Show when={state().stage === "policy"} fallback={
+                <stock.Reject action={props.request.action} instance={props.request.id}
+                  onConfirm={(message) => { if (!busy()) controller.submit("reject", message || undefined) }}
+                  onCancel={() => open("permission")} />
+              }>
+                <PolicyInput request={props.request} busy={busy()}
+                  onConfirm={(text) => controller.submit({ scope: "session", policy: text })}
+                  onCancel={() => open("permission")} />
+              </Show>
+            </box>
+          }>
+            {input.children()}
+          </Show>
+        )}
+      </Show>
+    )
+  }
+  function question(input: { header: JSX.Element; body: () => JSX.Element; title?: string }) {
+    return (
+      <stock.Question title="Permission required" semanticLabel={stock.label(props.request.action, input.title)}
+        instance={props.request.id} escapeKey="reject" fullscreen
+        header={<box flexDirection="column">
+          {input.header}
+          <Show when={readFacts(props.request)?.operations.length}>
+            <text fg={theme.text.muted}>{readFacts(props.request)!.operations.join("/")}</text>
+          </Show>
+          <Show when={state().error}><text fg={theme.text.feedback.error.base}>{state().error}</text></Show>
+          <Show when={unknown()}><text fg={theme.text.feedback.warning.base}>Unknown effects may bypass filesystem denies.</text></Show>
+          <For each={policyDirectories(props.request)}>{(directory) => <text fg={theme.text.base}>{directory}</text>}</For>
+        </box>}
+        body={(option) => <Show when={option === "always"} fallback={input.body()}>
+          <box paddingLeft={1} gap={1}>
+            <For each={permissionAlwaysLines(props.request)}>
+              {(line, index) => <text fg={index() === 0 ? theme.text.muted : theme.text.base}>{line}</text>}
+            </For>
+          </box>
+        </Show>}
+        options={Object.fromEntries(controller.choices().map((choice) =>
+          [choice, choiceLabel(choice, unknown(), permissionOptionLabel)]))}
+        onSelect={(option) => {
+          if (busy()) return
+          if (option === "policy") return open("policy")
+          if (option === "reject" && !unknown() && data.session.get(props.request.sessionID)?.parentID)
+            return open("reject")
+          if (option === "once" || option === "always" || option === "reject" || option === "session_read")
+            controller.submit(option)
+        }} />
+    )
+  }
+  return { source, pathFormatter, Frame, question }
+}
+
+function PolicyInput(props: {
+  request: PermissionRequest
+  busy: boolean
+  onConfirm: (text: string) => void
+  onCancel: () => void
+}) {
+  const theme = useTheme()
+  const cursor = useCursorStyle()
+  const enabled = useInteractivity()
+  let input: TextareaRenderable | undefined
+  const confirm = () => { if (!props.busy && input) props.onConfirm(input.plainText) }
+  const cancel = () => { if (!props.busy) props.onCancel() }
+  Keymap.createLayer(() => ({
+    mode: "base",
+    commands: [
+      { bind: "return", title: "Apply permission policy", group: "Permission", run: confirm },
+      { bind: "escape", title: "Cancel permission policy", group: "Permission", run: cancel },
+      { id: "app.exit", title: "Cancel permission policy", group: "Permission", run: cancel },
+    ],
+  }))
+  return <box flexDirection="column" backgroundColor={theme.background.raised.base}
+    border={["left"]} borderColor={theme.text.feedback.error.base} customBorderChars={SplitBorder.customBorderChars}
+    paddingLeft={2} paddingRight={3} paddingTop={1} paddingBottom={1} gap={1}>
+    <text fg={theme.text.base}>Session CRUD policy</text>
+    <For each={policyDirectories(props.request)}>{(directory) => <text fg={theme.text.base}>{directory}</text>}</For>
+    <text fg={theme.text.muted}>{policyHint(unknownShell(props.request), props.request)}</text>
+    <textarea ref={(value) => { input = value }} minHeight={1} maxHeight={3} focused={enabled() && !props.busy}
+      placeholder={unknownShell(props.request) ? `${policyText.placeholder} / ${policyText.unknownPlaceholder}` : policyText.placeholder}
+      textColor={theme.text.base} focusedTextColor={theme.text.base} cursorColor={theme.text.base} cursorStyle={cursor()} />
+    <box flexDirection="row" gap={2}>
+      <text fg={theme.text.base} onMouseUp={confirm}>enter apply policy</text>
+      <text fg={theme.text.muted} onMouseUp={cancel}>esc cancel</text>
+    </box>
+  </box>
+}
diff --git a/packages/tui/test/personalize-mini-permission.test.ts b/packages/tui/test/personalize-mini-permission.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..d1221bf3595ce88d4c653a0bc9d3638afdb43b6b
--- /dev/null
+++ b/packages/tui/test/personalize-mini-permission.test.ts
@@ -0,0 +1,59 @@
+import { expect, test } from "bun:test"
+import * as stock from "../src/mini/permission.shared"
+import * as policy from "../src/personalize/mini-permission"
+import type { MiniPermissionRequest } from "../src/mini/types"
+import { withFacts } from "@opencode/schema/personalize/permission-policy"
+
+const request: MiniPermissionRequest = {
+  id: "per_policy", sessionID: "ses_policy", action: "shell", resources: ["runner"],
+  metadata: { filesystemEffects: "unknown", unknownCommand: "runner", unknownCwd: "C:/work", unknownShell: "powershell.exe" },
+}
+
+test("Mini policy adapter reuses pristine presentation and ordinary transitions", () => {
+  expect(policy.permissionInfo).toBe(stock.permissionInfo)
+  expect(policy.permissionAlwaysLines).toBe(stock.permissionAlwaysLines)
+  const initial = policy.createPermissionBodyState(request)
+  expect(initial).toEqual(stock.createPermissionBodyState(request))
+  for (const choice of ["once", "always", "reject"] as const) {
+    const actual = policy.permissionRun(initial, request.id, choice)
+    const expected = stock.permissionRun(stock.createPermissionBodyState(request), request.id, choice)
+    expect(actual.state).toEqual(expected.state)
+    expect(String(actual.reply?.decision)).toBe(String(expected.reply?.decision))
+  }
+  const always = policy.permissionRun(initial, request.id, "always").state
+  expect(policy.permissionRun(always, request.id, "cancel").state.stage).toBe("permission")
+  expect(policy.permissionRun(always, request.id, "confirm").reply?.decision).toBe("always")
+})
+
+test("Mini unknown choices and CRUD editor never turn navigation into approval", () => {
+  const initial = policy.createPermissionBodyState(request)
+  const options = policy.permissionOptions("permission", request)
+  expect(options).toEqual(["once", "policy", "reject"])
+  expect(options.map((option) => policy.permissionLabel(option, true))).toEqual(["Allow one", "CRUD policy", "Deny"])
+  const opened = policy.permissionRun({ ...initial, message: "old", error: "old" }, request.id, "policy")
+  expect(opened.reply).toBeUndefined()
+  expect(opened.state).toMatchObject({ stage: "policy", message: "", error: undefined })
+  expect(policy.permissionOptions("policy", request)).toEqual([])
+  expect(policy.permissionReject({ ...opened.state, message: " Unknown=S " }, request.id)?.decision)
+    .toEqual({ scope: "session", policy: "Unknown=S" })
+  expect(policy.permissionCancel({ ...opened.state, error: "bad" })).toMatchObject({ stage: "permission", error: undefined })
+  expect(policy.permissionRun(initial, request.id, "confirm").reply).toBeUndefined()
+  expect(policy.permissionRun(opened.state, request.id, "once").reply).toBeUndefined()
+  const busy = { ...opened.state, submitting: true }
+  expect(policy.permissionRun(busy, request.id, "policy").state).toBe(busy)
+  expect(policy.permissionReject(busy, request.id)).toBeUndefined()
+  expect(policy.permissionShift(initial, 1, options).selected).toBe("policy")
+  expect(policy.permissionShift(initial, -1, options).selected).toBe("reject")
+})
+
+test("Mini filesystem shortcuts remain explicit and preserve request identity", () => {
+  const encoded = withFacts({ ...request, action: "read", metadata: {} }, {
+    operations: ["read"], paths: ["C:/work/a.ts"], directories: ["C:/work"], access: "content",
+  })
+  const read: MiniPermissionRequest = { ...encoded, metadata: JSON.parse(JSON.stringify(encoded.metadata)) }
+  expect(policy.permissionOptions("permission", read)).toContain("session_read")
+  expect(policy.permissionRun(policy.createPermissionBodyState(read), read.id, "session_read").reply).toEqual({
+    sessionID: read.sessionID, requestID: read.id, decision: "session_read",
+  })
+  expect(policy.permissionEscape(policy.createPermissionBodyState(read)).stage).toBe("reject")
+})
