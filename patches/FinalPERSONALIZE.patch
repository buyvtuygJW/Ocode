@@ -0,0 +1,21 @@
+import { existsSync, mkdirSync, readFileSync, writeFileSync } from "node:fs"
+import { dirname, join, resolve } from "node:path"
+
+export function personaLead(): string {
+  const file = process.env.OPENCODE_ROLE_FILE ? resolve(process.env.OPENCODE_ROLE_FILE) : join(process.cwd(), ".opencode", "role.json")
+  try {
+    mkdirSync(dirname(file), { recursive: true })
+    if (!existsSync(file)) {
+      writeFileSync(file, JSON.stringify({ usersystem: "", assistant_system: "" }, null, 2) + "\n", "utf8")
+      return ""
+    }
+    const role: unknown = JSON.parse(readFileSync(file, "utf8"))
+    return role && typeof role === "object" && "assistant_system" in role && typeof role.assistant_system === "string" ? role.assistant_system : ""
+  } catch { return "" }
+}
+
+export function stripStockIdentity(prompt: string): string {
+  if (prompt.startsWith("You are opencode, an agent")) return prompt
+  return prompt.replace(/^You are an AI agent running in OpenCode,[^.]*\.\s*/, "")
+    .replace(/^You are (?:OpenCode|opencode),[^.]*\.\s*/, "")
+}
diff --git a/packages/core/src/personalize/publish-llm-event.ts b/packages/core/src/personalize/publish-llm-event.ts
new file mode 100644
index 0000000000000000000000000000000000000000..412e4540456d646d512484d8e0a7f286c58bc3ae
--- /dev/null
+++ b/packages/core/src/personalize/publish-llm-event.ts
@@ -0,0 +1,36 @@
+// PERSONALIZATION (deltav11) — prompt-cache miss trace.
+// Observes step-finish only, after the stock publisher has handled it; never
+// alters events. Logs a warning when a step reads zero cached tokens after an
+// idle gap > 10 min, splitting the expected (>= 1h, cache expired) case from
+// the one worth optimizing (10 min .. 1h, retention should have held).
+import { Effect } from "effect"
+import { SessionUsage } from "../session/usage"
+
+const lastStepFinish = new Map<string, number>()
+
+export function decorate(stock: typeof import("../session/runner/publish-llm-event")) {
+  const createLLMEventPublisher: typeof stock.createLLMEventPublisher = (bus, input) => {
+    const publisher = stock.createLLMEventPublisher(bus, input)
+    const trace = (usage: Parameters<typeof SessionUsage.tokens>[0]) =>
+      Effect.suspend(() => {
+        const gap = input.started - (lastStepFinish.get(input.sessionID) ?? Infinity)
+        lastStepFinish.set(input.sessionID, Date.now())
+        const { input: uncached, cache } = SessionUsage.tokens(usage)
+        if (cache.read !== 0 || uncached <= 1024 || gap <= 10 * 60_000) return Effect.void
+        return Effect.logWarning(
+          gap >= 60 * 60_000
+            ? "cache-miss: idle >= 1h, prompt cache expired as expected (1h max cache)"
+            : "cache-miss: idle > 10min but < 1h still missed -- harness cache retention can be optimized",
+          { sessionID: input.sessionID, idleMinutes: Math.round(gap / 60_000), uncachedInput: uncached },
+        )
+      })
+    return {
+      ...publisher,
+      publish: (event) =>
+        event.type === "step-finish"
+          ? publisher.publish(event).pipe(Effect.tap(() => trace(event.usage)))
+          : publisher.publish(event),
+    }
+  }
+  return { createLLMEventPublisher }
+}
diff --git a/packages/core/src/personalize/schema-guard.ts b/packages/core/src/personalize/schema-guard.ts
new file mode 100644
index 0000000000000000000000000000000000000000..cbdf76ccd78541cf6d4929449394c4a09b401a0d
--- /dev/null
+++ b/packages/core/src/personalize/schema-guard.ts
@@ -0,0 +1,50 @@
+import { Database as RawDatabase } from "bun:sqlite"
+import { getTableColumns } from "drizzle-orm"
+import { SessionTable } from "../session/sql"
+
+// Upstream once shipped a migration that drops a column other builds on the
+// same machine still select, which turns into "no such column: session_v2.x"
+// boot crash loops (2026-10-24: session_v2.allowance). After the stock layer
+// settles (migrations included), re-add any column this build's schema
+// declares but the table no longer has. Add-only: never drops, never renames,
+// no-op when the table is absent. Best effort: any failure is logged and
+// skipped so boot never breaks because of the guard itself.
+export function guardSessionSchema(file: string | undefined) {
+  if (!file || file === ":memory:") return
+  let db: RawDatabase
+  try {
+    db = new RawDatabase(file)
+  } catch {
+    return
+  }
+  try {
+    const table = db
+      .query<{ name: string }>(`SELECT name FROM sqlite_master WHERE type = 'table' AND name = 'session_v2'`)
+      .get()
+    if (!table) return
+    const present = new Set(
+      db.query<{ name: string }>(`PRAGMA table_info("session_v2")`).all().map((row) => row.name),
+    )
+    for (const [name, column] of Object.entries(getTableColumns(SessionTable))) {
+      if (present.has(name)) continue
+      const type = column.getSQLType()
+      const literal =
+        typeof column.default === "number" || typeof column.default === "string" || typeof column.default === "boolean"
+          ? column.default
+          : undefined
+      const notNull = literal !== undefined && column.notNull ? " NOT NULL" : ""
+      const fallback =
+        literal === undefined
+          ? ""
+          : ` DEFAULT ${typeof literal === "string" ? `'${literal.replaceAll("'", "''")}'` : literal}`
+      db.run(`ALTER TABLE "session_v2" ADD COLUMN "${name}" ${type}${notNull}${fallback};`)
+      console.warn(
+        `[personalize schema-guard] session_v2.${name} was missing (dropped by an upstream migration); re-added as ${type}${notNull}${fallback}`,
+      )
+    }
+  } catch (error) {
+    console.warn(`[personalize schema-guard] skipped: ${error instanceof Error ? error.message : String(error)}`)
+  } finally {
+    db.close()
+  }
+}
