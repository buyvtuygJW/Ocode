@@ -0,0 +1,4 @@
+export function normalizeChannel(value) {
+  return typeof value === "string" && /^[a-z0-9][a-z0-9._-]*$/i.test(value.trim()) &&
+    !["undefined", "null"].includes(value.trim().toLowerCase()) ? value.trim() : "local"
+}
diff --git a/.personalize/content.test.mjs b/.personalize/content.test.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..56bff6ccfd5593c5db2676603f65e4f7ff197d3e
--- /dev/null
+++ b/.personalize/content.test.mjs
@@ -0,0 +1,75 @@
+import { test } from "node:test"
+import assert from "node:assert/strict"
+import { mkdtempSync, mkdirSync, readFileSync, rmSync, writeFileSync } from "node:fs"
+import { tmpdir } from "node:os"
+import path from "node:path"
+import { canonicalMessages, historyMessages, copyWith } from "../packages/core/src/personalize/content.ts"
+import { personaLead, stripStockIdentity } from "../packages/core/src/personalize/persona.ts"
+
+test("valid messages retain their exact object identity and metadata", () => {
+  const message = { role: "user", content: [{ type: "text", text: "hello" }], metadata: { instruction: [1] } }
+  assert.equal(canonicalMessages([message])[0], message)
+})
+
+test("missing content is repaired without losing prototypes, symbols, readonly or hidden metadata", () => {
+  const marker = Symbol("metadata")
+  class Message { content = undefined; role = "user"; get kind() { return "original" } }
+  const message = new Message()
+  Object.defineProperty(message, marker, { value: { instructions: [1] }, enumerable: false })
+  Object.defineProperty(message, "content", { value: undefined, writable: false, enumerable: true })
+  const result = canonicalMessages([message])[0]
+  assert(result instanceof Message)
+  assert.equal(result.kind, "original")
+  assert.equal(result[marker], message[marker])
+  assert.equal(Object.getOwnPropertyDescriptor(result, marker).enumerable, false)
+  assert.equal(Object.getOwnPropertyDescriptor(result, "content").writable, false)
+  assert.deepEqual(result.content, [])
+  assert.equal(message.content, undefined)
+})
+
+test("nullish arrays and tool-result values are repaired, not mutated", () => {
+  assert.deepEqual(canonicalMessages(undefined), [])
+  const message = { role: "tool", content: [{ type: "tool-result", result: { type: "content", value: undefined } }] }
+  const result = canonicalMessages([message])[0]
+  assert.deepEqual(result.content[0].result.value, [])
+  assert.equal(message.content[0].result.value, undefined)
+})
+
+test("history repair keeps completed-tool metadata and leaves healthy records alone", () => {
+  const good = { role: "assistant", content: [] }
+  assert.equal(historyMessages([good])[0], good)
+  const bad = { role: "assistant", content: [{ type: "tool", state: { status: "completed", content: undefined, metadata: { id: 1 } } }] }
+  const result = historyMessages([bad])[0]
+  assert.deepEqual(result.content[0].state.content, [])
+  assert.equal(result.content[0].state.metadata, bad.content[0].state.metadata)
+})
+
+test("system-part replacement preserves instruction/cache metadata", () => {
+  const part = { content: "stock", metadata: { experimental: { instructions: [{ id: 1 }] } } }
+  const result = copyWith(part, { content: "persona\nstock" })
+  assert.equal(result.metadata, part.metadata)
+  assert.equal(part.content, "stock")
+})
+
+test("persona seeds the existing role schema and reads only assistant_system", () => {
+  const root = path.join(tmpdir(), "opencode")
+  mkdirSync(root, { recursive: true })
+  const directory = mkdtempSync(path.join(root, "personalize-role-"))
+  const previous = process.env.OPENCODE_ROLE_FILE
+  try {
+    const file = path.join(directory, "role.json")
+    process.env.OPENCODE_ROLE_FILE = file
+    assert.equal(personaLead(), "")
+    assert.deepEqual(JSON.parse(readFileSync(file, "utf8")), { usersystem: "", assistant_system: "" })
+    writeFileSync(file, JSON.stringify({ usersystem: "not this", assistant_system: "exact persona" }))
+    assert.equal(personaLead(), "exact persona")
+    writeFileSync(file, "{broken")
+    assert.equal(personaLead(), "")
+    assert.equal(stripStockIdentity("You are OpenCode, a coding assistant. Keep tools."), "Keep tools.")
+    assert.equal(stripStockIdentity("You are opencode, an agent of change."), "You are opencode, an agent of change.")
+  } finally {
+    if (previous === undefined) delete process.env.OPENCODE_ROLE_FILE
+    else process.env.OPENCODE_ROLE_FILE = previous
+    rmSync(directory, { recursive: true, force: true })
+  }
+})
diff --git a/.personalize/dedup.test.mjs b/.personalize/dedup.test.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..51840663b5834c957854b20f7af4476405a7ee78
--- /dev/null
+++ b/.personalize/dedup.test.mjs
@@ -0,0 +1,92 @@
+import { test } from "node:test"
+import assert from "node:assert/strict"
+import {
+  bumpLedger,
+  callSignature,
+  dedupeText,
+  estimateTokens,
+  ledgerState,
+  normalizeSentence,
+  punchLine,
+  resetLedger,
+  slapReceipt,
+  splitSentences,
+  stableStringify,
+} from "../packages/core/src/personalize/dedup.ts"
+
+test("stableStringify is key-order invariant and array-order exact", () => {
+  assert.equal(stableStringify({ b: 1, a: 2 }), stableStringify({ a: 2, b: 1 }))
+  assert.equal(
+    stableStringify({ a: { y: 1, x: 2 }, b: [3, 4] }),
+    stableStringify({ b: [3, 4], a: { x: 2, y: 1 } }),
+  )
+  assert.notEqual(stableStringify([1, 2]), stableStringify([2, 1]))
+  assert.equal(stableStringify(undefined), "null")
+})
+
+test("callSignature collides only for calls differing in argument key order", () => {
+  assert.equal(callSignature("read", { path: "a", limit: 5 }), callSignature("read", { limit: 5, path: "a" }))
+  assert.notEqual(callSignature("read", { path: "a" }), callSignature("read", { path: "b" }))
+  assert.notEqual(callSignature("read", {}), callSignature("glob", {}))
+})
+
+test("slapReceipt carries the call number, waste estimate and optional punch", () => {
+  assert.equal(
+    slapReceipt(7, 12, ""),
+    "*Systemslap* DUPLICATE of call #7 this turn — result already in context. wasted: ~12 tkn",
+  )
+  assert.equal(
+    slapReceipt(2, 4, "\n*SystemPunch* duplicates this session: 2 (≈8 tkn wasted)"),
+    "*Systemslap* DUPLICATE of call #2 this turn — result already in context. wasted: ~4 tkn\n*SystemPunch* duplicates this session: 2 (≈8 tkn wasted)",
+  )
+})
+
+test("punch line appears only from the second duplicate onward and counts both kinds", () => {
+  resetLedger()
+  assert.equal(punchLine(ledgerState("s1")), "")
+  bumpLedger("s1", "calls", 10)
+  assert.equal(punchLine(ledgerState("s1")), "")
+  bumpLedger("s1", "prose", 30)
+  assert.match(punchLine(ledgerState("s1")), /\*SystemPunch\* duplicates this session: 2 \(≈40 tkn wasted\)/)
+  assert.equal(ledgerState("nope"), undefined)
+  resetLedger()
+  assert.equal(ledgerState("s1"), undefined)
+})
+
+test("dedupeText strips adjacent duplicate sentences, keeps the first, leaves a marker", () => {
+  const text = "Build finished with exit zero. Build finished with exit zero. Now running the serve test."
+  const result = dedupeText(text)
+  assert.ok(result)
+  assert.equal(result.removed, 1)
+  assert.match(result.text, /\[duplicate removed ×1: "Build finished[^"]*"\]/)
+  assert.ok(result.text.includes("Now running the serve test."))
+  assert.ok(result.wastedTokens > 0)
+  const withoutMarker = result.text.replace(/\[duplicate[^\]]*\]/, "")
+  assert.ok(!withoutMarker.includes("Build finished with exit zero. Build"))
+})
+
+test("dedupeText collapses longer runs into one marker", () => {
+  const text = "Alpha beta gamma delta epsilon. Alpha beta gamma delta epsilon. Alpha beta gamma delta epsilon."
+  const result = dedupeText(text)
+  assert.ok(result)
+  assert.equal(result.removed, 2)
+  assert.match(result.text, /×2/)
+})
+
+test("dedupeText leaves non-adjacent repeats, short sentences and healthy text alone", () => {
+  assert.equal(dedupeText("Just one sentence, nothing repeated here at all."), undefined)
+  assert.equal(dedupeText("Fine. Fine. Fine. Fine. Fine. Fine. Fine. Fine. Fine. Fine."), undefined)
+  const nonAdjacent =
+    "Alpha beta gamma delta epsilon zeta. A completely different sentence follows here. Alpha beta gamma delta epsilon zeta."
+  assert.equal(dedupeText(nonAdjacent), undefined)
+})
+
+test("sentence normalization ignores case, punctuation and whitespace", () => {
+  assert.equal(normalizeSentence("  Build, FINISHED!!  "), normalizeSentence("build finished"))
+  assert.deepEqual(splitSentences("One. Two!\nThree?"), ["One.", "Two!", "Three?"])
+})
+
+test("estimateTokens is a deterministic chars/4 ceiling", () => {
+  assert.equal(estimateTokens("1234"), 1)
+  assert.equal(estimateTokens("12345"), 2)
+})
