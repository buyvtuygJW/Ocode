+import { createComponent, mergeProps } from "solid-js"
+import { wake } from "./lifetime-state"
+
+export function decorate(stock: typeof import("../context/client")) {
+  const ClientProvider: typeof stock.ClientProvider = (props) => {
+    const service = props.service
+    if (!service) return createComponent(stock.ClientProvider, props)
+    return createComponent(stock.ClientProvider, mergeProps(props, {
+      service: {
+        ...service,
+        async reconnect(signal: AbortSignal) {
+          await wake.wait(signal)
+          return service.reconnect(signal)
+        },
+      },
+    }))
+  }
+  return { ClientProvider }
+}
diff --git a/packages/tui/src/personalize/lifetime-state.ts b/packages/tui/src/personalize/lifetime-state.ts
new file mode 100644
index 0000000000000000000000000000000000000000..1199b5bcf5820749ea21d26d778c911accf11d0d
--- /dev/null
+++ b/packages/tui/src/personalize/lifetime-state.ts
@@ -0,0 +1,4 @@
+import { WakeGate } from "@opencode/util/personalize-lifetime"
+import { sleptAfter } from "@opencode/util/personalize-lifetime-store"
+
+export const wake = new WakeGate(sleptAfter)
diff --git a/packages/tui/src/personalize/lifetime.ts b/packages/tui/src/personalize/lifetime.ts
